//******************************************************************************
// 悪役令嬢クローディア
// Claude Code 監視辞書
//******************************************************************************
//
//Claude Code は、起動中のセッション 1 つにつき 1 つの JSON ファイルを
//  %USERPROFILE%\.claude\sessions\<プロセスID>.json
//に書いている。中身はこういう 1 行の JSON。
//
//  {"pid":25304,"sessionId":"...","cwd":"C:\\path\\to\\project","startedAt":...,
//   "version":"2.1.278","kind":"interactive","name":"claudia-8d",
//   "status":"busy","waitingFor":"...","updatedAt":...,"statusUpdatedAt":...}
//
//  status      busy（作業中）/ waiting（こちらの返事待ち）/ idle（待機）の 3 つだけ
//  waitingFor  waiting のときだけ入る。input needed / dialog open / sandbox request など
//  kind        interactive（端末で動いている）/ それ以外（バックグラウンド）
//  name        セッションの呼び名。cwd は作業フォルダ
//
//このファイルは PARSEJSON（YAYA 600 系）でハッシュにして読み（CC.ReadSession）、
//キーの名前のまま _s['status'] のように引く。セッションの一覧（CC.Scan）はその配列。
//
//このファイルは状態が変わったときにだけ書き換えられる（作業中でも中身が同じなら
//触られない）ので、\![execute,filewatch] で見張っておけば、状態が変わった瞬間だけ
//知ることができる。Claude Code 側の設定は何も要らない。
//
//見張りは二段構えにしている。
//  1. ディレクトリ（sessions フォルダ）を見張る → OnClaudeCodeDir
//     セッションが増えた・減ったことが分かる。ここでは各ファイルの見張りを
//     立てたり解いたりするだけで、話すことがなければ黙っている。
//  2. セッションのファイルを 1 つずつ見張る → OnClaudeCodeFile
//     どのセッションが動いたかが Reference1 のパスで分かるので、
//     そのファイルだけを読めばよい。
//
//ディレクトリの見張りは直下のファイルが変わったことしか教えてくれず（どのファイルかは
//分からない）、ファイルの見張りは増減を教えてくれないので、両方を使う。
//
//見張りを立てるさくらスクリプトは、話している最中に割り込むことがある。バルーンの
//文字を消さないよう、話すことがないときは先頭に \C を付けて出す（\C は「直前に表示した
//バルーンのテキストに追記する」）。
//
//状態のほかに、会話の記録（下の「返事待ちの中身」）から、何を待たれているか、
//セッションの題名、依頼ごとの働きぶり（使ったツールと失敗の数）を読み取って、
//お知らせと完了報告に添える。
//
//見張りは OnBoot で立てる。SSTP から送ったスクリプトでは filewatch を始められない
//（notauthorized で失敗する）ので、辞書だけを読み込み直したときはメニューの
//「見張りを立て直す」で登録し直すこと。
//
//注意: YAYA では関数を裸の文で呼ぶと、その戻り値もブロックの出力候補になり、候補から
//1 つが選ばれる。返したいスクリプトが消えるので、副作用だけの関数（CC.Reset、CC.Prime）は
//値を返さないように書いてある。値を返す関数を裸で呼んではいけない。
//******************************************************************************


//******************************************************************************
//セッションの読み取り
//******************************************************************************

//------------------------------------------------------------------------------
//セッションファイルの置き場所。見つからなければ空文字列
//さくらスクリプトのタグの中に \ をそのまま書くと \s などと解釈されるので、
//区切りは / にそろえておく（Windows はどちらでも開ける）
//------------------------------------------------------------------------------
CC.SessionDir
{
	_home = GETENV("USERPROFILE")
	_dir  = ''
	if STRLEN(_home) > 0 {
		_dir = REPLACE(_home, '\', '/') + '/.claude/sessions'
	}
	_dir
}

//------------------------------------------------------------------------------
//セッションファイルの置き場所がフォルダとしてあれば 1
//Claude Code を入れていない PC には %USERPROFILE%\.claude そのものが無い
//FATTRIB は、無ければ -1、あれば [0]アーカイブ [1]圧縮 [2]ディレクトリ ... の配列を返す
//------------------------------------------------------------------------------
CC.HasSessionDir
{
	_dir  = CC.SessionDir
	_attr = IARRAY
	_is   = 0

	if STRLEN(_dir) > 0 {
		_attr = FATTRIB(_dir)
		if ARRAYSIZE(_attr) > 2 && _attr[2] == 1 {
			_is = 1
		}
	}
	_is
}

//------------------------------------------------------------------------------
//ファイルを 1 行読む。読めなければ空文字列
//------------------------------------------------------------------------------
CC.ReadFile
{
	_text = ''
	if FOPEN(_argv[0], 'r') {
		_text = FREAD(_argv[0])
		void FCLOSE(_argv[0])
	}
	//---- 空のファイルだと FREAD が -1 を返す
	if _text == -1 {
		_text = ''
	}
	_text
}

//------------------------------------------------------------------------------
//JSON の文字列 1 つをハッシュにする。JSON のオブジェクトでなければ空のハッシュ
//書きかけのファイルなどで警告（W0026）を出さないよう、{ で始まって } で終わるものだけを解析する
//無いキーを引くと空文字列になるので、呼ぶ側はキーがあるかを確かめなくてよい
//------------------------------------------------------------------------------
CC.ParseJSON
{
	_text = _argv[0]
	_h    = IHASH()

	if SUBSTR(_text, 0, 1) == '{' && SUBSTR(_text, STRLEN(_text) - 1, 1) == '}' {
		_h = PARSEJSON(_text)
		if GETTYPE(_h) != 5 {
			_h = IHASH()
		}
	}
	_h
}

//------------------------------------------------------------------------------
//セッションのファイル 1 つを読んで、ハッシュにする。読めなければ空のハッシュ
//キーは JSON のまま（status / name / cwd / waitingFor / statusUpdatedAt / kind / sessionId）
//------------------------------------------------------------------------------
CC.ReadSession
{
	CC.ParseJSON(CC.ReadFile(_argv[0]))
}

//------------------------------------------------------------------------------
//セッションのファイル名だけを並べる（.json のものだけ）
//------------------------------------------------------------------------------
CC.FileNames
{
	_dir   = CC.SessionDir
	_names = IARRAY
	_files = IARRAY
	_name  = ''

	if STRLEN(_dir) == 0 {
		return _names
	}
	_files = SPLIT(FENUM(_dir), ',')
	foreach _files ; _name {
		//---- .json 以外（peerToken の .key など）は相手にしない
		if STRLEN(_name) <= 5 {
			continue
		}
		if SUBSTR(_name, STRLEN(_name) - 5, 5) != '.json' {
			continue
		}
		_names ,= _name
	}
	_names
}

//------------------------------------------------------------------------------
//起動中のセッションを全部読む。セッションごとのハッシュ（CC.ReadSession）の配列
//------------------------------------------------------------------------------
CC.Scan
{
	_dir   = CC.SessionDir
	_names = CC.FileNames
	_list  = IARRAY
	_name  = ''
	_s     = IHASH()

	foreach _names ; _name {
		_s = CC.ReadSession(_dir + '/' + _name)
		if HASH_SIZE(_s) > 0 {
			_list ,= _s
		}
	}
	_list
}

//------------------------------------------------------------------------------
//返事待ちのセッション（端末で動いているもの）だけを並べる
//  _argv は CC.Scan の結果
//------------------------------------------------------------------------------
CC.WaitingOf
{
	_list = IARRAY
	_s    = IHASH()

	foreach _argv ; _s {
		if _s['status'] == 'waiting' && _s['kind'] == 'interactive' {
			_list ,= _s
		}
	}
	_list
}

//------------------------------------------------------------------------------
//いちばん手前のセッション（端末で動いていて、直近に状態が変わったもの）を 1 つ選ぶ
//どれが最前面のウィンドウかは分からないので、状態が最後に動いたものを「今の相手」とみなす
//セッションのハッシュを返す。無ければ空のハッシュ
//------------------------------------------------------------------------------
CC.Front
{
	_list  = CC.Scan
	_best  = IHASH()
	_bestt = -1
	_s     = IHASH()
	_time  = 0

	foreach _list ; _s {
		//---- 端末で動いているものだけを相手にする
		if _s['kind'] != 'interactive' {
			continue
		}
		_time = TOINT(_s['statusUpdatedAt'])
		if _time > _bestt {
			_bestt = _time
			_best  = _s
		}
	}
	_best
}

//------------------------------------------------------------------------------
//cwd からフォルダ名だけを取り出す
//------------------------------------------------------------------------------
CC.ProjectName
{
	_path = REPLACE(_argv[0], '\', '/')
	_part = SPLIT(_path, '/')
	_name = ''
	if ARRAYSIZE(_part) > 0 {
		_name = _part[ARRAYSIZE(_part) - 1]
	}
	_name
}

//------------------------------------------------------------------------------
//お知らせに添えるセッションの呼び名
//会話の記録から拾った題名（cctitle。CC.ReadTail）があればそれ、無ければ
//メニューの一覧に出るのと同じ name（claudia-c9 など）、それも無ければ作業フォルダの名前にする
//  _argv[0] name / _argv[1] cwd / _argv[2] sessionId（省略すると題名は使わない）
//------------------------------------------------------------------------------
CC.Label
{
	_label = ''
	if _argc > 2 && STRLEN(_argv[2]) > 0 && GETTYPE(cctitle) == 5 {
		_label = cctitle[_argv[2]]
	}
	if STRLEN(_label) == 0 {
		_label = _argv[0]
	}
	if STRLEN(_label) == 0 {
		_label = CC.ProjectName(_argv[1])
	}
	CC.Safe(_label)
}

//------------------------------------------------------------------------------
//さくらスクリプトや埋め込みとして解釈されそうな文字（% [ ] と円記号）を外す
//------------------------------------------------------------------------------
CC.Safe
{
	RE_REPLACE(_argv[0], '[%\[\]\\]', '')
}

//------------------------------------------------------------------------------
//トークの最初の \0\s[番号] の後ろに、どのセッションの話かを 1 行差し込む
//  _argv[0] トーク / _argv[1] CC.Label の呼び名。空ならトークをそのまま返す
//------------------------------------------------------------------------------
CC.WithLabel
{
	_talk = _argv[0]
	_pos  = STRSTR(_talk, '\0\s[', 0)
	_end  = -1

	if STRLEN(_argv[1]) == 0 || _pos < 0 {
		return _talk
	}
	_end = STRSTR(_talk, ']', _pos)
	if _end < 0 {
		return _talk
	}
	//---- 題名は長いことがあるので、1 行に収まるよう全角 22 字ほどで切る
	SUBSTR(_talk, 0, _end + 1) + '【' + SHIORI3FW.MakeShortText(_argv[1], 44) + '】\w9\n' + SUBSTR(_talk, _end + 1, STRLEN(_talk))
}


//******************************************************************************
//返事待ちの中身（何を待たれているか）
//******************************************************************************
//
//セッションのファイルには「waiting」と待っている種類（input needed / permission prompt
//など）しか書かれていない。何のツールで止まっているかは、会話の記録
//  %USERPROFILE%\.claude\projects\<cwd の英数字以外を - にしたもの>\<sessionId>.jsonl
//の最後のメッセージを見ればわかる。止まっている間は、最後の行がそのツールの
//tool_use を持つ assistant のメッセージになっている。
//
//  ExitPlanMode     計画の承認待ち（plan mode の「Ready to code?」）。"plan" に計画の本文
//  AskUserQuestion  質問待ち。"question" に質問文
//  それ以外         ツールの実行の許可待ち（Bash なら "description"）
//
//ただし AskUserQuestion は答えるまで記録に書き出されないことがある。そのときは
//最後のメッセージがユーザーの発言のままなので、何もわからないものとして扱う。
//記録は大きくなるので、末尾の 256KB だけを読む。
//
//ツールは、その行の JSON の message.content に、こういう形の要素で入っている。
//  {"type":"tool_use","id":"...","name":"Bash","input":{"command":"...","description":"..."}}
//  ExitPlanMode は input.plan、AskUserQuestion は input.questions[0].question に中身がある
//
//同じ末尾から、セッションの題名も拾う。Claude Code は会話の中身から題名を付けて、
//  {"type":"ai-title","aiTitle":"...","sessionId":"..."}
//という行を依頼のたびに何度も書き足している。拾った題名は cctitle（sessionId をキーにした
//ハッシュ）に覚えておき、お知らせに添える呼び名（CC.Label）に使う。
//******************************************************************************

//------------------------------------------------------------------------------
//会話の記録のパス。_argv[0] cwd / _argv[1] sessionId
//------------------------------------------------------------------------------
CC.TranscriptPath
{
	_home = GETENV("USERPROFILE")
	_path = ''
	if STRLEN(_home) > 0 && STRLEN(_argv[0]) > 0 && STRLEN(_argv[1]) > 0 {
		_path = REPLACE(_home, '\', '/') + '/.claude/projects/' + /
		        RE_REPLACE(_argv[0], '[^A-Za-z0-9]', '-') + '/' + _argv[1] + '.jsonl'
	}
	_path
}

//------------------------------------------------------------------------------
//会話の記録の末尾 256KB を読む
//  _argv[0] cwd / _argv[1] sessionId
//  戻り値  ハッシュ。last 最後のメッセージ（user か assistant）の行 / title 題名 /
//          agent セッションの呼び名（claudia-8d など。履歴の一覧で題名の代わりにする）
//          わからないものは空文字列
//題名が見つかれば cctitle にも覚える
//------------------------------------------------------------------------------
CC.ReadTail
{
	_path  = CC.TranscriptPath(_argv[0], _argv[1])
	_size  = FSIZE(_path)
	_line  = ''
	_last  = ''
	_title = ''
	_agent = ''
	_h     = IHASH()

	if _size <= 0 {
		return IHASH()
	}
	if !FOPEN(_path, 'r') {
		return IHASH()
	}
	if _size > 262144 {
		void FSEEK(_path, _size - 262144, 'start')
		//---- 行の途中から読み始めるので、最初の 1 行は捨てる
		_line = FREAD(_path)
	}
	while 1 {
		_line = FREAD(_path)
		if _line == -1 {
			break
		}
		if STRSTR(_line, '"role":"assistant"', 0) >= 0 || STRSTR(_line, '"role":"user"', 0) >= 0 {
			_last = _line
		}
		elseif STRSTR(_line, '"type":"ai-title"', 0) >= 0 {
			_h = CC.ParseJSON(_line)
			if _h['type'] == 'ai-title' && STRLEN(_h['aiTitle']) > 0 {
				_title = _h['aiTitle']
			}
		}
		elseif STRSTR(_line, '"type":"agent-name"', 0) >= 0 {
			_h = CC.ParseJSON(_line)
			if _h['type'] == 'agent-name' && STRLEN(_h['agentName']) > 0 {
				_agent = _h['agentName']
			}
		}
	}
	void FCLOSE(_path)
	CC.SetTitle(_argv[1], _title)
	IHASH('last', _last, 'title', _title, 'agent', _agent)
}

//------------------------------------------------------------------------------
//セッションの題名を覚える。値は返さない（裸で呼ぶため）
//  _argv[0] sessionId / _argv[1] 題名。空なら何もしない
//------------------------------------------------------------------------------
CC.SetTitle
{
	if GETTYPE(cctitle) != 5 {
		cctitle = IHASH()
	}
	if STRLEN(_argv[0]) > 0 && STRLEN(_argv[1]) > 0 {
		cctitle[_argv[0]] = _argv[1]
	}
}

//------------------------------------------------------------------------------
//文章の最初の 1 行を取り出して、トークに入れられる形にする
//  _argv[0] 文章 / _argv[1] 最大の文字数
//------------------------------------------------------------------------------
CC.Snippet
{
	//---- 頭の空白と空行を飛ばして、最初の 1 行だけ
	_text = RE_REPLACE(_argv[0], '^\s+', '')
	_text = SPLIT(REPLACE(_text, CHR(13), ''), CHR(10))[0]
	//---- 計画の見出しの「# Plan: 」を落とす
	_text = RE_REPLACE(_text, '^#+ *', '')
	_text = RE_REPLACE(_text, '^[Pp]lan: *', '')
	_text = CC.Safe(_text)
	if STRLEN(_text) > _argv[1] {
		_text = SUBSTR(_text, 0, _argv[1] - 1) + '…'
	}
	_text
}

//------------------------------------------------------------------------------
//止まっているツールと、その中身を返す
//  _argv[0] cwd / _argv[1] sessionId
//  戻り値  ハッシュ。tool ツール名 / detail 中身。わからなければ空のハッシュ
//題名（cctitle）も読み直すので、お知らせの呼び名（CC.Label）はこの後で作る
//------------------------------------------------------------------------------
CC.Pending
{
	_tail = CC.ReadTail(_argv[0], _argv[1])
	CC.PendingIn(_tail['last'])
}

//---- CC.Pending の続き。_argv[0] 会話の記録の最後のメッセージの行
CC.PendingIn
{
	_last    = _argv[0]
	_msg     = IHASH()
	_content = IARRAY
	_c       = IHASH()
	_use     = IHASH()
	_input   = IHASH()
	_detail  = ''

	if STRSTR(_last, '"role":"assistant"', 0) < 0 {
		return IHASH()
	}
	_msg     = CC.ParseJSON(_last)
	_content = _msg['message']['content']
	//---- ツールがいくつも並んでいたら、最後のもので止まっている
	foreach _content ; _c {
		if _c['type'] == 'tool_use' {
			_use = _c
		}
	}
	if HASH_SIZE(_use) == 0 {
		return IHASH()
	}
	_input = _use['input']
	case _use['name'] {
		when 'ExitPlanMode' {
			_detail = CC.Snippet(_input['plan'], 24)
		}
		when 'AskUserQuestion' {
			_detail = CC.Snippet(_input['questions'][0]['question'], 24)
		}
		others {
			_detail = CC.Snippet(_input['description'], 24)
		}
	}
	IHASH('tool', _use['name'], 'detail', _detail)
}


//******************************************************************************
//依頼ごとの働きぶり（完了報告に添える）
//******************************************************************************
//
//依頼を受けて作業を始めた（busy になった）ときに、会話の記録の大きさを ccturnpos に
//覚えておく。作業が終わったら、そこから後ろに書き足された行だけを読んで、
//使ったツールを数える。
//
//  assistant の行の message.content の tool_use   使ったツール（名前と input）
//  user の行の message.content の tool_result      "is_error":true なら、そのツールは失敗した
//                                                  （コマンドのエラーのほか、許可を断ったときも）
//
//記録は Claude Code の内部のファイルで仕様は公開されていないので、形が変わって
//何も数えられなくなったら、完了のトークはいつものもの（CC.TalkDone）に戻る。
//読むのは末尾の 4MB まで（大きなファイルを読んだ依頼などで、それより多く書き足されたら、
//前のほうは数えない）。
//******************************************************************************

//------------------------------------------------------------------------------
//依頼を受けてからの働きぶりを数える
//  _argv[0] cwd / _argv[1] sessionId / _argv[2] 数え始める位置（ccturnpos）
//  戻り値  ハッシュ。数えられなければ空のハッシュ
//    files    手を入れたファイルの数（Edit / Write / NotebookEdit。同じファイルは 1 つ）
//    edit     手を入れた回数
//    command  コマンドを実行した回数（Bash / PowerShell）
//    look     調べものの回数（Read / Grep / Glob / WebFetch / WebSearch）
//    agent    サブエージェントに任せた回数（Agent / Task）
//    tool     ツールを使った回数（上のどれでもないものを含む全部）
//    error    ツールが失敗した回数
//------------------------------------------------------------------------------
CC.TurnStats
{
	_path  = CC.TranscriptPath(_argv[0], _argv[1])
	_from  = TOINT(_argv[2]) - 1
	_size  = FSIZE(_path)
	_line  = ''
	_msg   = IHASH()
	_c     = IHASH()
	_list  = IARRAY
	_files = IHASH()
	_n     = IHASH()
	_file  = ''

	if _from < 0 || _size <= _from + 1 {
		return IHASH()
	}
	if _size - _from > 4194304 {
		_from = _size - 4194304
	}
	if !FOPEN(_path, 'r') {
		return IHASH()
	}
	//---- 1 バイト手前から読み、最初の 1 行（前の行の改行か、行の残り）は捨てる
	void FSEEK(_path, _from, 'start')
	_line = FREAD(_path)
	while 1 {
		_line = FREAD(_path)
		if _line == -1 {
			break
		}
		if STRSTR(_line, '"tool_use"', 0) >= 0 && STRSTR(_line, '"role":"assistant"', 0) >= 0 {
			_msg = CC.ParseJSON(_line)
			_list = _msg['message']['content']
			foreach _list ; _c {
				if _c['type'] != 'tool_use' {
					continue
				}
				_n['tool'] += 1
				case _c['name'] {
					when 'Edit', 'Write', 'MultiEdit', 'NotebookEdit' {
						_n['edit'] += 1
						_file = _c['input']['file_path']
						if STRLEN(_file) == 0 {
							_file = _c['input']['notebook_path']
						}
						if STRLEN(_file) > 0 {
							_files[TOLOWER(REPLACE(_file, '\', '/'))] = 1
						}
					}
					when 'Bash', 'PowerShell' {
						_n['command'] += 1
					}
					when 'Read', 'Grep', 'Glob', 'WebFetch', 'WebSearch' {
						_n['look'] += 1
					}
					when 'Agent', 'Task' {
						_n['agent'] += 1
					}
				}
			}
		}
		elseif STRSTR(_line, '"is_error":true', 0) >= 0 && STRSTR(_line, '"role":"user"', 0) >= 0 {
			_msg = CC.ParseJSON(_line)
			_list = _msg['message']['content']
			foreach _list ; _c {
				if _c['type'] == 'tool_result' && _c['is_error'] == 1 {
					_n['error'] += 1
				}
			}
		}
	}
	void FCLOSE(_path)

	if TOINT(_n['tool']) <= 0 {
		return IHASH()
	}
	_n['files'] = HASH_SIZE(_files)
	_n
}


//******************************************************************************
//見張りの開始と、覚えておく値
//******************************************************************************

//------------------------------------------------------------------------------
//覚えておく値を初期化する
//  ccsession  今見ているセッションの sessionId
//  ccstatus   その状態（busy / waiting / idle）
//  ccbusyid   busy になったのがどのセッションか
//  ccbusyat   busy になった時刻（Unix ミリ秒）
//  ccbusyname busy になったセッションの name / ccbusycwd その cwd（呼び名を作るため）
//  ccturnid   依頼を受けて作業を始めたセッションの sessionId
//  ccturnpos  そのときの会話の記録の大きさ（バイト）。依頼ごとの働きぶり（CC.TurnStats）を
//             ここから数える。0 なら、いつ始めたか分からない（起動時にすでに動いていた）
//  cctitle    セッションの題名（sessionId をキーにしたハッシュ。CC.ReadTail）
//  cctalkat   最後に Claude Code の話をした時刻（Unix 秒）
//  ccbusytold 長考の話をもうしたか
//  ccwatched  今ファイルの見張りを立てているファイル名（ハッシュのキー）
//  ccadded    直近の見張り立て直しで新しく増えたセッションの数
//  ccaddedfile そのうち最後に増えたセッションのファイル名
//  ccremindat 返事待ちのベルを最後に鳴らした時刻（Unix 秒）。0 ならリマインダなし
//  ccremindn  そのあとリマインダを鳴らした回数
//続けて作業している時間（CC.MarkWork）は、セッションを閉じてすぐ開き直したときにも
//数え続けたいので、ここでは触らず CC.Start で初期化する
//------------------------------------------------------------------------------
CC.Reset
{
	ccsession  = ''
	ccstatus   = ''
	ccbusyid   = ''
	ccbusyat   = 0
	ccbusyname = ''
	ccbusycwd  = ''
	ccturnid   = ''
	ccturnpos  = 0
	cctitle    = IHASH()
	cctalkat   = 0
	ccbusytold = 0
	ccwatched  = IHASH()
	ccadded    = 0
	ccaddedfile = ''
	ccremindat = 0
	ccremindn  = 0
	//---- 前の版で使っていた変数（呼び名は ccbusyname / ccbusycwd から作り直すようにした）
	void ERASEVAR('ccbusylabel')
}

//------------------------------------------------------------------------------
//今の状態を黙って覚える（起動直後に、すでに動いているセッションで騒がないため）
//------------------------------------------------------------------------------
CC.Prime
{
	_s = CC.Front

	if HASH_SIZE(_s) > 0 {
		ccsession = _s['sessionId']
		ccstatus  = _s['status']
		ccbusyid  = _s['sessionId']
		ccbusyat  = TOINT(_s['statusUpdatedAt'])
		ccbusyname = _s['name']
		ccbusycwd  = _s['cwd']
	}
}

//------------------------------------------------------------------------------
//今あるセッションのファイルと、見張りを立てているファイルを突き合わせて、
//増えた分の見張りを立て、減った分の見張りを解くタグを返す
//変わりがなければ空文字列。新しく増えた数は ccadded に入れる
//------------------------------------------------------------------------------
CC.SyncWatches
{
	_dir   = CC.SessionDir
	_names = IARRAY
	_old   = IARRAY
	_now   = IHASH()
	_tags  = ''
	_name  = ''

	ccadded     = 0
	ccaddedfile = ''
	if STRLEN(_dir) == 0 {
		return ''
	}
	//---- 前の版ではカンマで挟んだ文字列だった
	if GETTYPE(ccwatched) != 5 {
		ccwatched = IHASH()
	}

	//---- 増えた分の見張りを立てる
	_names = CC.FileNames
	foreach _names ; _name {
		_now[_name] = 1
		if !HASH_EXIST(_name, ccwatched) {
			_tags  += '\![execute,filewatch,' + _dir + '/' + _name + /
			          ',--async=OnClaudeCodeFile,--debounce=200]'
			ccadded    += 1
			ccaddedfile = _name
		}
	}

	//---- 無くなった分の見張りを解く
	_old = HASH_KEYS(ccwatched)
	foreach _old ; _name {
		if !HASH_EXIST(_name, _now) {
			_tags += '\![cancel,filewatch,' + _dir + '/' + _name + ']'
		}
	}

	ccwatched = _now
	_tags
}

//------------------------------------------------------------------------------
//見張りを立てる。OnBoot とメニューから呼ぶ
//------------------------------------------------------------------------------
CC.Start
{
	_dir  = CC.SessionDir
	_tags = ''

	CC.Reset
	CC.ResetWork
	//---- 起動したときの通知領域のアイコンは、descript.txt の icon（クローディア）
	cctrayicon = 'claudia'
	//---- Claude Code を入れていない PC では見張らない（立てても notfound で失敗するだけ）
	//---- あとから入れたときは、次の起動かメニューの「見張りを立て直す」で始まる
	if !CC.HasSessionDir {
		return ''
	}
	CC.Prime
	//---- まずディレクトリ。300 ミリ秒だけ落ち着くのを待ってからまとめて知らせてもらう
	_tags = '\![execute,filewatch,' + _dir + ',--async=OnClaudeCodeDir,--debounce=300]'
	//---- 続けて、今あるセッションのファイルを 1 つずつ
	_tags += CC.SyncWatches
	//---- 起動時の分は数に入れない（すでに動いていたセッションで騒がないため）
	ccadded     = 0
	ccaddedfile = ''
	_tags
}

//------------------------------------------------------------------------------
//通知領域のアイコン
//返事待ち（質問、ツールの実行の許可、計画の承認）のセッションが 1 つでもあれば
//アンソニー（icon_anthony.ico）、無ければクローディア（icon.ico）にする
//  cctrayicon  今出しているアイコン（claudia / anthony）。CC.Reset では触らない
//              （セッションが全部終わったときにも CC.Reset が呼ばれるため）
//------------------------------------------------------------------------------
CC.TrayIconWanted
{
	_wait = CC.WaitingOf(CC.Scan)
	_want = 'claudia'

	if ARRAYSIZE(_wait) > 0 {
		_want = 'anthony'
	}
	_want
}

//---- アイコンを変えるタグ。今と同じなら空文字列
CC.TrayIconTag
{
	_want = CC.TrayIconWanted
	_tag  = ''

	if _want != cctrayicon {
		cctrayicon = _want
		if _want == 'anthony' {
			_tag = '\![set,tasktrayicon,icon_anthony.ico]'
		}
		else {
			_tag = '\![set,tasktrayicon,icon.ico]'
		}
	}
	_tag
}

//---- 今どちらのアイコンか分からないとき（見張りを立て直したあと）に、必ずタグを返す
CC.TrayIconSync
{
	cctrayicon = ''
	CC.TrayIconTag
}

//------------------------------------------------------------------------------
//見張りの通知で返すスクリプトに、アイコンを変えるタグを添える
//話すことがないときは、先頭に \C を付けてバルーンの文字を消さないようにする
//  _argv[0] 返すつもりのスクリプト（空でもよい）
//------------------------------------------------------------------------------
CC.WithTrayIcon
{
	_script = _argv[0]
	_tag    = CC.TrayIconTag

	if STRLEN(_tag) == 0 {
		return _script
	}
	if STRLEN(_script) == 0 {
		return '\C' + _tag + '\e'
	}
	if SUBSTR(_script, 0, 2) == '\C' {
		return '\C' + _tag + SUBSTR(_script, 2, STRLEN(_script))
	}
	_tag + _script
}

//------------------------------------------------------------------------------
//Claude Code の話をしてよいか。前に話してから _argv[0] 秒たっていたら 1 を返す
//------------------------------------------------------------------------------
CC.TalkOK
{
	_now  = GETSECCOUNT
	_past = _now - cctalkat
	_ok   = 0

	//---- 時計が巻き戻ったときは十分あいたものとして扱う
	if _past < 0 {
		_past = 86400
	}
	if cctalkat == 0 || _past >= _argv[0] {
		_ok = 1
	}
	_ok
}


//******************************************************************************
//見張りからの通知
//******************************************************************************

//------------------------------------------------------------------------------
//セッションのディレクトリに変化があった（セッションが増えた・減った）
//  reference[0] --async に渡した文字列 / reference[1] 見張っているパス
//  reference[2] changed（直下で何か起きた）/ deleted（ディレクトリ自体が消えた）
//
//ここでは各ファイルの見張りを立て直すだけ。話すことがないときは、先頭に \C を付けて
//バルーンの文字を消さないようにする
//セッションが増えたり減ったりすると返事待ちの数も変わるので、アイコンも合わせる
//------------------------------------------------------------------------------
OnClaudeCodeDir
{
	CC.WithTrayIcon(CC.DirChanged)
}

CC.DirChanged
{
	_tags = ''
	_talk = ''
	_s    = IHASH()

	if reference[2] == 'deleted' {
		return ''
	}
	_tags = CC.SyncWatches
	if STRLEN(_tags) == 0 {
		//---- 立て直すものが無ければ、何も返さないのがいちばん邪魔にならない
		return ''
	}

	//---- 功績録に数える（yaya_ccstats.dic）
	if ccadded > 0 {
		CCS.Count('new', ccadded)
		if CC.IsLate {
			CCS.Count('late', ccadded)
		}
	}

	//---- セッションが新しく立ち上がったときだけ、ひとこと
	//---- 起動時にすでに動いていた分は CC.Start が ccadded を 0 に戻すので、ここには来ない
	if ccadded > 0 && CC.TalkOK(60) {
		cctalkat = GETSECCOUNT
		_s       = CC.ReadSession(CC.SessionDir + '/' + ccaddedfile)
		_talk    = CC.WithLabel(CC.TalkNewFor(_s['cwd']), CC.Label(_s['name'], _s['cwd']))
	}

	if STRLEN(_talk) > 0 {
		return _tags + _talk
	}
	'\C' + _tags + '\e'
}

//------------------------------------------------------------------------------
//セッションのファイルが変わった（状態が動いた、またはセッションが終わった）
//  reference[1] 見張っているパス / reference[2] modified / created / deleted
//------------------------------------------------------------------------------
OnClaudeCodeFile
{
	CC.WithTrayIcon(CC.NoticeFile(reference[1], reference[2]))
}

//------------------------------------------------------------------------------
//見張りを始められなかった、または続けられなくなった
//  reference[2] notauthorized / invalid / notfound / limit
//------------------------------------------------------------------------------
OnClaudeCodeDirFailure
{
	//---- フォルダが無い（Claude Code を消した、など）ときは騒がない
	if reference[2] == 'notfound' {
		return ''
	}
	"\u\s[10]\0\s[3]Claude Code の見張りに失敗しましたわ。\w9\n理由は %(reference[2]) ですって。\w8\1おそれいります、お嬢様。\e"
}

//---- ファイルの見張りが切れたときは、ディレクトリの見張りが立て直すので黙っておく
OnClaudeCodeFileFailure
{
	''
}

//------------------------------------------------------------------------------
//変わったセッション 1 つを見て、話すことを決める
//  _argv[0] ファイルのパス / _argv[1] modified / created / deleted
//毎回のツール実行では書き換わらないので、ここに来るのは本当に状態が動いたときだけ
//------------------------------------------------------------------------------
CC.NoticeFile
{
	//---- if の中で初めて代入したローカル変数は外に出ないので、先に置く
	_s       = IHASH()
	_status  = ''
	_id      = ''
	_at      = 0
	_waiting = ''
	_before  = ''
	_busyfor = 0
	_pending = IHASH()
	_stats   = IHASH()
	_talk    = ''
	_sound   = ''
	_label   = ''

	//---- セッションが終わった
	if _argv[1] == 'deleted' {
		if ARRAYSIZE(CC.Scan) == 0 && STRLEN(ccsession) > 0 {
			CC.Reset
			if CC.TalkOK(60) {
				cctalkat = GETSECCOUNT
				_talk    = CC.TalkGone
			}
		}
		return _talk
	}

	_s = CC.ReadSession(_argv[0])
	//---- 端末で動いているものだけを相手にする（読めなかったときもここで帰る）
	if _s['kind'] != 'interactive' {
		return ''
	}

	_status  = _s['status']
	_waiting = _s['waitingFor']
	_at      = TOINT(_s['statusUpdatedAt'])
	_id      = _s['sessionId']

	//---- 続けて作業している時間を数える（ccstatus がまだ前の状態のうちに呼ぶ）
	CC.MarkWork

	//---- 同じセッションが同じ状態のままなら黙る
	if _id == ccsession && _status == ccstatus {
		return ''
	}

	//---- 前の状態が当てになるのは、同じセッションを続けて見ているときだけ
	if _id == ccsession {
		_before = ccstatus
	}

	//---- 功績録に数える（yaya_ccstats.dic）。返事待ちから作業に戻ったら「応えた」、
	//---- 作業から離れたら、その間を Claude が働いた時間に
	if _before == 'waiting' && _status == 'busy' {
		CCS.Count('answer')
	}
	if _before == 'busy' && ccbusyid == _id && ccbusyat > 0 {
		_busyfor = (_at - ccbusyat) / 1000
		if _busyfor > 0 && _busyfor < 86400 {
			CCS.Count('busy', _busyfor)
			if _status == 'idle' && _busyfor >= 90 {
				CCS.Count('done')
			}
			if _status == 'idle' && _busyfor >= 600 {
				CCS.Count('long')
			}
		}
	}

	if _status == 'busy' {
		ccbusyid   = _id
		ccbusyat   = _at
		ccbusytold = 0
		ccbusyname = _s['name']
		ccbusycwd  = _s['cwd']
		//---- 新しい依頼を受けた（返事待ちからの再開ではない）。ここから働きぶりを数える
		if _before != 'waiting' {
			ccturnid  = _id
			ccturnpos = FSIZE(CC.TranscriptPath(_s['cwd'], _id))
		}
	}

	ccsession = _id
	ccstatus  = _status

	case _status {
		when 'waiting' {
			//---- こちらの返事を待っている。Pets でいういちばん大事なところ
			//---- ベルは話さないときも鳴らし、ここから 5 分ごとのリマインダを数え始める
			//---- どちらもメニューの「設定」で止められる（ccbelloff / ccremindoff）
			ccremindat = 0
			ccremindn  = 0
			if ccremindoff != 1 {
				ccremindat = GETSECCOUNT
			}
			if CC.TalkOK(15) {
				_pending = CC.Pending(_s['cwd'], _id)
				_talk    = CC.TalkWaiting(_waiting, _pending['tool'], _pending['detail'])
			}
			if ccbelloff != 1 {
				_sound = CC.WaitSound(_waiting, 2)
			}
		}
		when 'idle' {
			//---- 作業が終わった。ただし短い受け答えのたびに騒ぐとうるさいので、
			//---- 同じセッションがしばらく考え込んでいたときだけ労う
			//---- 完了音は話さないときも、15 秒以上かかっていれば鳴らす。メニューの「設定」で止められる（ccdoneoff）
			_busyfor = (_at - ccbusyat) / 1000
			//---- API のエラーで止まったと先にフックから知らされていたら、ねぎらわない（yaya_cchook.dic）
			if _before == 'busy' && ccbusyid == _id && ccbusyat > 0 && _busyfor >= 15 && !CCH.JustFailed(_id) {
				if _busyfor >= 90 && CC.TalkOK(120) {
					//---- 依頼を受けてからの働きぶりを数えて、完了報告に添える。題名もここで読み直す
					if ccturnid == _id {
						_stats = CC.TurnStats(_s['cwd'], _id, ccturnpos)
					}
					void CC.ReadTail(_s['cwd'], _id)
					_talk = CC.TalkDoneFor(_busyfor, _stats)
				}
				if ccdoneoff != 1 {
					_sound = CC.DONE
				}
			}
		}
	}

	//---- 話したときだけ、話した時刻を覚える（音だけのときは数えない）
	//---- 呼び名は、題名を読み直した（CC.Pending、CC.ReadTail）後で作る
	if STRLEN(_talk) > 0 {
		cctalkat = GETSECCOUNT
		_label   = CC.Label(_s['name'], _s['cwd'], _id)
		return _sound + CC.WithLabel(_talk, _label)
	}
	if STRLEN(_sound) > 0 {
		return '\C' + _sound + '\e'
	}
	''
}

//------------------------------------------------------------------------------
//ユーザーを呼ぶベルと、作業が終わったときの完了音（ghost/master の WAV ファイル）
//------------------------------------------------------------------------------
CC.DONE
{
	'\![sound,play,cc_done.wav]'
}

CC.BELL2
{
	'\![sound,play,cc_bell2.wav]'
}

CC.BELL1
{
	'\![sound,play,cc_bell1.wav]'
}

//---- ツールの実行の許可待ち（waitingFor が permission prompt）の音。ベルより短く軽い 3 音
CC.PERM
{
	'\![sound,play,cc_perm.wav]'
}

//------------------------------------------------------------------------------
//返事待ちで鳴らす音を選ぶ。許可待ちなら CC.PERM、それ以外はベル
//  _argv[0] waitingFor / _argv[1] ベルの回数（2 なら CC.BELL2、それ以外は CC.BELL1）
//何のツールで止まっているかは記録に書き出されないことがあるので、waitingFor だけで決める
//（plan mode の計画の承認も permission prompt なので、こちらの音になる）
//------------------------------------------------------------------------------
CC.WaitSound
{
	_sound = CC.BELL1
	if CC.IsPermission(_argv[0]) {
		_sound = CC.PERM
	}
	elseif _argv[1] == 2 {
		_sound = CC.BELL2
	}
	_sound
}

//---- waitingFor が許可待ちなら 1
CC.IsPermission
{
	_is = 0
	if STRSTR(_argv[0], 'permission', 0) >= 0 {
		_is = 1
	}
	_is
}

//------------------------------------------------------------------------------
//返事待ちを放っておかれたときのリマインダ。OnSecondChange から 1 秒おきに呼ばれる
//最後にベルを鳴らしてから 5 分たったら、まだ返事待ちのセッションがあるかを確かめて
//ベルを 1 回鳴らす。3 回鳴らしたらやめる
//ふだんは時刻を比べるだけで、セッションのファイルは読まない
//------------------------------------------------------------------------------
CC.Remind
{
	_now     = GETSECCOUNT
	_wait    = IARRAY
	_s       = IHASH()
	_pending = IHASH()
	_label   = ''
	_talk    = ''

	if GETTYPE(ccremindat) == 0 || ccremindat <= 0 || ccremindoff == 1 {
		return ''
	}
	//---- 時計が巻き戻ったときは、そこから数え直す
	if _now < ccremindat {
		ccremindat = _now
		return ''
	}
	if _now - ccremindat < 300 {
		return ''
	}

	//---- まだ返事待ちのセッションがあるか
	_wait = CC.WaitingOf(CC.Scan)
	if ARRAYSIZE(_wait) == 0 {
		//---- もう返事をした
		ccremindat = 0
		ccremindn  = 0
		return ''
	}

	ccremindn += 1
	ccremindat = _now
	if ccremindn >= 3 {
		//---- これで最後
		ccremindat = 0
	}
	_s       = _wait[0]
	_pending = CC.Pending(_s['cwd'], _s['sessionId'])
	_label   = CC.Label(_s['name'], _s['cwd'], _s['sessionId'])
	_talk    = CC.WithLabel(CC.TalkRemind(ccremindn, _pending['detail'], CC.IsPermission(_s['waitingFor'])), _label)
	cctalkat = _now
	CC.WaitSound(_s['waitingFor'], 1) + _talk
}

//------------------------------------------------------------------------------
//起動トークの最後に付けるタグ。話し終わって 5 秒たったら OnClaudeCodeBootCheck が来る
//------------------------------------------------------------------------------
CC.BootTimer
{
	'\![timerraise,5000,1,OnClaudeCodeBootCheck]'
}

//------------------------------------------------------------------------------
//起動したときに、すでに返事待ちのセッションがあれば、リマインダと同じように
//ベルを鳴らして知らせ、そこから 5 分ごとのリマインダを数え始める
//返事待ちが複数あれば呼び名を並べる。何を待たれているかは最初の 1 件だけ
//通知領域のアイコンも、起動時のクローディアから今の状態に合わせる
//------------------------------------------------------------------------------
OnClaudeCodeBootCheck
{
	CC.WithTrayIcon(CC.BootCheck)
}

CC.BootCheck
{
	_now     = GETSECCOUNT
	_wait    = IARRAY
	_labels  = ''
	_i       = 0
	_s       = IHASH()
	_pending = IHASH()

	if ccremindoff == 1 {
		return ''
	}
	//---- 起動トークの間に返事待ちになったものは、もう知らせてリマインダも数えている
	if GETTYPE(ccremindat) != 0 && ccremindat > 0 {
		return ''
	}

	_wait = CC.WaitingOf(CC.Scan)
	if ARRAYSIZE(_wait) == 0 {
		return ''
	}
	//---- 何を待たれているかは最初の 1 件だけ。題名は全部読み直してから呼び名を並べる
	_s       = _wait[0]
	_pending = CC.Pending(_s['cwd'], _s['sessionId'])
	foreach _wait ; _i, _s {
		if _i > 0 {
			void CC.ReadTail(_s['cwd'], _s['sessionId'])
			_labels += '、'
		}
		_labels += CC.Label(_s['name'], _s['cwd'], _s['sessionId'])
	}

	ccremindat = _now
	ccremindn  = 0
	cctalkat   = _now
	CC.WaitSound(_wait[0]['waitingFor'], 1) + CC.WithLabel(CC.TalkBootWaiting(_pending['detail']), _labels)
}

//------------------------------------------------------------------------------
//長く考え込んでいるとき。OnMinuteChange から 1 分おきに呼ばれる
//------------------------------------------------------------------------------
CC.LongBusy
{
	_busyfor = 0
	_talk    = ''

	if ccstatus != 'busy' || ccbusyat <= 0 || ccbusytold {
		return ''
	}
	_busyfor = GETSECCOUNT - ccbusyat / 1000
	if _busyfor >= 600 && CC.TalkOK(120) {
		ccbusytold = 1
		cctalkat   = GETSECCOUNT
		//---- 作業の間に題名が付いたり変わったりしているので、読み直してから呼び名を作る
		void CC.ReadTail(ccbusycwd, ccbusyid)
		_talk      = CC.WithLabel(CC.TalkLong, CC.Label(ccbusyname, ccbusycwd, ccbusyid))
	}
	_talk
}

//------------------------------------------------------------------------------
//OnMinuteChange から 1 分おきに呼ぶ。長考の声かけを優先し、無ければ休憩のすすめ、
//それも無ければ功績録の節目のお祝い（yaya_ccstats.dic）
//------------------------------------------------------------------------------
CC.Minute
{
	_talk = CC.LongBusy
	//---- 執務（ポモドーロ）の間は、休憩の区切りがあるので勧めない（yaya_teatimer.dic）
	if STRLEN(_talk) == 0 && !TM.PomoOn {
		_talk = CC.LongWork
	}
	if STRLEN(_talk) == 0 {
		_talk = CCS.Minute
	}
	_talk
}


//******************************************************************************
//続けて作業している時間と、休憩のすすめ
//******************************************************************************
//
//どれかのセッションの状態が動いたら「作業している」とみなす。状態が 30 分動かず、
//しかも作業中（busy）でもなければ、そこで一区切り。次に動いたときから数え直す。
//続けて 2 時間たつごとに、お茶の休憩を勧める。メニューの「設定」で止められる（ccbreakoff）
//
//  ccworkfrom 続けて作業し始めた時刻（Unix 秒）。0 なら数えていない
//  ccworkat   最後にセッションの状態が動いた時刻（Unix 秒）
//  ccbreakn   その間に休憩を勧めた回数
//******************************************************************************

CC.ResetWork
{
	ccworkfrom = 0
	ccworkat   = 0
	ccbreakn   = 0
}

//------------------------------------------------------------------------------
//セッションの状態が動いたときに呼ぶ。値は返さない（裸で呼ぶため）
//------------------------------------------------------------------------------
CC.MarkWork
{
	_now = GETSECCOUNT

	if GETTYPE(ccworkfrom) == 0 || ccworkfrom <= 0 || _now < ccworkat {
		ccworkfrom = _now
		ccbreakn   = 0
	}
	elseif _now - ccworkat > 1800 && ccstatus != 'busy' {
		//---- しばらく手が止まっていた。ここから数え直す
		ccworkfrom = _now
		ccbreakn   = 0
	}
	else {
		//---- 続けて作業している。功績録に数える（yaya_ccstats.dic）
		CCS.Count('work', _now - ccworkat)
		CCS.WorkSpan(_now - ccworkfrom)
	}
	ccworkat = _now
}

//------------------------------------------------------------------------------
//執務（ポモドーロ、yaya_teatimer.dic）を終えたときに呼ぶ。執務の間は休憩をとれていたので、
//そのあいだに過ぎた 2 時間の区切りでは勧めず、次の区切りから勧める。値は返さない（裸で呼ぶため）
//------------------------------------------------------------------------------
CC.SkipBreak
{
	if GETTYPE(ccworkfrom) != 0 && ccworkfrom > 0 && GETSECCOUNT > ccworkfrom {
		ccbreakn = TOINT((GETSECCOUNT - ccworkfrom) / 7200)
	}
}

//------------------------------------------------------------------------------
//続けて 2 時間、4 時間、‥‥と作業していたら休憩を勧める
//------------------------------------------------------------------------------
CC.LongWork
{
	_now   = GETSECCOUNT
	_hours = 0

	if ccbreakoff == 1 || GETTYPE(ccworkfrom) == 0 || ccworkfrom <= 0 {
		return ''
	}
	//---- 時計が巻き戻ったときは、そこから数え直す
	if _now < ccworkfrom {
		ccworkfrom = _now
		ccworkat   = _now
		ccbreakn   = 0
		return ''
	}
	//---- もう手が止まっている。休憩中の人に休憩を勧めても仕方がない
	if _now - ccworkat > 1800 && ccstatus != 'busy' {
		return ''
	}
	if _now - ccworkfrom < 7200 * (ccbreakn + 1) {
		return ''
	}
	if !CC.TalkOK(120) {
		return ''
	}
	ccbreakn += 1
	cctalkat  = _now
	CCS.Count('break')
	_hours    = TOINT((_now - ccworkfrom) / 3600)
	CC.TalkBreak(ccbreakn, _hours)
}


//******************************************************************************
//トークの選び分け
//******************************************************************************

//------------------------------------------------------------------------------
//作業フォルダがこのゴースト（悪役令嬢クローディア）のものなら 1
//clone したフォルダでも、SSP にインストールしたフォルダでも、同じ場所にこの辞書がある
//  _argv[0] cwd
//------------------------------------------------------------------------------
CC.IsSelf
{
	_cwd = REPLACE(_argv[0], '\', '/')
	_is  = 0
	if STRLEN(_cwd) > 0 && FSIZE(_cwd + '/ghost/master/dic/normal/yaya_claudecode.dic') > 0 {
		_is = 1
	}
	_is
}

//---- 夜更け（1 時から 4 時台）なら 1
CC.IsLate
{
	_is = 0
	if hour >= 1 && hour <= 4 {
		_is = 1
	}
	_is
}

//---- 新しいセッションのトーク。_argv[0] cwd
CC.TalkNewFor
{
	_talk = ''
	if CC.IsSelf(_argv[0]) {
		_talk = CC.TalkNewSelf
	}
	elseif CC.IsLate {
		_talk = CC.TalkNewLate
	}
	else {
		_talk = CC.TalkNew
	}
	_talk
}

//---- 長考が片付いたときのトーク
//  _argv[0] かかった秒数 / _argv[1] 働きぶり（CC.TurnStats）。数えられなければ空のハッシュ
//  働きぶりが数えられれば、4 回に 3 回はそれを読み上げる（毎回だと単調になるため）
CC.TalkDoneFor
{
	_stats = _argv[1]
	_talk  = ''

	if CC.IsLate {
		_talk = CC.TalkDoneLate
	}
	elseif GETTYPE(_stats) == 5 && TOINT(_stats['tool']) > 0 && RAND(4) > 0 {
		_talk = CC.TalkDoneStats(_argv[0], _stats)
	}
	else {
		_talk = CC.TalkDone(_argv[0])
	}
	_talk
}

//------------------------------------------------------------------------------
//働きぶりを 1〜3 行の文にする。最後の行に改行は付けない
//  例: 「手直ししたファイルが3件、\w9\nコマンドが12回、調べものが8回。」
//  _argv[0] 働きぶり（CC.TurnStats）
//------------------------------------------------------------------------------
CC.StatsText
{
	_files   = TOINT(_argv[0]['files'])
	_command = TOINT(_argv[0]['command'])
	_look    = TOINT(_argv[0]['look'])
	_agent   = TOINT(_argv[0]['agent'])
	_tool    = TOINT(_argv[0]['tool'])
	_parts   = IARRAY
	_text    = ''

	if _files > 0 {
		_parts ,= "手直ししたファイルが%(_files)件"
	}
	if _command > 0 {
		_parts ,= "コマンドが%(_command)回"
	}
	if _look > 0 {
		_parts ,= "調べものが%(_look)回"
	}
	if _agent > 0 {
		_parts ,= "手の者の出番が%(_agent)回"
	}
	//---- どれにも当てはまらないツールだけだった
	if ARRAYSIZE(_parts) == 0 {
		_parts ,= "道具の出番が%(_tool)回"
	}
	//---- 1 行目に 1 つ、2 行目以降に 2 つずつ
	foreach _parts ; _i, _part {
		if _i == 1 || _i == 3 {
			_text += '、\w9\n'
		}
		elseif _i > 0 {
			_text += '、'
		}
		_text += _part
	}
	_text + '。'
}

//---- 働きぶりを添えて、長考が片付いたことを知らせる
//  _argv[0] かかった秒数 / _argv[1] 働きぶり（CC.TurnStats）
//  高笑いは、一度もしくじらずに片付いたときだけ
CC.TalkDoneStats
{
	_min   = TOINT(_argv[0] / 60)
	_what  = CC.StatsText(_argv[1])
	_error = TOINT(_argv[1]['error'])
	_pick  = IARRAY
	_head  = ''
	_tail  = ''

	if _error == 0 {
		_pick = ( /
			"\u\s[10]\0\s[5]おーっほっほっほ！\w9\n%(_min)分で片付きましたわ。\w9\n%(_what)", /
			"\u\s[10]\0\s[26]%(_min)分の大仕事でしたわね。\w9\n%(_what)", /
			"\u\s[10]\0\s[25]片付きましたわよ。\w9\n%(_what)" /
		)
		_head = _pick[RAND(3)]
		_pick = ( /
			'\w8\1しくじりは一度もございません。\e', /
			'\w8\1一度もつまずかずに、でございます。\w8\0\s[26]\n\n当然ですわ。\e', /
			'\w8\1お見事でございます。\w9\n中身のご確認はお忘れなく。\e' /
		)
		_tail = _pick[RAND(3)]
	}
	elseif _error <= 2 {
		_pick = ( /
			"\u\s[10]\0\s[26]%(_min)分の大仕事でしたわね。\w9\n%(_what)", /
			"\u\s[10]\0\s[0]終わりましたわよ。\w9\n%(_what)" /
		)
		_head = _pick[RAND(2)]
		_pick = ( /
			"\w8\1つまずきは%(_error)回だけでございます。\e", /
			"\w8\1途中で%(_error)回つまずきましたが、\w9\n立て直しております。\e" /
		)
		_tail = _pick[RAND(2)]
	}
	else {
		_pick = ( /
			"\u\s[10]\0\s[0]ようやく終わりましたわ。\w9\n%(_what)", /
			"\u\s[10]\0\s[4]%(_min)分もかかりましたわね。\w9\n%(_what)" /
		)
		_head = _pick[RAND(2)]
		_pick = ( /
			"\w8\1ただ、%(_error)回つまずいております。\w9\n中身はよくお確かめくださいませ。\e", /
			"\w8\1%(_error)回ほど失敗を重ねての\w9\n仕上がりでございます。\w8\0\s[7]\n\n‥\w5‥\w5あなたの目で確かめなさいな。\e" /
		)
		_tail = _pick[RAND(2)]
	}
	_head + _tail
}


//******************************************************************************
//一覧の見せ方（メニューから使う）
//******************************************************************************

//------------------------------------------------------------------------------
//status と waitingFor を日本語にする。_argv[2] は止まっているツール（CC.Pending）
//------------------------------------------------------------------------------
CC.StateName
{
	_name = '手すき'
	case _argv[0] {
		when 'busy' {
			_name = '作業中'
		}
		when 'waiting' {
			if _argv[2] == 'ExitPlanMode' {
				_name = '計画の承認待ち'
			}
			elseif _argv[2] == 'AskUserQuestion' {
				_name = '質問待ち'
			}
			elseif STRSTR(_argv[1], 'input', 0) >= 0 {
				_name = '返事待ち'
			}
			else {
				_name = '許可待ち'
			}
		}
	}
	_name
}

//------------------------------------------------------------------------------
//秒数を「1時間3分」「12分」「45秒」のように書く
//------------------------------------------------------------------------------
CC.Duration
{
	_sec  = TOINT(_argv[0])
	_text = ''

	if _sec < 0 {
		_sec = 0
	}
	if _sec < 60 {
		_text = _sec + '秒'
	}
	elseif _sec < 3600 {
		_text = TOINT(_sec / 60) + '分'
	}
	else {
		_text = TOINT(_sec / 3600) + '時間' + TOINT((_sec % 3600) / 60) + '分'
	}
	_text
}

//------------------------------------------------------------------------------
//起動中のセッションを並べた本文を作る。1 件も無ければ空文字列。最後の行に改行は付けない
//  _argv は CC.Scan の結果（セッションのハッシュ）。返事待ちを先に並べる
//  1 件は 2 行（名前と作業フォルダ、状態と経過）。待たれている中身がわかれば 3 行
//  大きいバルーン（24 行）に選択肢と情報バーまで収まるよう、14 行を超える分は
//  「ほかに N 件」にまとめる
//------------------------------------------------------------------------------
CC.ListBody
{
	_order = IARRAY
	_body  = ''
	_used  = 0
	_shown = 0
	_s     = IHASH()
	_p     = IHASH()
	_name  = ''
	_proj  = ''
	_row   = ''
	_cost  = 0

	foreach _argv ; _s {
		if _s['status'] == 'waiting' {
			_order ,= _s
		}
	}
	foreach _argv ; _s {
		if _s['status'] != 'waiting' {
			_order ,= _s
		}
	}
	foreach _order ; _s {
		//---- 返事待ちなら何を待たれているかも。どちらも題名を読み直す
		_p = IHASH()
		if _s['status'] == 'waiting' {
			_p = CC.Pending(_s['cwd'], _s['sessionId'])
		}
		else {
			void CC.ReadTail(_s['cwd'], _s['sessionId'])
		}
		//---- 名前と作業フォルダは記録から拾った文字なので、CC.Label で危ない文字を外す
		_proj = CC.Label('', _s['cwd'])
		_name = CC.Label(_s['name'], _s['cwd'], _s['sessionId'])
		_row  = '・' + SHIORI3FW.MakeShortText(_name, 30)
		if _name != _proj {
			_row += '（' + SHIORI3FW.MakeShortText(_proj, 14) + '）'
		}
		_row += '\n　' + CC.StateName(_s['status'], _s['waitingFor'], _p['tool']) + '　' + /
		        CC.Duration(GETSECCOUNT - TOINT(_s['statusUpdatedAt']) / 1000)
		_cost = 2
		//---- 何を待たれているかがわかれば、もう 1 行
		if STRLEN(_p['detail']) > 0 {
			_row  += '\n　「' + SHIORI3FW.MakeShortText(_p['detail'], 38) + '」'
			_cost += 1
		}
		if _shown > 0 && _used + _cost > 14 {
			break
		}
		if _shown > 0 {
			_body += '\n'
		}
		_body  += _row
		_used  += _cost
		_shown += 1
	}
	if ARRAYSIZE(_order) > _shown {
		_body += '\n・ほかに' + (ARRAYSIZE(_order) - _shown) + '件'
	}
	_body
}

//------------------------------------------------------------------------------
//一覧のあとのアンソニーのひとこと
//  _argv[0] 返事待ちの数 / _argv[1] 作業中の数 / _argv[2] 全部の数
//------------------------------------------------------------------------------
CC.ListButler
{
	_wait = _argv[0]

	if _argv[0] > 0 {
		"返事待ちが%(_wait)件ございます。\w9\nそちらからお先に。"
		"%(_wait)件、端末でお返事を\w9\nお待ちでございます。"
	}
	elseif _argv[1] == _argv[2] {
		'皆さま、手を動かして\w9\nおいででございます。'
		'つつがなく進んでおります。'
	}
	else {
		'手すきの方も\w9\nおいでのようでございます。'
		'次のご用命をお待ちの方も\w9\nおいででございます。'
	}
}


//******************************************************************************
//「Claude Code は？」の頁（実行中・作業履歴・新規起動）
//
//メニューの「Claude Code は？」は、実行中でなくても開ける。上端の見出しで 4 つの頁を切り替える。
//  実行中    今動いているセッションの一覧（CC.PageRun）。1 つも無ければ空欄のひとこと
//  作業履歴  これまでのセッションから選んで、続きを端末で開く（CC.PageHist）
//  新規起動  これまでに使った作業フォルダから選んで、そこで claude を新しく始める（CC.PageNew）
//  お知らせ  フックの知らせを送るプラグイン（鈴）の付け外し（CCH.Page。yaya_cchook.dic）
//
//履歴は、依頼の履歴 %USERPROFILE%\.claude\history.jsonl（功績録と同じファイル）を
//末尾から読んで、sessionId ごとに最後の依頼の時刻と作業フォルダ（project）を拾う（CC.HistScan）。
//Claude Code は会話の記録を一定の期間（既定で約 30 日）で片付けるので、
//履歴にあっても記録（CC.TranscriptPath）が無いセッションは claude -r で開けない。
//一覧には、記録が残っているものだけを出す（CC.HistList）。題名は記録の末尾から拾う（CC.ReadTail）。
//
//選ぶと OnCCResume（yaya_menu.dic）が呼ばれ、CC.Resume が作業フォルダを cwd にして
//claude -r <sessionId> を EXECUTE（第 3 引数の作業フォルダは Tc604-1 から）で開く。
//新規起動は、履歴の作業フォルダ（project）を重ねて新しい順に並べ（CC.DirList）、選ぶと OnCCNew が
//CC.NewSession を呼び、そのフォルダを cwd にして claude を引数なしで EXECUTE する。
//claude を拡張子なしで呼ぶのは、claude.exe 以外の入り口（他の OS）でも動くようにするため。
//EXECUTE はコンソールの見せ方を指定できないので、窓は既定の端末で開く。
//******************************************************************************

//------------------------------------------------------------------------------
//頁の上端の見出し。今の頁は太字、ほかは選択肢にする
//  _argv[0] 今の頁（1 実行中 / 2 作業履歴 / 3 新規起動 / 4 お知らせ（CCH.Page。yaya_cchook.dic））
//------------------------------------------------------------------------------
CC.Tabs
{
	_names = ('実行中', '作業履歴', '新規起動', 'お知らせ')
	_ids   = ('Menu_CLAUDECODE', 'Menu_CCHIST', 'Menu_CCNEW', 'Menu_CCHOOK')
	_i     = 0
	_name  = ''
	_talk  = ''

	foreach _names ; _i, _name {
		if _i > 0 {
			_talk += '｜'
		}
		if _i + 1 == _argv[0] {
			_talk += '\f[bold,1]' + _name + '\f[default]'
		}
		else {
			_talk += '\q[' + _name + ',' + _ids[_i] + ']'
		}
	}
	_talk + '\n\f[align,center]―― ◇ ――\n\f[align,left]'
}

//------------------------------------------------------------------------------
//見出しで切り替える頁を、全体を 1 組の \_q で囲んで返す
//  _argv[0] 頁のトーク（見出しから掛け合い、選択肢、情報バーまで）
//  頁の切り替えを速くするため、\_q の中でもかかる \w の間と、途中の \_q は落とす。
//  表情（\s）は一度に流れるので、最後に指定したものが残る
//------------------------------------------------------------------------------
CC.Quick
{
	_talk = REPLACE(_argv[0], '\_q', '')
	_talk = RE_REPLACE(_talk, '\\w[0-9]', '')
	'\_q' + _talk + '\_q'
}

//------------------------------------------------------------------------------
//頁の下に付ける選択肢と情報バー。最後はアンソニーが話しているので、クローディアに戻って出す
//  _argv[0] 二段組みの選択肢（MENU.Grid の結果）/ _argv[1] 情報バーの中身
//------------------------------------------------------------------------------
CC.PageBottom
{
	'\0\n\n[half]' + _argv[0] + '\n' + MENU.InfoBar(_argv[1])
}

//------------------------------------------------------------------------------
//実行中の頁。一覧、アンソニーのひとこと、選択肢、情報バーを、間を取らずに一度に出す（CC.Quick）
//  セッションの一覧（CC.Scan）はファイルを読むので、一覧と情報バーで 1 回の結果を使う
//  本文には記録から拾った文字が入るので、%() で展開せずにつなぐ
//------------------------------------------------------------------------------
CC.PageRun
{
	_list = CC.Scan
	_n    = ARRAYSIZE(_list)
	_wait = 0
	_busy = 0
	_s    = IHASH()
	_talk = ''

	foreach _list ; _s {
		if _s['status'] == 'waiting' {
			_wait += 1
		}
		elseif _s['status'] == 'busy' {
			_busy += 1
		}
	}
	if _n == 0 {
		_talk  = '\u\s[10]\0\s[4]\b[2]\_q' + CC.Tabs(1) + 'もう誰も働いておりませんわ。\_q'
		_talk += '\w8\1手すきのときは、\w9\n「作業履歴」から続きを開けますが。'
	}
	else {
		//---- 一覧は長くなるので大きいバルーン（\b[2]）で出す
		_talk  = '\u\s[10]\0\s[26]\b[2]\_q' + CC.Tabs(1) + 'ご覧なさい。今、これだけ動いておりましてよ。\n\n[half]'
		_talk += CC.ListBody(_list) + '\_q'
		_talk += '\w8\1' + CC.ListButler(_wait, _busy, _n)
	}
	_talk + CC.PageBottom(MENU.Grid('もう一度見る|Menu_CLAUDECODE', '見張りを立て直す|Menu_CCWATCH', '戻る|OpenMenu'), MENU.CCInfo(_wait, _busy, _n))
}

//------------------------------------------------------------------------------
//履歴の読み取り
//------------------------------------------------------------------------------

//------------------------------------------------------------------------------
//依頼の履歴（history.jsonl）の末尾から、セッションごとの最後の依頼の時刻と作業フォルダを拾う
//  戻り値  ハッシュ。last sessionId → 最後の依頼の時刻（ミリ秒）のハッシュ /
//          proj sessionId → 作業フォルダのハッシュ（円記号は JSON のまま \\ と重なっている）
//  履歴は 3 MB ほどに育つので、末尾の 512KB から読み、約 60 日前の依頼に届かなければ倍にして
//  読み直す（16MB まで）。JSON は解かず、文字列のまま拾う（CCS.Span と同じ）
//------------------------------------------------------------------------------
CC.HistScan
{
	_path  = CCS.HistPath
	_size  = 0
	_chunk = 524288
	_want  = (GETSECCOUNT - 60 * 86400) * 1000
	_from  = 0
	_first = 0
	_last  = IHASH()
	_proj  = IHASH()
	_line  = ''
	_i     = 0
	_j     = 0
	_ms    = 0
	_id    = ''
	_cwd   = ''

	if STRLEN(_path) > 0 {
		_size = FSIZE(_path)
	}
	if _size <= 0 {
		return IHASH('last', _last, 'proj', _proj)
	}
	while 1 {
		_from  = _size - _chunk
		_first = 0
		_last  = IHASH()
		_proj  = IHASH()
		if _from < 0 {
			_from = 0
		}
		if FOPEN(_path, 'r') {
			if _from > 0 {
				void FSEEK(_path, _from, 'SEEK_SET')
				//---- 行の途中から読み始めるので、最初の 1 行は捨てる
				_line = FREAD(_path)
			}
			while 1 {
				_line = FREAD(_path)
				if _line == -1 {
					break
				}
				_i = STRSTR(_line, '"timestamp":', 0)
				if _i < 0 {
					continue
				}
				_ms = TOINT(SUBSTR(_line, _i + 12, 20))
				_i  = STRSTR(_line, '"sessionId":"', 0)
				if _ms <= 0 || _i < 0 {
					continue
				}
				_id = SUBSTR(_line, _i + 13, 36)
				_i  = STRSTR(_line, '"project":"', 0)
				if _i < 0 {
					continue
				}
				_j   = STRSTR(_line, '"', _i + 11)
				_cwd = SUBSTR(_line, _i + 11, _j - _i - 11)
				if _first == 0 {
					_first = _ms
				}
				_last[_id] = _ms
				_proj[_id] = _cwd
			}
			void FCLOSE(_path)
		}
		if _from == 0 || (_first > 0 && _first <= _want) || _chunk >= 16777216 {
			break
		}
		_chunk *= 2
	}
	IHASH('last', _last, 'proj', _proj)
}

//------------------------------------------------------------------------------
//作業フォルダの JSON の書き方（\\）を、ふつうの円記号 1 つに戻す
//------------------------------------------------------------------------------
CC.UnescapePath
{
	REPLACE(_argv[0], '\\', '\')
}

//------------------------------------------------------------------------------
//続きを開けるセッションを、最後の依頼の新しい順に並べる（会話の記録が残っているものだけ）
//  戻り値  ハッシュの配列。id sessionId / ts 最後の依頼の時刻（Unix 秒）/ cwd 作業フォルダ
//------------------------------------------------------------------------------
CC.HistList
{
	_scan = CC.HistScan
	_last = _scan['last']
	_proj = _scan['proj']
	_keys = IARRAY
	_list = IARRAY
	_id   = ''
	_ms   = 0
	_k    = ''
	_a    = IARRAY

	foreach _last ; _id, _ms {
		if FSIZE(CC.TranscriptPath(CC.UnescapePath(_proj[_id]), _id)) > 0 {
			_keys ,= _ms + '|' + _id
		}
	}
	if ARRAYSIZE(_keys) == 0 {
		return _list
	}
	//---- 時刻は 13 桁そろっているので、文字列の降順で新しい順になる
	_keys = ASORT('string,descending', _keys)
	foreach _keys ; _k {
		_a = SPLIT(_k, '|')
		_list ,= IHASH('id', _a[1], 'ts', TOINT(_a[0]) / 1000, 'cwd', CC.UnescapePath(_proj[_a[1]]))
	}
	_list
}

//------------------------------------------------------------------------------
//会話の記録の 1 行（メッセージ）の時刻を Unix 秒にする。読めなければ 0
//  行には "timestamp":"2026-10-05T08:12:25.123Z" の形（UTC）で入っている。
//  ファイルの更新時刻は、開いただけで cost-state などの行が足されて新しくなるので使えない。
//  時刻を持つのはメッセージの行だけで、これが API を最後に呼んだ時刻の目安になる
//  _argv[0] 行（CC.ReadTail の last）
//------------------------------------------------------------------------------
CC.LineSec
{
	_i   = STRSTR(_argv[0], '"timestamp":"', 0)
	_s   = ''
	_y   = 0
	_m   = 0
	_d   = 0
	_era = 0
	_yoe = 0
	_mp  = 0
	_doy = 0
	_doe = 0

	if _i < 0 {
		return 0
	}
	_s = SUBSTR(_argv[0], _i + 13, 19)
	if STRLEN(RE_REPLACE(_s, '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$', '')) > 0 {
		return 0
	}
	_y = TOINT(SUBSTR(_s, 0, 4))
	_m = TOINT(SUBSTR(_s, 5, 2))
	_d = TOINT(SUBSTR(_s, 8, 2))
	//---- 年月日を 1970/1/1 からの日数にする（3 月を年の始めとして数える）
	if _m <= 2 {
		_y = _y - 1
	}
	_era = TOINT(_y / 400)
	_yoe = _y - _era * 400
	_mp  = (_m + 9) % 12
	_doy = TOINT((153 * _mp + 2) / 5) + _d - 1
	_doe = _yoe * 365 + TOINT(_yoe / 4) - TOINT(_yoe / 100) + _doy
	(_era * 146097 + _doe - 719468) * 86400 + TOINT(SUBSTR(_s, 11, 2)) * 3600 + TOINT(SUBSTR(_s, 14, 2)) * 60 + TOINT(SUBSTR(_s, 17, 2))
}

//------------------------------------------------------------------------------
//プロンプトキャッシュが残っていそうなら 1（最後のメッセージから 1 時間以内）
//  Claude Code のプロンプトキャッシュは 1 時間。続きを開いたとき、これを過ぎていると
//  会話の全体を読み直すことになる。_argv[0] 最後のメッセージの時刻（Unix 秒）
//------------------------------------------------------------------------------
CC.HistFresh
{
	if GETSECCOUNT - TOINT(_argv[0]) <= 3600 {
		1
	}
	else {
		0
	}
}

//------------------------------------------------------------------------------
//履歴の 1 件を 2 行で書く。最後の行に改行は付けない
//  _argv[0] CC.HistList の 1 件 / _argv[1] 今も動いているなら 1
//  1 行目は題名（無ければセッションの呼び名、作業フォルダの名前）。動いていなければ選択肢にする
//  2 行目は最後のメッセージの日時、キャッシュの印（温は 1 時間以内、冷はそれより前）、作業フォルダ
//  日時は会話の記録の最後のメッセージ（CC.LineSec）から。読めなければ、履歴の最後の依頼の時刻
//------------------------------------------------------------------------------
CC.HistRow
{
	_s    = _argv[0]
	_tail = CC.ReadTail(_s['cwd'], _s['id'])
	_name = CC.Label(_tail['agent'], _s['cwd'], _s['id'])
	_sec  = CC.LineSec(_tail['last'])
	_t    = IARRAY
	_mark = '冷'
	_row  = ''

	if _sec <= 0 {
		_sec = _s['ts']
	}
	_t = GETTIME(_sec)
	if CC.HistFresh(_sec) {
		_mark = '温'
	}

	if _argv[1] == 1 {
		_row = '　' + SHIORI3FW.MakeShortText(_name, 32) + '（実行中）'
	}
	else {
		_row = '\![*]\q[' + AYATEMPLATE.EscapeText(SHIORI3FW.MakeShortText(_name, 40)) + ',OnCCResume,' + _s['id'] + ']'
	}
	_row + '\n　' + _t[1] + '/' + _t[2] + ' ' + _t[4] + ':' + SUBSTR(TOSTR(100 + _t[5]), 1, 2) + '　' + _mark + '　' + SHIORI3FW.MakeShortText(CC.Label('', _s['cwd']), 22)
}

//---- 履歴の頁のアンソニーのひとこと
CC.HistButler : nonoverlap
{
	'古いものは Claude Code が\w9\n片付けてしまいますので、\w9\n残っている分だけでございます。'
	'お選びになれば、\w9\nその作業フォルダで\w9\n続きを開きます。'
}

//------------------------------------------------------------------------------
//履歴の頁。続きを開けるセッションを 6 件ずつ並べる
//  _argv[0] 頁の番号（1 から。範囲を外れたら寄せる）
//------------------------------------------------------------------------------
CC.PageHist
{
	_per   = 6
	_list  = CC.HistList
	_total = ARRAYSIZE(_list)
	_pages = (_total + _per - 1) / _per
	_page  = TOINT(_argv[0])
	_run   = IHASH()
	_now   = CC.Scan
	_s     = IHASH()
	_row   = IHASH()
	_i     = 0
	_end   = 0
	//---- 前後の頁が無いときは空欄（'-'）にして、「戻る」などの位置を動かさない
	_prev  = '-'
	_next  = '-'
	_talk  = ''

	if _page > _pages {
		_page = _pages
	}
	if _page < 1 {
		_page = 1
	}
	//---- 今動いているセッション（二重に開かないよう、選べなくする）
	foreach _now ; _s {
		_run[_s['sessionId']] = 1
	}
	if _total == 0 {
		_talk  = '\u\s[10]\0\s[3]\b[2]\_q' + CC.Tabs(2) + '続きを開ける履歴が、\nまだございませんわ。\_q'
		_talk += '\w8\1記録が残っているのは、\w9\nClaude Code が片付ける前の分だけでございます。'
		return _talk + CC.PageBottom(MENU.Grid('-', '-', '戻る|OpenMenu'), MENU.HistInfo(0, 1, 1))
	}
	_talk = '\u\s[10]\0\s[27]\b[2]\_q' + CC.Tabs(2) + 'どれの続きを開きますの？\n温＝1時間以内でキャッシュ有効／冷＝超過\n\n[half]'
	_end  = _page * _per
	if _end > _total {
		_end = _total
	}
	for _i = (_page - 1) * _per ; _i < _end ; _i++ {
		if _i > (_page - 1) * _per {
			_talk += '\n'
		}
		_row   = _list[_i]
		_talk += CC.HistRow(_row, TOINT(_run[_row['id']]))
	}
	_talk += '\_q\w8\1' + CC.HistButler
	if _page > 1 {
		_prev = '前の頁|OnCCHistPage|' + (_page - 1)
	}
	if _page < _pages {
		_next = '次の頁|OnCCHistPage|' + (_page + 1)
	}
	_talk + CC.PageBottom(MENU.Grid(_prev, _next, '戻る|OpenMenu'), MENU.HistInfo(_total, _page, _pages))
}

//------------------------------------------------------------------------------
//履歴から選んだセッションを、作業フォルダで claude -r で開く
//  _argv[0] sessionId（履歴の一覧が出したもの）
//  戻り値  トーク。開けなければ、その理由を話す
//------------------------------------------------------------------------------
CC.Resume
{
	_id    = _argv[0]
	_scan  = IHASH()
	_proj  = IHASH()
	_now   = CC.Scan
	_cwd   = ''
	_attr  = IARRAY
	_tail  = IHASH()
	_name  = ''
	_ret   = 0
	_s     = IHASH()

	//---- sessionId は履歴の一覧が出した UUID のはず。違う形のものは相手にしない
	if STRLEN(_id) != 36 || STRLEN(RE_REPLACE(_id, '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$', '')) > 0 {
		return '\u\s[10]\0\s[3]その記録は見当たりませんわ。\w8\1お選び直しくださいませ。\e'
	}
	foreach _now ; _s {
		if _s['sessionId'] == _id {
			return '\u\s[10]\0\s[27]そちらは今も動いておりますわ。\w9\n端末をお探しなさいな。\e'
		}
	}
	_scan = CC.HistScan
	_proj = _scan['proj']
	_cwd  = CC.UnescapePath(_proj[_id])
	if STRLEN(_cwd) == 0 || FSIZE(CC.TranscriptPath(_cwd, _id)) <= 0 {
		return '\u\s[10]\0\s[3]その記録は、もう片付けられたようですわ。\w8\1お選び直しくださいませ。\e'
	}
	_attr = FATTRIB(_cwd)
	if ARRAYSIZE(_attr) <= 2 || _attr[2] != 1 {
		return '\u\s[10]\0\s[3]作業フォルダが見当たりませんわ。\w9\n移したか、消したのかしら？\e'
	}
	_tail = CC.ReadTail(_cwd, _id)
	_name = SHIORI3FW.MakeShortText(CC.Label(_tail['agent'], _cwd, _id), 30)
	//---- 戻り値は ShellExecute のもの。33 以上なら起動できている
	_ret = EXECUTE('claude', '-r "' + _id + '"', REPLACE(_cwd, '\', '/'))
	if _ret < 33 {
		return '\u\s[10]\0\s[3]claude を起動できませんでしたわ。\w8\1Claude Code は、\w9\nお入れでしょうか。\e'
	}
	'\u\s[10]\0\s[26]よろしくてよ。\w9\n「' + _name + '」の続きを\w9\n開きますわ。\w8\1端末をご覧くださいませ。\e'
}


//------------------------------------------------------------------------------
//新規の頁。今まで Claude Code を使った作業フォルダを、新しい順に並べる
//------------------------------------------------------------------------------

//------------------------------------------------------------------------------
//履歴にある作業フォルダを、最後に依頼した新しい順に並べる（フォルダごとに 1 件。実在するものだけ）
//  戻り値  ハッシュの配列。id そのフォルダで最後に依頼したセッションの sessionId /
//          ts 最後の依頼の時刻（Unix 秒）/ cwd 作業フォルダ
//  選択肢にはパスを載せず、id を載せる（パスのカンマや円記号で選択肢が壊れないように。
//  開くときは id から作業フォルダを引き直す。CC.NewSession）
//  履歴は約 60 日分（CC.HistScan）。Windows のパスは大文字小文字を区別しないので、同じものとして重ねる
//------------------------------------------------------------------------------
CC.DirList
{
	_scan = CC.HistScan
	_last = _scan['last']
	_proj = _scan['proj']
	_best = IHASH()
	_pick = IHASH()
	_keys = IARRAY
	_list = IARRAY
	_id   = ''
	_ms   = 0
	_cwd  = ''
	_key  = ''
	_k    = ''
	_a    = IARRAY
	_attr = IARRAY

	foreach _last ; _id, _ms {
		_cwd = CC.UnescapePath(_proj[_id])
		if STRLEN(_cwd) == 0 {
			continue
		}
		_key = TOLOWER(_cwd)
		if _ms > TOINT(_best[_key]) {
			_best[_key] = _ms
			_pick[_key] = _id
		}
	}
	foreach _pick ; _key, _id {
		_keys ,= _best[_key] + '|' + _id
	}
	if ARRAYSIZE(_keys) == 0 {
		return _list
	}
	//---- 時刻は 13 桁そろっているので、文字列の降順で新しい順になる
	_keys = ASORT('string,descending', _keys)
	foreach _keys ; _k {
		_a    = SPLIT(_k, '|')
		_cwd  = CC.UnescapePath(_proj[_a[1]])
		_attr = FATTRIB(_cwd)
		if ARRAYSIZE(_attr) > 2 && _attr[2] == 1 {
			_list ,= IHASH('id', _a[1], 'ts', TOINT(_a[0]) / 1000, 'cwd', _cwd)
		}
	}
	_list
}

//---- 新規の頁のアンソニーのひとこと
CC.NewButler : nonoverlap
{
	'前の続きではなく、\w9\nまっさらな Claude Code を\w9\nお開きいたします。'
	'いつもの作業フォルダに\w9\n新しく席をご用意いたします。'
}

//------------------------------------------------------------------------------
//新規の頁。作業フォルダを 6 件ずつ並べる。選ぶと、そのフォルダで claude を新しく起動する
//  _argv[0] 頁の番号（1 から。範囲を外れたら寄せる）
//------------------------------------------------------------------------------
CC.PageNew
{
	_per   = 6
	_list  = CC.DirList
	_total = ARRAYSIZE(_list)
	_pages = (_total + _per - 1) / _per
	_page  = TOINT(_argv[0])
	_row   = IHASH()
	_t     = IARRAY
	_i     = 0
	_end   = 0
	//---- 前後の頁が無いときは空欄（'-'）にして、「戻る」などの位置を動かさない
	_prev  = '-'
	_next  = '-'
	_talk  = ''

	if _page > _pages {
		_page = _pages
	}
	if _page < 1 {
		_page = 1
	}
	if _total == 0 {
		_talk  = '\u\s[10]\0\s[3]\b[2]\_q' + CC.Tabs(3) + '開けるフォルダが、\nまだ履歴にございませんわ。\_q'
		_talk += '\w8\1Claude Code をお使いになれば、\w9\nここに並びます。'
		return _talk + CC.PageBottom(MENU.Grid('-', '-', '戻る|OpenMenu'), MENU.NewInfo(0, 1, 1))
	}
	_talk = '\u\s[10]\0\s[27]\b[2]\_q' + CC.Tabs(3) + 'どのフォルダで始めますの？\n最後に使った順ですわ。\n\n[half]'
	_end  = _page * _per
	if _end > _total {
		_end = _total
	}
	for _i = (_page - 1) * _per ; _i < _end ; _i++ {
		if _i > (_page - 1) * _per {
			_talk += '\n'
		}
		_row   = _list[_i]
		_t     = GETTIME(_row['ts'])
		_talk += '\![*]\q[' + AYATEMPLATE.EscapeText(SHIORI3FW.MakeShortText(CC.Safe(CC.ProjectName(_row['cwd'])), 40)) + ',OnCCNew,' + _row['id'] + ']'
		//---- 2 行目は日付と、フォルダの名前を除いた親のパス（名前は 1 行目に出ている）
		_talk += '\n　' + _t[1] + '/' + _t[2] + '　' + SHIORI3FW.MakeShortText(CC.Safe(RE_REPLACE(REPLACE(_row['cwd'], '\', '/'), '/[^/]*$', '')), 34)
	}
	_talk += '\_q\w8\1' + CC.NewButler
	if _page > 1 {
		_prev = '前の頁|OnCCNewPage|' + (_page - 1)
	}
	if _page < _pages {
		_next = '次の頁|OnCCNewPage|' + (_page + 1)
	}
	_talk + CC.PageBottom(MENU.Grid(_prev, _next, '戻る|OpenMenu'), MENU.NewInfo(_total, _page, _pages))
}

//------------------------------------------------------------------------------
//新規の頁から選んだ作業フォルダで、claude を新しく起動する
//  _argv[0] sessionId（CC.DirList が出したもの。ここから作業フォルダを引き直す）
//  戻り値  トーク。開けなければ、その理由を話す
//------------------------------------------------------------------------------
CC.NewSession
{
	_id   = _argv[0]
	_scan = IHASH()
	_proj = IHASH()
	_cwd  = ''
	_attr = IARRAY
	_name = ''
	_ret  = 0

	//---- sessionId は新規の頁が出した UUID のはず。違う形のものは相手にしない
	if STRLEN(_id) != 36 || STRLEN(RE_REPLACE(_id, '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$', '')) > 0 {
		return '\u\s[10]\0\s[3]そのフォルダは見当たりませんわ。\w8\1お選び直しくださいませ。\e'
	}
	_scan = CC.HistScan
	_proj = _scan['proj']
	_cwd  = CC.UnescapePath(_proj[_id])
	_attr = FATTRIB(_cwd)
	if STRLEN(_cwd) == 0 || ARRAYSIZE(_attr) <= 2 || _attr[2] != 1 {
		return '\u\s[10]\0\s[3]作業フォルダが見当たりませんわ。\w9\n移したか、消したのかしら？\e'
	}
	_name = SHIORI3FW.MakeShortText(CC.Safe(CC.ProjectName(_cwd)), 30)
	//---- 戻り値は ShellExecute のもの。33 以上なら起動できている
	_ret = EXECUTE('claude', '', REPLACE(_cwd, '\', '/'))
	if _ret < 33 {
		return '\u\s[10]\0\s[3]claude を起動できませんでしたわ。\w8\1Claude Code は、\w9\nお入れでしょうか。\e'
	}
	'\u\s[10]\0\s[26]よろしくてよ。\w9\n「' + _name + '」で\w9\n新しく始めますわ。\w8\1端末をご覧くださいませ。\e'
}


//******************************************************************************
//トーク
//******************************************************************************

//---- 返事を待たれている
//  _argv[0] waitingFor / _argv[1] 止まっているツール / _argv[2] その中身（CC.Pending）
CC.TalkWaiting
{
	_tool   = _argv[1]
	_detail = _argv[2]

	if _tool == 'ExitPlanMode' {
		//---- plan mode の「Ready to code?」
		if STRLEN(_detail) > 0 {
			"\u\s[10]\0\s[26]計画が出来上がったようですわ。\w9\n「%(_detail)」\w9\nお認めになるのかしら？\w8\1Ready to code? と\w9\n伺っております。\e"
			"\u\s[10]\0\s[0]段取りのご確認ですわ。\w9\n「%(_detail)」\w9\nよろしくて？\w8\1ご承認をお待ちでございます。\e"
			"\u\s[10]\0\s[7]計画書に判を押すのは\w9\nあなたの役目でしてよ。\w9\n「%(_detail)」\w8\1端末にてお待ちでございます。\e"
		}
		else {
			'\u\s[10]\0\s[26]計画が出来上がったようですわ。\w9\n目を通してお認めなさいな。\w8\1Ready to code? と\w9\n伺っております。\e'
			'\u\s[10]\0\s[0]段取りのご確認ですわ。\w9\n着手してよろしいのかしら？\w8\1ご承認をお待ちでございます。\e'
		}
	}
	elseif _tool == 'AskUserQuestion' || STRSTR(_argv[0], 'input', 0) >= 0 {
		//---- 質問、または返事待ち
		if _tool == 'AskUserQuestion' && STRLEN(_detail) > 0 {
			"\u\s[10]\0\s[2]あら、ご質問ですわよ。\w9\n「%(_detail)」\w8\1選んで差し上げてくださいませ。\e"
			"\u\s[10]\0\s[0]あなたに伺いたいことが\w9\nあるそうですわ。\w9\n「%(_detail)」\w8\1お答えをお待ちでございます。\e"
		}
		else {
			'\u\s[10]\0\s[0]お呼びのようでしてよ。\w8\1ご返事をお待ちでございます。\e'
			'\u\s[10]\0\s[26]あなた、手が止まっておりましてよ。\w8\1端末をご覧くださいませ。\e'
			'\u\s[10]\0\s[3]‥\w5‥\w5あちらが黙ってしまいましたわ。\w9\nあなたの番でしてよ。\w8\1端末でお待ちでございます。\e'
			'\u\s[10]\0\s[7]問いかけを放っておくものでは\w9\nありませんわ。\w8\1お返事を差し上げてくださいませ。\e'
			'\u\s[10]\0\s[26]ご相談があるそうですわよ。\w9\n聞いてお上げなさいな。\w8\1選択肢が並んでおります。\e'
		}
	}
	else {
		//---- ツールの実行の許可待ちなど
		if STRLEN(_detail) > 0 {
			"\u\s[10]\0\s[7]許可をお待ちですわよ。\w9\n「%(_detail)」ですって。\w8\1よろしければ、お通しくださいませ。\e"
			"\u\s[10]\0\s[0]%(_tool) の許可を\w9\n求めておりますわ。\w9\n「%(_detail)」\w8\1ご判断をお待ちでございます。\e"
		}
		else {
			'\u\s[10]\0\s[7]許可をお待ちですわよ。\w9\n早くお決めなさいな。\w8\1端末に伺いが立っております。\e'
			'\u\s[10]\0\s[4]待たされておりますわ。\w9\nよいのか悪いのか、はっきりなさい。\w8\1お返事を待っております。\e'
			'\u\s[10]\0\s[26]あちらがお伺いを立てておりますわ。\w9\n通すも止めるも、あなた次第。\w8\1端末をご覧くださいませ。\e'
		}
	}
}

//---- 返事待ちを放っておかれている
//  _argv[0] 何回目のリマインダか（1〜3）/ _argv[1] 待たれている中身（CC.Pending）
//  _argv[2] 許可待ちなら 1（CC.IsPermission）
CC.TalkRemind
{
	_detail = _argv[1]

	if _argv[2] == 1 {
		return CC.TalkRemindPermission(_argv[0], _detail)
	}
	case _argv[0] {
		when 1 {
			if STRLEN(_detail) > 0 {
				"\u\s[10]\0\s[7]「%(_detail)」の件、\w9\nまだ放ってありましてよ。\w8\1かれこれ5分、お待ちでございます。\e"
			}
			else {
				'\u\s[10]\0\s[7]まだお返事していませんのね。\w9\nもう5分ですわよ。\w8\1端末でお待ちでございます。\e'
				'\u\s[10]\0\s[26]あなた、お忘れではなくて？\w9\n端末が呼んでおりますわ。\w8\1もう5分ほど経っております。\e'
			}
		}
		when 2 {
			'\u\s[10]\0\s[4]‥\w5‥\w5もう10分ですわ。\w9\nいつまで待たせるおつもり？\w8\1お忙しいのでございましょう。\e'
			'\u\s[10]\0\s[7]10分も放っておくなんて、\w9\nあちらが気の毒ですわ。\w8\1じっと待っております。\e'
		}
		others {
			'\u\s[10]\0\s[6]15分。\w9\nこれ以上はお呼びしませんわよ。\w8\1お戻りになりましたら、\w9\n端末をご覧くださいませ。\e'
			'\u\s[10]\0\s[3]お返事がありませんわね。\w9\nお出かけかしら。\w8\1鐘はこれで最後にいたします。\e'
		}
	}
}

//---- 許可待ちを放っておかれている
//  _argv[0] 何回目のリマインダか（1〜3）/ _argv[1] 待たれている中身（CC.Pending）
CC.TalkRemindPermission
{
	_detail = _argv[1]

	case _argv[0] {
		when 1 {
			if STRLEN(_detail) > 0 {
				"\u\s[10]\0\s[7]「%(_detail)」の許可、\w9\nまだ出していませんのね。\w8\1かれこれ5分、お伺いが立っております。\e"
			}
			else {
				'\u\s[10]\0\s[7]許可をお待ちのまま、\w9\nもう5分ですわよ。\w8\1通すか止めるか、ご判断を。\e'
				'\u\s[10]\0\s[26]あなた、お伺いを\w9\n放ってありましてよ。\w8\1端末で手を止めてお待ちでございます。\e'
			}
		}
		when 2 {
			'\u\s[10]\0\s[4]‥\w5‥\w5許可ひとつで10分も\w9\n止めておくおつもり？\w8\1先に進めず困っております。\e'
			'\u\s[10]\0\s[7]10分ですわ。\w9\n判を押すだけでしてよ。\w8\1じっとお待ちでございます。\e'
		}
		others {
			'\u\s[10]\0\s[6]15分。\w9\n許可待ちのまま、これ以上はお呼びしませんわ。\w8\1お戻りになりましたら、\w9\n端末をご覧くださいませ。\e'
			'\u\s[10]\0\s[3]お返事がありませんわね。\w9\nお出かけかしら。\w8\1お伺いの鐘はこれで最後にいたします。\e'
		}
	}
}

//---- 起動したら、返事待ちのまま放ってあった
//  _argv[0] 待たれている中身（CC.Pending）
CC.TalkBootWaiting
{
	_detail = _argv[0]

	if STRLEN(_detail) > 0 {
		"\u\s[10]\0\s[7]「%(_detail)」の件、\w9\n放ったままでしてよ。\w8\1お留守の間から、\w9\nお待ちでございます。\e"
		"\u\s[10]\0\s[26]あら、来て早々ですけれど、\w9\n「%(_detail)」ですって。\w8\1ご返事をお待ちでございます。\e"
	}
	else {
		'\u\s[10]\0\s[7]落ち着く前に申しますけれど、\w9\n返事待ちのままでしてよ。\w8\1端末でお待ちでございます。\e'
		'\u\s[10]\0\s[8]あら、お返事をしないまま\w9\n出ていらしたのね。\w8\1端末をご覧くださいませ。\e'
	}
}

//---- 長く考え込んだ末に片付いた。_argv[0] はかかった秒数
CC.TalkDone : nonoverlap
{
	'\u\s[10]\0\s[5]おーっほっほっほ！\w9\n片付きましたわね。\w8\1お疲れさまでございました。\e'
	'\u\s[10]\0\s[26]終わったようですわね。\w8\1お茶をお淹れいたしましょうか。\w8\0\s[25]\n\nいただきますわ。\e'
	"\u\s[10]\0\s[25]よく粘りましたこと。\w9\n%(TOINT(_argv[0] / 60))分ほどかかりましてよ。\w8\1記録しておきましょうか。\w8\0\s[7]\n\n余計なことを。\e"
	'\u\s[10]\0\s[0]仕上がったようですわね。\w9\n中身は、あなたがご確認なさい。\w8\1鵜呑みはいけません。\e'
	'\u\s[10]\0\s[25]ようやく終わりましたわね。\w9\n待たされましたこと。\w8\1その間に、スコーンが焼けております。\e'
	'\u\s[10]\0\s[6]‥\w5‥\w5静かになりましたわ。\w9\n片付いたようですわね。\w8\1お見事でございます。\w8\0\s[26]\n\nわたくしの見立てどおりですわ。\e'
	"\u\s[10]\0\s[0]%(TOINT(_argv[0] / 60))分の大仕事でしたわね。\w9\n結果をご覧なさいな。\w8\1テストもお忘れなく。\e"
}

//---- まだ終わらない
CC.TalkLong : nonoverlap
{
	'\u\s[10]\0\s[3]‥\w5‥\w5まだ終わりませんの？\w8\1難しいお仕事なのでございましょう。\w8\0\s[7]\n\n気長に待って差し上げますわ。\e'
	'\u\s[10]\0\s[6]ずいぶん長考ですこと。\w8\1お茶を淹れ直してまいります。\e'
	'\u\s[10]\0\s[7]いつまで考え込んでいるのかしら。\w8\1急かしても早くはならないものでございます。\w8\0\s[4]\n\n‥\w5‥\w5わかっておりますわ。\e'
	'\u\s[10]\0\s[26]手間のかかるお仕事のようですわね。\w9\nそれだけ中身があるということですわ。\w8\1クッキーでもいかがでございますか。\e'
	'\u\s[10]\0\s[0]もう10分を過ぎましてよ。\w9\n様子を見ておあげなさい。\w8\1横道に逸れていないとよいのですが。\e'
}

//---- 新しいセッションが立ち上がった
CC.TalkNew : nonoverlap
{
	'\u\s[10]\0\s[26]あら、新しいお仕事？\w8\1お手並み拝見でございますね。\e'
	'\u\s[10]\0\s[0]始めましたわね。\w9\n精を出しなさいな。\w8\1御武運を。\e'
	'\u\s[10]\0\s[25]また働き手が増えましたわね。\w8\1賑やかでございます。\e'
	'\u\s[10]\0\s[26]あら、何を始めるのかしら。\w9\nわたくしにも見せなさいな。\w8\1のぞき見はほどほどに。\e'
	'\u\s[10]\0\s[0]新しいセッションですわね。\w9\n最初の指示が肝心でしてよ。\w8\1仰るとおりでございます。\e'
}

//---- 新しいセッションが、このゴーストのフォルダで立ち上がった
CC.TalkNewSelf : nonoverlap
{
	'\u\s[10]\0\s[2]あら、わたくしの辞書を\w9\n開くおつもり？\w8\1お嬢様の身だしなみの時間でございます。\w8\0\s[26]\n\n‥\w5‥\w5丁寧になさいな。\e'
	'\u\s[10]\0\s[1]わたくしを手直しするのね。\w9\n美しく仕上げてくださる？\w8\1鏡をお持ちいたします。\e'
	'\u\s[10]\0\s[26]あら、わたくしの番ですの？\w9\n台詞の一つ一つまで\w9\n吟味なさいな。\w8\1check-dic もお忘れなく。\e'
	'\u\s[10]\0\s[7]わたくしの口調を変えたら、\w9\n承知しませんわよ。\w8\1「ですわ」は死守とのことでございます。\e'
}

//---- 新しいセッションが、夜更けに立ち上がった
CC.TalkNewLate : nonoverlap
{
	"\u\s[10]\0\s[7]こんな時間に新しいお仕事？\w9\n%(username)、正気ですの？\w8\1夜更けの思いつきは、\w9\n朝に見直すのがよろしいかと。\e"
	'\u\s[10]\0\s[3]‥\w5‥\w5まだ始めますの？\w9\n夜もすっかり更けましてよ。\w8\1お夜食をお持ちいたします。\w8\0\s[7]\n\n甘やかさないでちょうだい。\e'
	'\u\s[10]\0\s[6]‥\w5‥\w5止めても聞かないのでしょうね。\w9\nせめて手短になさいな。\w8\1ホットミルクを温めてまいります。\e'
}

//---- 長考が夜更けに片付いた
CC.TalkDoneLate : nonoverlap
{
	'\u\s[10]\0\s[6]片付きましたわね。\w9\nでしたら、今夜はここまで。\w8\1寝室の支度は整っております。\e'
	"\u\s[10]\0\s[7]終わりましたわよ。\w9\n続きは明日になさい、%(username)。\w8\1お嬢様もお休みくださいませ。\w8\0\s[1]\n\n‥\w5‥\w5わ、わかっていますわ。\e"
	'\u\s[10]\0\s[25]よく頑張りましたこと。\w9\n確かめるのは、よく眠ってから\w9\nになさいな。\w8\1寝ぼけた目での確認は、\w9\n確認とは申しません。\e'
}

//---- 続けて作業しているので休憩を勧める
//  _argv[0] 何回目か（1 なら 2 時間目）/ _argv[1] 続けて作業している時間（時間）
CC.TalkBreak
{
	if _argv[0] <= 1 {
		"\u\s[10]\0\s[0]もう%(_argv[1])時間、働きづめですわよ。\w9\n一息お入れなさい。\w8\1%(tea)をお淹れいたしました。\e"
		"\u\s[10]\0\s[26]お茶の時間にいたしましょう。\w9\n%(_argv[1])時間も画面と\w9\nにらめっこでしてよ。\w8\1本日のお菓子は%(sweets)でございます。\e"
		'\u\s[10]\0\s[6]少し目をお休めなさいな。\w9\n遠くの景色を眺めるのがよくてよ。\w8\1何かあれば、お嬢様がベルでお呼びいたします。\e'
	}
	else {
		"\u\s[10]\0\s[3]%(_argv[1])時間ですわよ、%(username)。\w9\nさすがに働きすぎですわ。\w8\1お茶が冷めてしまいました。\w9\n淹れ直してまいります。\e"
		"\u\s[10]\0\s[3]‥\w5‥\w5まだ続けますの？\w9\nもう%(_argv[1])時間ですのに。\w8\1立って伸びをなさるだけでも\w9\n違うものでございます。\e"
		'\u\s[10]\0\s[7]休みなさいと申し上げましたわよね？\w8\1お聞き流しのご様子でございます。\w8\0\s[3]\n\n‥\w5‥\w5もう。\w9\n倒れても看病して差し上げませんわよ。\w8\1\n\nなさると存じます。\e'
	}
}

//---- 全部終わった
CC.TalkGone : nonoverlap
{
	'\u\s[10]\0\s[6]みな、終いですわね。\w8\1本日もお疲れさまでございました。\e'
	'\u\s[10]\0\s[25]静かになりましたこと。\w9\nあなたも少しお休みなさいな。\w8\1そういたしましょう。\e'
	'\u\s[10]\0\s[0]どなたもお帰りになりましたわ。\w8\1片付けてまいります。\e'
	'\u\s[10]\0\s[4]あら、みな閉じてしまいましたの。\w9\n少し寂しいですわね。\w8\1私がおります、お嬢様。\w8\0\s[1]\n\n‥\w5‥\w5当然ですわ。\e'
}
