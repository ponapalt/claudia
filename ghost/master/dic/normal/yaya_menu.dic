//******************************************************************************
// 悪役令嬢クローディア
// メニュー処理辞書
//******************************************************************************

//******************************************************************************
//メインメニューの展開
//
//AYATEMPLATE.MenuItemの使い方
//1つめの文字列＝選択肢に表示する文字列
//2つめの文字列＝選んだときに実行される関数名
//3つめの文字列＝改行する量　50%刻み　省略すると100%（＝\n）
//******************************************************************************

//******************************************************************************
//二段組みのメニューと情報バー
//
//バルーン（claudia/ の s0）は 9 行 × 全角 23 字しか入らないので、メインメニューと
//設定メニューは選択肢を左右 2 段に並べ、空いた行にメニューの下の情報バーを置く。
//
//MENU.Grid('表示する文字列|関数名', ...)
//  項目を左、右、左、右…の順に 1 行 2 つずつ並べる。空文字列の項目は飛ばすので、
//  条件つきの項目が出ないときも穴は空かない。配列を渡してもよい
//  最初の行の前には改行を入れない（前の改行は呼び出し側で書く）
//  左の段は空白で半角 22 字にそろえてから、\_l[180] で右の段の頭（全角 12 字目）へ送る
//  右の段は半角 20 字にそろえる。項目の頭に付く菱の印（\![*]）の幅のぶん、
//  22 字ではバルーンの右端（345px）を越えて折り返し、次の行の表示が崩れるため
//  右の段に回る項目の文字列は半角 20 字まで（長いと切られる）
//******************************************************************************
MENU.Grid
{
	_items = IARRAY
	_s     = ''
	_i     = 0

	foreach _argv ; _a {
		if STRLEN(_a) > 0 {
			_items ,= _a
		}
	}
	for _i = 0 ; _i < ARRAYSIZE(_items) ; _i++ {
		if _i % 2 == 0 {
			if _i > 0 {
				_s += '\n'
			}
			_s += MENU.Cell(_items[_i], 22)
		}
		else {
			_s += '\_l[180]' + MENU.Cell(_items[_i], 20)
		}
	}
	_s
}

//---- 二段組みの 1 項目。_argv[0] は「表示する文字列|関数名」、_argv[1] はそろえる幅（半角）
MENU.Cell
{
	_p = SPLIT(_argv[0], '|')
	'\![*]\q[' + AYATEMPLATE.EscapeText(SHIORI3FW.MakeJustText(_p[0], _argv[1])) + ',' + AYATEMPLATE.EscapeText(_p[1]) + ']'
}

//---- 情報バー。区切りの菱の次の行に、注記の色で 1 行（全角 23 字まで）
MENU.InfoBar
{
	'\f[align,center]―― ◇ ――\n\f[align,left]\f[color,107,78,61]' + _argv[0] + '\f[default]'
}

//---- メインメニューの情報バーの中身
//  「9月26日(土) 17:13  依頼 12件・稼働 2・待ち 1」
//  _argv は CC.Scan の結果。Claude Code が無い PC では日付と時刻だけ
MENU.MainInfo
{
	_t    = GETTIME
	_text = _t[1] + '月' + _t[2] + '日(' + SUBSTR('日月火水木金土', _t[3], 1) + ') ' + /
	        _t[4] + ':' + SUBSTR(TOSTR(100 + _t[5]), 1, 2)
	_wait = 0
	_r    = IARRAY

	if CC.HasSessionDir {
		foreach _argv ; _a {
			_r = SPLIT(_a, '|#|')
			if _r[0] == 'waiting' {
				_wait += 1
			}
		}
		_text += '  依頼 ' + CCS.Comma(CCS.TodayRequests) + '件・稼働 ' + _argc + '・待ち ' + _wait
	}
	_text
}

//---- Claude Code の様子の情報バーの中身。「17:48 現在　作業中 1・待ち 1・手すき 0」
//  _argv[0] 返事待ちの数 / _argv[1] 作業中の数 / _argv[2] 全部の数
MENU.CCInfo
{
	_t = GETTIME
	_t[4] + ':' + SUBSTR(TOSTR(100 + _t[5]), 1, 2) + ' 現在　作業中 ' + _argv[1] + /
	'・待ち ' + _argv[0] + '・手すき ' + (_argv[2] - _argv[0] - _argv[1])
}

//---- 設定メニューの情報バーの中身。「話す頻度：ふつう・呼び名：あなた」
MENU.ConfigInfo
{
	_freq = aitalkinterval + '秒ごと'

	case aitalkinterval {
		when 0 {
			_freq = '黙っていて'
		}
		when 15 {
			_freq = 'たくさん'
		}
		when 180 {
			_freq = 'ふつう'
		}
		when 300 {
			_freq = '控えめに'
		}
	}
	//---- 呼び名は長いと 1 行に入らないので、全角 8 字ほどで切る
	'話す頻度：' + _freq + '・呼び名：' + SHIORI3FW.MakeShortText(username, 16)
}

//------------------------------------------------------------------------------
//メインメニュー展開
//------------------------------------------------------------------------------
OpenMenu
{
	'\0\s[0]何かご用かしら？'
	"\0\s[26]%(username)、わたくしに何の用ですの？"
	'\0\s[0]手短にお願いしますわ。'
	'\0\s[26]あら、わたくしに相談事かしら？'
	'\0\s[7]また呼びましたの？\w9\n今度は何ですの。'
	"\0\s[0]%(username)、ご用件をどうぞ。"
	'\0\s[25]よろしくてよ、聞いて差し上げますわ。'
	'\0\s[6]‥\w5‥\w5お茶の最中ですのに。\w9\nまあ、よろしいわ。'
	'\u\s[10]\1お嬢様、お呼びでございます。\w8\0\s[0]わかっておりますわ。\w9\n何ですの？'
	--
	OPENMENU.Body
}

//---- メインメニューの選択肢と情報バー
//  セッションの一覧（CC.Scan）はファイルを読むので、選択肢と情報バーで 1 回の結果を使う
OPENMENU.Body
{
	_list  = CC.Scan
	_items = IARRAY

	_items ,= '何か話して|Menu_AITALK'
	if STRLEN(AYATEMPLATE.LastTalk) > 0 {
		_items ,= 'さっきの話は？|Menu_LASTTALK'
	}
	_items ,= '話しかける|Menu_COMMUNICATEOPEN'
	_items ,= 'ゴーストと話す|Menu_GHOSTCOMSTART'
	_items ,= 'これまでの功績|Menu_CCSTATS'
	//---- Claude Code が動いているときだけ見せる
	if ARRAYSIZE(_list) > 0 {
		_items ,= 'Claude Code は？|Menu_CLAUDECODE'
	}
	_items ,= '設定|Menu_CONFIG'
	_items ,= 'なんでもない|Menu_CANCEL'

	//---- 挨拶のあと、選択肢から情報バーまでは \_q で一度に出す
	'\n\n[half]\_q' + MENU.Grid(_items) + '\n' + MENU.InfoBar(MENU.MainInfo(_list)) + '\_q'
}

//------------------------------------------------------------------------------
//メニュー選択タイムアウト
//------------------------------------------------------------------------------
OnChoiceTimeout
{
	'\0\s[7]早くお選びなさい。\w9\n令嬢を待たせるものではありませんわ。\e'
	'\0\s[4]‥\w5‥\w5呼んでおいて、だんまりですの？\w8\1お嬢様、そういう日もございます。\e'
}


//******************************************************************************
//各項目の処理内容
//******************************************************************************

//---- 何か話して
Menu_AITALK
{
	//---- 明示的にAIトーク開始を指示
	OnAiTalk
}

//---- さっきの話は
Menu_LASTTALK
{
	AYATEMPLATE.LastTalk
}

//---- トーク頻度の調整
Menu_TALKINTERVAL
{
	'\0\s[0]どのくらい話して差し上げればよろしいの？'
	--
	'\n\n[half]\_q'
	--
	MENU.Grid('たくさん|Menu_TALKMAX', 'ふつう|Menu_TALKNORMAL', '控えめに|Menu_TALKPOOR', '黙っていて|Menu_TALKNONE')
	--
	'\n\n[half]'
	--
	MENU.Grid('戻る|Menu_CONFIG')
	--
	'\n'
	--
	MENU.InfoBar(MENU.ConfigInfo) + '\_q'
}

//---- 設定
//  ccbelloff   1 なら、Claude Code が返事を待ち始めたときのベルを鳴らさない
//  ccdoneoff   1 なら、長くかかった作業が終わったときの完了音を鳴らさない
//  ccremindoff 1 なら、返事待ちを放っておかれたときの 5 分ごとのリマインダを出さない
//  ccbreakoff  1 なら、続けて 2 時間作業したときの休憩のすすめを出さない
//  どれも初めは空（鳴らす、出す）
Menu_CONFIG
{
	_bell   = '鳴らす'
	_done   = '鳴らす'
	_remind = '出す'
	_break  = '出す'

	if ccbelloff == 1 {
		_bell = '鳴らさない'
	}
	if ccdoneoff == 1 {
		_done = '鳴らさない'
	}
	if ccremindoff == 1 {
		_remind = '出さない'
	}
	if ccbreakoff == 1 {
		_break = '出さない'
	}
	'\0\s[0]何を変えたいのかしら？'
	--
	'\n\n[half]\_q'
	--
	MENU.Grid('頻度を変えて|Menu_TALKINTERVAL', '呼び方を変えて|Menu_USERNAME')
	--
	//---- 組の見出しは選択肢より目立たせず、半行の間と薄墨の文字だけで区切る
	'\n\n[half]\f[color,107,78,61]Claude Code\f[default]\n'
	--
	//---- 「休憩のすすめ：出さない」は半角 22 字あり、右の段に入らないので左に置く
	MENU.Grid("ベル：%(_bell)|Menu_CCBELL", "完了音：%(_done)|Menu_CCDONE", /
	          "休憩のすすめ：%(_break)|Menu_CCBREAK", "リマインダ：%(_remind)|Menu_CCREMIND")
	--
	'\n\n[half]'
	--
	MENU.Grid('戻る|OpenMenu', '設定終了|Menu_CONFIGEND')
	--
	'\n'
	--
	MENU.InfoBar(MENU.ConfigInfo) + '\_q'
}

//---- 設定を切り替えたあとの台詞に付ける選択肢
//  台詞がアンソニーで終わっても、選択肢はクローディアのバルーンに出す
CONFIG.AfterItems
{
	'\0\n\n[half]\_q'
	--
	MENU.Grid('戻る|Menu_CONFIG', '設定終了|Menu_CONFIGEND') + '\_q'
}

//---- 設定終了
Menu_CONFIGEND
{
	'\0\s[0]設定はこれでおしまいですわね。\e'
	'\u\s[10]\0\s[26]ではこのとおりに。\w8\1承りました。\e'
	'\0\s[25]これで過ごしやすくなりましたでしょう？\e'
	'\u\s[10]\0\s[0]設定、承りましたわ。\w8\1控えておきます。\e'
	'\0\s[26]わたくしの采配に抜かりはなくてよ。\e'
	'\u\s[10]\0\s[6]気が変わったら、\w9\nまたいつでも仰いなさい。\w8\1お待ちしております。\e'
	'\u\s[10]\1以上でよろしゅうございますか。\w8\0\s[0]ええ、これで結構ですわ。\e'
}

//---- 名前の呼び方を変える
//  入力欄の ID が On で始まるので、決定すると OnInputUserName が呼ばれる（reference[0] が入力）
//  今の呼び方を入力欄に入れておく。ただしタグを壊す文字が入っているときは空にする
Menu_USERNAME
{
	_text = username

	if SHIORI3FW.EscapeAllTags(_text) != _text || ',' _in_ _text || ']' _in_ _text {
		_text = ''
	}
	"\0\s[0]あなたのこと、\w9\nなんとお呼びすればよろしいの？\![open,inputbox,OnInputUserName,0,%(_text)]\e"
}

OnInputUserName
{
	_name = reference[0]

	if STRLEN(_name) == 0 {
		'\0\s[4]空欄では、お呼びできませんわ。'
	}
	elseif SHIORI3FW.EscapeAllTags(_name) != _name {
		'\0\s[7]おかしな記号はおやめなさい。'
	}
	else {
		username = _name
		"\0\s[25]%(username)、ですわね。\w9\n覚えて差し上げましたわ。"
	}
	--
	CONFIG.AfterItems
}

//---- 入力欄が閉じられた（閉じるボタン、またはタイムアウト）
OnUserInputCancel
{
	if reference[0] == 'OnInputFirstUserName' {
		//---- 初回起動で名前を聞いたのに閉じられた（yaya_bootend.dic）
		return FirstBoot.NoName
	}
	if reference[0] != 'OnInputUserName' {
		return ''
	}
	'\0\s[6]では、今までどおりにお呼びしますわ。'
	--
	CONFIG.AfterItems
}

//---- 呼び出しのベルの切り替え
Menu_CCBELL
{
	if ccbelloff == 1 {
		ccbelloff = 0
		'\![sound,play,cc_bell2.wav]\u\s[10]\0\s[26]では、お呼びがかかったら\w9\nベルを鳴らしますわ。\w8\1この音でございます。'
	}
	else {
		ccbelloff = 1
		'\u\s[10]\0\s[0]ベルは鳴らさないでおきますわ。\w9\n声だけでお知らせしますわね。\w8\1承知いたしました。'
	}
	--
	CONFIG.AfterItems
}

//---- 完了音の切り替え
Menu_CCDONE
{
	if ccdoneoff == 1 {
		ccdoneoff = 0
		'\![sound,play,cc_done.wav]\u\s[10]\0\s[25]長いお仕事が片付いたら、\w9\nそっとお知らせしますわ。\w8\1この音でございます。'
	}
	else {
		ccdoneoff = 1
		'\u\s[10]\0\s[0]終わったときの音は\w9\n鳴らさないでおきますわ。\w8\1承知いたしました。'
	}
	--
	CONFIG.AfterItems
}

//---- 5 分ごとのリマインダの切り替え
Menu_CCREMIND
{
	if ccremindoff == 1 {
		ccremindoff = 0
		'\u\s[10]\0\s[7]放っておいたら、5分ごとに\w9\n3回まで呼んで差し上げますわ。\w8\1お忘れになりませんように。'
	}
	else {
		ccremindoff = 1
		ccremindat  = 0
		'\u\s[10]\0\s[6]一度お知らせしたら、\w9\nあとは黙って待ちますわ。\w8\1辛抱強くございますね。'
	}
	--
	CONFIG.AfterItems
}

//---- 続けて 2 時間作業したときの休憩のすすめの切り替え
Menu_CCBREAK
{
	if ccbreakoff == 1 {
		ccbreakoff = 0
		'\u\s[10]\0\s[0]2時間働きづめでしたら、\w9\nお茶に誘って差し上げますわ。\w8\1お湯を沸かしておきます。'
	}
	else {
		ccbreakoff = 1
		'\u\s[10]\0\s[4]‥\w5‥\w5休憩は、ご自分で\w9\nお取りなさいな。\w8\1お茶はいつでもご用意できます。'
	}
	--
	CONFIG.AfterItems
}

//---- クローディアに話しかける
Menu_COMMUNICATEOPEN
{
	'\0\s[0]何ですの？\![open,communicatebox]\e'
}

//---- 他のゴーストと話す
Menu_GHOSTCOMSTART
{
	StartCommunicate
}

//---- Claude Code の様子（起動中のセッション一覧）
//  セッションの一覧（CC.Scan）はファイルを読むので、一覧と情報バーで 1 回の結果を使う
Menu_CLAUDECODE
{
	_list = CC.Scan
	_n    = ARRAYSIZE(_list)
	_wait = 0
	_busy = 0
	_r    = IARRAY

	if _n == 0 {
		return '\0\s[4]もう誰も働いておりませんわ。\e'
	}
	foreach _list ; _a {
		_r = SPLIT(_a, '|#|')
		if _r[0] == 'waiting' {
			_wait += 1
		}
		elseif _r[0] == 'busy' {
			_busy += 1
		}
	}
	//---- 一覧は長くなるので大きいバルーン（\b[2]）で出す。一覧は \_q で一度に出し、
	//     アンソニーのひとことのあと、選択肢から情報バーまでを \_q で一度に出す
	//---- 本文には記録から拾った文字が入るので、%() で展開せずにつなぐ
	_talk  = '\u\s[10]\0\s[26]\b[2]ご覧なさい。\w9\n今、これだけ動いておりましてよ。\w8\n\n[half]'
	_talk += '\_q' + CC.ListBody(_list) + '\_q'
	_talk += '\w8\1' + CC.ListButler(_wait, _busy, _n) + '\w8\0\n\n[half]'
	_talk += '\_q' + MENU.Grid('もう一度見る|Menu_CLAUDECODE', '見張りを立て直す|Menu_CCWATCH', '戻る|OpenMenu')
	_talk += '\n' + MENU.InfoBar(MENU.CCInfo(_wait, _busy, _n)) + '\_q'
	_talk
}

//---- 功績録（yaya_ccstats.dic）。メニューから開くと 1 頁目を出し、回数を数える
Menu_CCSTATS
{
	CCS.Record
	--
	CCSTATS.AfterItems
}

//---- 功績録の頁の切り替え（頁の上端の見出しから）
Menu_CCPAGE1
{
	CCS.Record(1)
	--
	CCSTATS.AfterItems
}

Menu_CCPAGE2
{
	CCS.Record(2)
	--
	CCSTATS.AfterItems
}

Menu_CCPAGE3
{
	CCS.Record(3)
	--
	CCSTATS.AfterItems
}

Menu_CCPAGE4
{
	CCS.Record(4)
	--
	CCSTATS.AfterItems
}

Menu_CCPAGE5
{
	CCS.Record(5)
	--
	CCSTATS.AfterItems
}

//---- 功績録の各頁の下に付ける選択肢
//  最後はアンソニーが話しているので、選択肢はクローディアのバルーンに出す
//  Claude Code が無い PC では、業務報告は出さない（CCS.NoClaude）
CCSTATS.AfterItems
{
	'\w8\0\n'
	--
	if !CCS.NoClaude {
		AYATEMPLATE.MenuItem("本日の業務報告は？","Menu_CCTODAY")
	}
	--
	AYATEMPLATE.MenuItem("戻る","OpenMenu")
	--
	AYATEMPLATE.MenuItem("閉じる","Menu_CCCLOSE")
}

//---- 本日の業務報告（yaya_ccstats.dic）
Menu_CCTODAY
{
	CCS.Today.Report
	--
	'\w8\0\n'
	--
	AYATEMPLATE.MenuItem("これまでの功績は？","Menu_CCSTATS")
	--
	AYATEMPLATE.MenuItem("戻る","OpenMenu")
	--
	AYATEMPLATE.MenuItem("閉じる","Menu_CCCLOSE")
}

//---- 功績録と業務報告を閉じる
Menu_CCCLOSE
{
	'\0\s[26]よろしくてよ。\w9\nこれからも励みなさいな。\e'
	'\0\s[0]記録はわたくしどもが\w9\nつけておきますわ。\e'
}

//---- filewatch を登録し直す（辞書を読み込み直したあとなど）
Menu_CCWATCH
{
	if !CC.HasSessionDir {
		'\u\s[10]\0\s[4]Claude Code のセッションの置き場所が\w9\n見当たりませんわ。\w8\1まだお入れでないのかと。\e'
	}
	else {
		CC.Start
		--
		CC.TrayIconSync
		--
		'\0\s[0]見張りを立て直しましたわ。\w8\1つつがなく。\e'
	}
}

//---- キャンセルされた
Menu_CANCEL
{
	'\0\s[7]‥\w5‥\w5なら、呼ばないでくださる？\e'
	'\0\s[6]そう。\w9\nでは、またの機会に。\e'
}

//---- トーク頻度
Menu_TALKMAX
{
	//---- たくさん話す(15秒間隔)
	aitalkinterval = 15
	'\0\s[5]よろしくてよ。\w9\nわたくしの話を存分にお聞きなさい！\w8\1お仕事の手は止めませんように。'
	--
	CONFIG.AfterItems
}

Menu_TALKNORMAL
{
	//---- ふつうに話す(3分間隔)
	aitalkinterval = 180
	'\0\s[0]では、三分に一度くらいにしておきますわ。'
	--
	CONFIG.AfterItems
}

Menu_TALKPOOR
{
	//---- 控えめに話す(5分間隔)
	aitalkinterval = 300
	'\0\s[6]控えめに、ですわね。\w9\n淑女らしく振る舞いますわ。\w8\1普段からそうなさってください。'
	--
	CONFIG.AfterItems
}

Menu_TALKNONE
{
	//---- 話さない
	aitalkinterval = 0
	'\0\s[4]‥\w5‥\w5わかりましたわ。\w9\n用があるときだけ呼びなさい。\w8\1お嬢様、少し寂しそうでございますね。\w8\0\s[7]\n\n気のせいですわ！'
	--
	CONFIG.AfterItems
}

//---- ヘッドライン
Menu_HEADLINECANCEL
{
	//---- キャンセルされた
	'\0\s[0]そう、ではここまでにしますわ。\e'
}
