//******************************************************************************
// 悪役令嬢クローディア
// メニュー処理辞書
//******************************************************************************

//******************************************************************************
//メインメニューの展開
//
//AYATEMPLATE.MenuItemの使い方
//1つめの文字列＝選択肢に表示する文字列
//2つめの文字列＝選んだときに実行される関数名
//3つめの文字列＝改行する量　50%刻み　省略すると100%（＝\n）
//******************************************************************************

//******************************************************************************
//二段組みのメニューと情報バー
//
//バルーン（claudia/ の s0）は 9 行 × 全角 23 字しか入らないので、メインメニューと
//設定メニューは選択肢を左右 2 段に並べ、空いた行にメニューの下の情報バーを置く。
//
//MENU.Grid('表示する文字列|関数名', ...)
//  項目を左、右、左、右…の順に 1 行 2 つずつ並べる。空文字列の項目は飛ばすので、
//  条件つきの項目が出ないときも穴は空かない。配列を渡してもよい
//  最初の行の前には改行を入れない（前の改行は呼び出し側で書く）
//  左の段は空白で半角 22 字にそろえてから、\_l[180] で右の段の頭（全角 12 字目）へ送る
//  右の段は半角 20 字にそろえる。項目の頭に付く菱の印（\![*]）の幅のぶん、
//  22 字ではバルーンの右端（345px）を越えて折り返し、次の行の表示が崩れるため
//  右の段に回る項目の文字列は半角 20 字まで（長いと切られる）
//  項目に '-' だけを渡すと、選べない空欄として 1 つぶんの場所を取る（出たり出な
//  かったりする項目の場所を空けておいて、ほかの項目が動かないようにする）
//******************************************************************************
MENU.Grid
{
	_items = IARRAY
	_s     = ''
	_i     = 0

	foreach _argv ; _a {
		if STRLEN(_a) > 0 {
			_items ,= _a
		}
	}
	for _i = 0 ; _i < ARRAYSIZE(_items) ; _i++ {
		if _i % 2 == 0 {
			if _i > 0 {
				_s += '\n'
			}
			_s += MENU.Cell(_items[_i], 22)
		}
		else {
			_s += '\_l[180]' + MENU.Cell(_items[_i], 20)
		}
	}
	_s
}

//---- 二段組みの 1 項目。_argv[0] は「表示する文字列|関数名」、_argv[1] はそろえる幅（半角）
//  「表示する文字列|関数名|引数|‥‥」と書くと、引数を \q の 3 番目以降に付ける
//  （OnChoiceSelectEx の reference[2] 以降に入る。yaya_teatimer.dic）
//  '-' は空欄（何も出さない。右の段は \_l[180] が位置を決めるので、左が空でもずれない）
MENU.Cell
{
	if _argv[0] == '-' {
		return ''
	}
	_p  = SPLIT(_argv[0], '|')
	_id = AYATEMPLATE.EscapeText(_p[1])
	_i  = 0

	for _i = 2 ; _i < ARRAYSIZE(_p) ; _i++ {
		_id += ',' + AYATEMPLATE.EscapeText(_p[_i])
	}
	'\![*]\q[' + AYATEMPLATE.EscapeText(SHIORI3FW.MakeJustText(_p[0], _argv[1])) + ',' + _id + ']'
}

//---- 情報バー。区切りの菱の次の行に、注記の色で 1 行（全角 23 字まで）
MENU.InfoBar
{
	'\f[align,center]―― ◇ ――\n\f[align,left]\f[color,107,78,61]' + _argv[0] + '\f[default]'
}

//---- メインメニューの情報バーの中身
//  「9月26日(土) 17:13  依頼 12件・稼働 2・待ち 1」
//  _argv は CC.Scan の結果（セッションのハッシュ）。Claude Code が無い PC では日付と時刻だけ
MENU.MainInfo
{
	_t    = GETTIME
	_text = _t[1] + '月' + _t[2] + '日(' + SUBSTR('日月火水木金土', _t[3], 1) + ') ' + /
	        _t[4] + ':' + SUBSTR(TOSTR(100 + _t[5]), 1, 2)
	_wait = 0
	_s    = IHASH()

	if CC.HasSessionDir {
		foreach _argv ; _s {
			if _s['status'] == 'waiting' {
				_wait += 1
			}
		}
		_text += '  依頼 ' + CCS.Comma(CCS.TodayRequests) + '件・稼働 ' + _argc + '・待ち ' + _wait
	}
	_text
}

//---- Claude Code の様子の情報バーの中身。「17:48 現在　作業中 1・待ち 1・手すき 0」
//  _argv[0] 返事待ちの数 / _argv[1] 作業中の数 / _argv[2] 全部の数
MENU.CCInfo
{
	_t = GETTIME
	_t[4] + ':' + SUBSTR(TOSTR(100 + _t[5]), 1, 2) + ' 現在　作業中 ' + _argv[1] + /
	'・待ち ' + _argv[0] + '・手すき ' + (_argv[2] - _argv[0] - _argv[1])
}

//---- Claude Code の履歴の頁の情報バーの中身。「17:48 現在　履歴 492件・1/82頁」
//  _argv[0] 続きを開ける履歴の数 / _argv[1] 今の頁 / _argv[2] 頁の数
MENU.HistInfo
{
	_t = GETTIME
	_t[4] + ':' + SUBSTR(TOSTR(100 + _t[5]), 1, 2) + ' 現在　履歴 ' + CCS.Comma(_argv[0]) + '件・' + _argv[1] + '/' + _argv[2] + '頁'
}

//---- Claude Code の新規の頁の情報バーの中身。「17:48 現在　フォルダ 12件・1/2頁」
//  _argv[0] 並べるフォルダの数 / _argv[1] 今の頁 / _argv[2] 頁の数
MENU.NewInfo
{
	_t = GETTIME
	_t[4] + ':' + SUBSTR(TOSTR(100 + _t[5]), 1, 2) + ' 現在　フォルダ ' + _argv[0] + '件・' + _argv[1] + '/' + _argv[2] + '頁'
}

//---- Claude Code のお知らせの頁の情報バーの中身。「17:48 現在　鈴：有効」
//  _argv[0] CCH.PluginState の結果
MENU.HookInfo
{
	_t    = GETTIME
	_name = '未導入'

	case _argv[0] {
		when 'on' {
			_name = '有効'
		}
		when 'off' {
			_name = '停止中'
		}
		when 'elsewhere' {
			_name = '別の場所から'
		}
	}
	_t[4] + ':' + SUBSTR(TOSTR(100 + _t[5]), 1, 2) + ' 現在　鈴：' + _name
}

//---- 設定メニューの情報バーの中身。「話す頻度：ふつう・呼び名：あなた」
MENU.ConfigInfo
{
	_freq = aitalkinterval + '秒ごと'

	case aitalkinterval {
		when 0 {
			_freq = '黙っていて'
		}
		when 15 {
			_freq = 'たくさん'
		}
		when 180 {
			_freq = 'ふつう'
		}
		when 300 {
			_freq = '控えめに'
		}
	}
	//---- 呼び名は長いと 1 行に入らないので、全角 8 字ほどで切る
	'話す頻度：' + _freq + '・呼び名：' + SHIORI3FW.MakeShortText(username, 16)
}

//------------------------------------------------------------------------------
//メインメニュー展開
//------------------------------------------------------------------------------
OpenMenu
{
	'\0\s[0]何かご用かしら？'
	"\0\s[26]%(username)、わたくしに何の用ですの？"
	'\0\s[0]手短にお願いしますわ。'
	'\0\s[26]あら、わたくしに相談事かしら？'
	'\0\s[7]また呼びましたの？\w9\n今度は何ですの。'
	"\0\s[0]%(username)、ご用件をどうぞ。"
	'\0\s[25]よろしくてよ、聞いて差し上げますわ。'
	'\0\s[6]‥\w5‥\w5お茶の最中ですのに。\w9\nまあ、よろしいわ。'
	'\u\s[10]\1お嬢様、お呼びでございます。\w8\0\s[0]わかっておりますわ。\w9\n何ですの？'
	--
	OPENMENU.Body
}

//---- メインメニューの選択肢と情報バー
//  セッションの一覧（CC.Scan）はファイルを読むので、選択肢と情報バーで 1 回の結果を使う
OPENMENU.Body
{
	_list  = CC.Scan
	_items = IARRAY

	_items ,= '何か話して|Menu_AITALK'
	//---- 話がまだ無いときも右の段を空欄で送り、ほかの項目の位置を動かさない
	if STRLEN(AYATEMPLATE.LastTalk) > 0 {
		_items ,= 'さっきの話は？|Menu_LASTTALK'
	}
	else {
		_items ,= '-'
	}
	_items ,= '話しかける|Menu_COMMUNICATEOPEN'
	_items ,= 'ゴーストと話す|Menu_GHOSTCOMSTART'
	//---- Claude Code まわりを「Claude Code は？」「功績録」「タイマー」の順に並べる
	//  Claude Code を使っている PC なら、動いていなくても見せる（実行中と履歴）。
	//  使っていない PC では左の段を空欄にして、功績録以降の位置を動かさない
	if !CCS.NoClaude {
		_items ,= 'Claude Code は？|Menu_CLAUDECODE'
	}
	else {
		_items ,= '-'
	}
	_items ,= '功績録と業務報告|Menu_CCSTATS'
	_items ,= 'お茶とタイマー|Menu_TIMER'
	_items ,= '設定|Menu_CONFIG'
	_items ,= 'なんでもない|Menu_CANCEL'

	//---- 挨拶のあと、選択肢から情報バーまでは \_q で一度に出す
	'\n\n[half]\_q' + MENU.Grid(_items) + '\n' + MENU.InfoBar(MENU.MainInfo(_list)) + '\_q'
}

//------------------------------------------------------------------------------
//メニュー選択タイムアウト
//------------------------------------------------------------------------------
OnChoiceTimeout
{
	'\0\s[7]早くお選びなさい。\w9\n令嬢を待たせるものではありませんわ。\e'
	'\0\s[3]‥\w5‥\w5呼んでおいて、だんまりですの？\w8\1お嬢様、そういう日もございます。\e'
}


//******************************************************************************
//各項目の処理内容
//******************************************************************************

//---- 何か話して
Menu_AITALK
{
	//---- 明示的にAIトーク開始を指示
	OnAiTalk
}

//---- さっきの話は
Menu_LASTTALK
{
	AYATEMPLATE.LastTalk
}

//---- トーク頻度の調整
Menu_TALKINTERVAL
{
	'\0\s[0]どのくらい話して差し上げればよろしいの？'
	--
	'\n\n[half]\_q'
	--
	MENU.Grid('たくさん|Menu_TALKMAX', 'ふつう|Menu_TALKNORMAL', '控えめに|Menu_TALKPOOR', '黙っていて|Menu_TALKNONE')
	--
	'\n\n[half]'
	--
	MENU.Grid('戻る|Menu_CONFIG')
	--
	'\n'
	--
	MENU.InfoBar(MENU.ConfigInfo) + '\_q'
}

//---- 設定
//  ccbelloff   1 なら、Claude Code が返事を待ち始めたときのベルを鳴らさない
//  ccdoneoff   1 なら、長くかかった作業が終わったときの完了音を鳴らさない
//  ccremindoff 1 なら、返事待ちを放っておかれたときの 5 分ごとのリマインダを出さない
//  ccbreakoff  1 なら、続けて 2 時間作業したときの休憩のすすめを出さない
//  どれも初めは空（鳴らす、出す）
Menu_CONFIG
{
	_bell   = '鳴らす'
	_done   = '鳴らす'
	_remind = '出す'
	_break  = '出す'

	if ccbelloff == 1 {
		_bell = '鳴らさない'
	}
	if ccdoneoff == 1 {
		_done = '鳴らさない'
	}
	if ccremindoff == 1 {
		_remind = '出さない'
	}
	if ccbreakoff == 1 {
		_break = '出さない'
	}
	'\0\s[0]何を変えたいのかしら？'
	--
	'\n\n[half]\_q'
	--
	MENU.Grid('頻度を変えて|Menu_TALKINTERVAL', '呼び方を変えて|Menu_USERNAME')
	--
	//---- 組の見出しは選択肢より目立たせず、半行の間と薄墨の文字だけで区切る
	'\n\n[half]\f[color,107,78,61]Claude Code\f[default]\n'
	--
	//---- 「休憩のすすめ：出さない」は半角 22 字あり、右の段に入らないので左に置く
	MENU.Grid("ベル：%(_bell)|Menu_CCBELL", "完了音：%(_done)|Menu_CCDONE", /
	          "休憩のすすめ：%(_break)|Menu_CCBREAK", "リマインダ：%(_remind)|Menu_CCREMIND")
	--
	'\n\n[half]'
	--
	MENU.Grid('戻る|OpenMenu', '設定終了|Menu_CONFIGEND')
	--
	'\n'
	--
	MENU.InfoBar(MENU.ConfigInfo) + '\_q'
}

//---- 設定を切り替えたあとの台詞に付ける選択肢
//  台詞がアンソニーで終わっても、選択肢はクローディアのバルーンに出す
CONFIG.AfterItems
{
	'\0\n\n[half]\_q'
	--
	MENU.Grid('戻る|Menu_CONFIG', '設定終了|Menu_CONFIGEND') + '\_q'
}

//---- 設定終了
Menu_CONFIGEND
{
	'\0\s[0]設定はこれでおしまいですわね。\e'
	'\u\s[10]\0\s[26]ではこのとおりに。\w8\1承りました。\e'
	'\0\s[25]これで過ごしやすくなりましたでしょう？\e'
	'\u\s[10]\0\s[0]設定、承りましたわ。\w8\1控えておきます。\e'
	'\0\s[26]わたくしの采配に抜かりはなくてよ。\e'
	'\u\s[10]\0\s[6]気が変わったら、\w9\nまたいつでも仰いなさい。\w8\1お待ちしております。\e'
	'\u\s[10]\1以上でよろしゅうございますか。\w8\0\s[0]ええ、これで結構ですわ。\e'
}

//---- 名前の呼び方を変える
//  入力欄の ID が On で始まるので、決定すると OnInputUserName が呼ばれる（reference[0] が入力）
//  今の呼び方を入力欄に入れておく。ただしタグを壊す文字が入っているときは空にする
Menu_USERNAME
{
	_text = username

	if SHIORI3FW.EscapeAllTags(_text) != _text || ',' _in_ _text || ']' _in_ _text {
		_text = ''
	}
	"\0\s[0]あなたのこと、\w9\nなんとお呼びすればよろしいの？\![open,inputbox,OnInputUserName,0,%(_text)]\e"
}

OnInputUserName
{
	_name = reference[0]

	if STRLEN(_name) == 0 {
		'\0\s[3]空欄では、お呼びできませんわ。'
	}
	elseif SHIORI3FW.EscapeAllTags(_name) != _name {
		'\0\s[7]おかしな記号はおやめなさい。'
	}
	else {
		username = _name
		"\0\s[25]%(username)、ですわね。\w9\n覚えて差し上げましたわ。"
	}
	--
	CONFIG.AfterItems
}

//---- 入力欄が閉じられた（閉じるボタン、またはタイムアウト）
OnUserInputCancel
{
	if reference[0] == 'OnInputFirstUserName' {
		//---- 初回起動で名前を聞いたのに閉じられた（yaya_bootend.dic）
		return FirstBoot.NoName
	}
	if reference[0] == 'OnInputTimerMinutes' {
		//---- タイマーの分数を聞いたのに閉じられた（yaya_teatimer.dic）
		return '\u\s[10]\0\s[0]\1では、砂時計はしまっておきます。' + TM.AfterItems
	}
	if reference[0] == 'OnInputCCSFrom' || reference[0] == 'OnInputCCSTo' {
		//---- 業務報告の期間を聞いたのに閉じられた。今の期間の報告に戻る
		return Menu_CCPAGE1
	}
	if reference[0] != 'OnInputUserName' {
		return ''
	}
	'\0\s[6]では、今までどおりにお呼びしますわ。'
	--
	CONFIG.AfterItems
}

//---- 呼び出しのベルの切り替え
Menu_CCBELL
{
	if ccbelloff == 1 {
		ccbelloff = 0
		'\![sound,play,cc_bell2.wav]\u\s[10]\0\s[26]では、お呼びがかかったら\w9\nベルを鳴らしますわ。\w8\1この音でございます。'
	}
	else {
		ccbelloff = 1
		'\u\s[10]\0\s[0]ベルは鳴らさないでおきますわ。\w9\n声だけでお知らせしますわね。\w8\1承知いたしました。'
	}
	--
	CONFIG.AfterItems
}

//---- 完了音の切り替え
Menu_CCDONE
{
	if ccdoneoff == 1 {
		ccdoneoff = 0
		'\![sound,play,cc_done.wav]\u\s[10]\0\s[25]長いお仕事が片付いたら、\w9\nそっとお知らせしますわ。\w8\1この音でございます。'
	}
	else {
		ccdoneoff = 1
		'\u\s[10]\0\s[0]終わったときの音は\w9\n鳴らさないでおきますわ。\w8\1承知いたしました。'
	}
	--
	CONFIG.AfterItems
}

//---- 5 分ごとのリマインダの切り替え
Menu_CCREMIND
{
	if ccremindoff == 1 {
		ccremindoff = 0
		'\u\s[10]\0\s[7]放っておいたら、5分ごとに\w9\n3回まで呼んで差し上げますわ。\w8\1お忘れになりませんように。'
	}
	else {
		ccremindoff = 1
		ccremindat  = 0
		'\u\s[10]\0\s[6]一度お知らせしたら、\w9\nあとは黙って待ちますわ。\w8\1辛抱強くございますね。'
	}
	--
	CONFIG.AfterItems
}

//---- 続けて 2 時間作業したときの休憩のすすめの切り替え
Menu_CCBREAK
{
	if ccbreakoff == 1 {
		ccbreakoff = 0
		'\u\s[10]\0\s[0]2時間働きづめでしたら、\w9\nお茶に誘って差し上げますわ。\w8\1お湯を沸かしておきます。'
	}
	else {
		ccbreakoff = 1
		'\u\s[10]\0\s[4]‥\w5‥\w5休憩は、ご自分で\w9\nお取りなさいな。\w8\1お茶はいつでもご用意できます。'
	}
	--
	CONFIG.AfterItems
}

//---- クローディアに話しかける
Menu_COMMUNICATEOPEN
{
	'\0\s[0]何ですの？\![open,communicatebox]\e'
}

//---- 他のゴーストと話す
Menu_GHOSTCOMSTART
{
	StartCommunicate
}

//---- 見出しで切り替える頁（Claude Code は？ と功績録）は、掛け合いも含めて全体を \_q で囲み、
//     \w の間を取らずに一度に出す（CC.Quick）。切り替えを速くするため

//---- Claude Code は？（実行中・作業履歴・新規起動の 3 頁。見出しから切り替える。yaya_claudecode.dic）
//  実行中: 起動中のセッションの一覧。動いていなければ空欄のひとこと
Menu_CLAUDECODE
{
	CC.Quick(CC.PageRun)
}

//---- 履歴: これまでのセッションから選んで、続きを端末で開く
Menu_CCHIST
{
	CC.Quick(CC.PageHist(1))
}

//---- 履歴の頁送り（\q の 3 番目の引数が頁の番号）
OnCCHistPage
{
	CC.Quick(CC.PageHist(TOINT(reference[0])))
}

//---- 履歴から選んだセッションを開く（reference[0] が sessionId）
OnCCResume
{
	CC.Resume(reference[0])
}

//---- 新規起動: これまでに使った作業フォルダから選んで、そこで claude を新しく始める
Menu_CCNEW
{
	CC.Quick(CC.PageNew(1))
}

//---- 新規の頁送り（\q の 3 番目の引数が頁の番号）
OnCCNewPage
{
	CC.Quick(CC.PageNew(TOINT(reference[0])))
}

//---- 新規の頁から選んだフォルダで claude を起動する（reference[0] が、そのフォルダの sessionId）
OnCCNew
{
	CC.NewSession(reference[0])
}

//---- お知らせ: Claude Code のプラグイン（鈴）の状態と、付け外し（yaya_cchook.dic）
Menu_CCHOOK
{
	CC.Quick(CCH.Page)
}

//---- 付ける・外す前の確かめ（reference[0] が install / remove、reference[1] が合言葉）
OnCCHookAsk
{
	CCH.Ask(reference[0], reference[1])
}

//---- claude plugin ... を走らせる（reference[0] が install / remove / on / off、reference[1] が合言葉）
OnCCHookRun
{
	CCH.Run(reference[0], reference[1])
}

//---- 手続きが終わった（CCH.Run が見張る印のファイルが書き換わった）
OnCCHookDone
{
	CCH.Done
}

OnCCHookDoneFailure
{
	CCH.DoneFailure
}

//---- 功績録（yaya_ccstats.dic）。メニューから開くと本日の業務報告（1 頁目）を出し、回数を数える
Menu_CCSTATS
{
	CC.Quick(CCS.Record + CCSTATS.AfterItems)
}

//---- 功績録の頁の切り替え（頁の上端の見出しから）
Menu_CCPAGE1
{
	CC.Quick(CCS.Record(1) + CCSTATS.AfterItems)
}

Menu_CCPAGE2
{
	CC.Quick(CCS.Record(2) + CCSTATS.AfterItems)
}

Menu_CCPAGE3
{
	CC.Quick(CCS.Record(3) + CCSTATS.AfterItems)
}

Menu_CCPAGE4
{
	CC.Quick(CCS.Record(4) + CCSTATS.AfterItems)
}

Menu_CCPAGE5
{
	CC.Quick(CCS.Record(5) + CCSTATS.AfterItems)
}

Menu_CCPAGE6
{
	CC.Quick(CCS.Record(6) + CCSTATS.AfterItems)
}

//---- 功績録の各頁の下に付ける選択肢
//  最後はアンソニーが話しているので、選択肢はクローディアのバルーンに出す
CCSTATS.AfterItems
{
	'\0\n'
	--
	AYATEMPLATE.MenuItem("戻る","OpenMenu")
	--
	AYATEMPLATE.MenuItem("閉じる","Menu_CCCLOSE")
}

//------------------------------------------------------------------------------
//業務報告の期間を切り替える（1 頁目の期間の選択肢から。CCS.PeriodBar）
//  \q の ID が On で始まるので、選ぶと OnCCSPeriod が呼ばれる（reference[0] が期間の ID）
//  「指定」なら、始まりの日と終わりの日を日付の入力欄で聞く
//------------------------------------------------------------------------------
OnCCSPeriod
{
	_key = 0

	if reference[0] != 'custom' {
		ccsperiod = reference[0]
		return Menu_CCPAGE1
	}
	_key = ccsqfrom
	if _key <= 0 {
		_key = (CCS.Today / 100) * 100 + 1
	}
	'\u\s[10]\0\s[27]いつからの働きぶりを\w9\nご覧になりたいの？\![open,dateinput,OnInputCCSFrom,0,' + (_key / 10000) + ',' + ((_key / 100) % 100) + ',' + (_key % 100) + ']\e'
}

//---- 日付の入力欄の値（「2026,9,1」）を業務日の番号にする。読めなければ 0
CCSTATS.InputKey
{
	_a = SPLIT(_argv[0], ',')

	if ARRAYSIZE(_a) != 3 || TOINT(_a[0]) < 1970 || TOINT(_a[1]) < 1 || TOINT(_a[2]) < 1 {
		return 0
	}
	TOINT(_a[0]) * 10000 + TOINT(_a[1]) * 100 + TOINT(_a[2])
}

//---- 始まりの日が決まった。続けて終わりの日を聞く（初めは本日）
OnInputCCSFrom
{
	_key   = CCSTATS.InputKey(reference[0])
	_today = CCS.Today

	if _key <= 0 {
		return Menu_CCPAGE1
	}
	ccsqfrom = _key
	'\u\s[10]\0\s[27]では、いつまで？\![open,dateinput,OnInputCCSTo,0,' + (_today / 10000) + ',' + ((_today / 100) % 100) + ',' + (_today % 100) + ']\e'
}

//---- 終わりの日が決まった。前後が逆なら入れ替え、本日より先は本日までにする
OnInputCCSTo
{
	_key   = CCSTATS.InputKey(reference[0])
	_today = CCS.Today
	_tmp   = 0

	if _key <= 0 || ccsqfrom <= 0 {
		return Menu_CCPAGE1
	}
	ccsqto = _key
	if ccsqto < ccsqfrom {
		_tmp     = ccsqfrom
		ccsqfrom = ccsqto
		ccsqto   = _tmp
	}
	if ccsqto > _today {
		ccsqto = _today
	}
	if ccsqfrom > _today {
		ccsqfrom = _today
	}
	ccsperiod = 'custom'
	Menu_CCPAGE1
}

//---- 功績録と業務報告を閉じる
Menu_CCCLOSE
{
	'\0\s[26]よろしくてよ。\w9\nこれからも励みなさいな。\e'
	'\0\s[0]記録はわたくしどもが\w9\nつけておきますわ。\e'
}

//---- filewatch を登録し直す（辞書を読み込み直したあとなど）
Menu_CCWATCH
{
	if !CC.HasSessionDir {
		'\u\s[10]\0\s[3]Claude Code のセッションの置き場所が\w9\n見当たりませんわ。\w8\1まだお入れでないのかと。\e'
	}
	else {
		CC.Start
		--
		CC.TrayIconSync
		--
		'\0\s[0]見張りを立て直しましたわ。\w8\1つつがなく。\e'
	}
}

