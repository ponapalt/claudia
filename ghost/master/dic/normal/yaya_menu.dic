//******************************************************************************
// 悪役令嬢クローディア
// メニュー処理辞書
//******************************************************************************

//******************************************************************************
//メインメニューの展開
//
//AYATEMPLATE.MenuItemの使い方
//1つめの文字列＝選択肢に表示する文字列
//2つめの文字列＝選んだときに実行される関数名
//3つめの文字列＝改行する量　50%刻み　省略すると100%（＝\n）
//******************************************************************************

//------------------------------------------------------------------------------
//メインメニュー展開
//------------------------------------------------------------------------------
OpenMenu
{
	'\0\s[0]何かご用かしら？'
	"\0\s[26]%(username)、わたくしに何の用ですの？"
	'\0\s[0]手短にお願いしますわ。'
	--
	AYATEMPLATE.MenuItem("何か話して","Menu_AITALK",200)
	--
	if ( STRLEN(AYATEMPLATE.LastTalk) > 0 ) {
		AYATEMPLATE.MenuItem("さっきの話は？","Menu_LASTTALK")
	}
	--
	AYATEMPLATE.MenuItem("しゃべる頻度を変えて","Menu_TALKINTERVAL")
	--
	AYATEMPLATE.MenuItem("他のゴーストと話す","Menu_GHOSTCOMSTART")
	--
	AYATEMPLATE.MenuItem("クローディアに話しかける","Menu_COMMUNICATEOPEN")
	--
	//---- Claude Code が動いているときだけ見せる
	if ( ARRAYSIZE(CC.Scan) > 0 ) {
		AYATEMPLATE.MenuItem("Claude Code の様子は？","Menu_CLAUDECODE")
	}
	--
	AYATEMPLATE.MenuItem("なんでもない","Menu_CANCEL",150)
}

//------------------------------------------------------------------------------
//メニュー選択タイムアウト
//------------------------------------------------------------------------------
OnChoiceTimeout
{
	'\0\s[7]早くお選びなさい。\w9\n令嬢を待たせるものではありませんわ。\e'
	'\0\s[4]‥\w5‥\w5呼んでおいて、だんまりですの？\w8\1お嬢様、そういう日もございます。\e'
}


//******************************************************************************
//各項目の処理内容
//******************************************************************************

//---- 何か話して
Menu_AITALK
{
	//---- 明示的にAIトーク開始を指示
	OnAiTalk
}

//---- さっきの話は
Menu_LASTTALK
{
	AYATEMPLATE.LastTalk
}

//---- トーク頻度の調整
Menu_TALKINTERVAL
{
	'\0\s[0]どのくらい話して差し上げればよろしいの？'
	--
	AYATEMPLATE.MenuItem("たくさん","Menu_TALKMAX",200)
	--
	AYATEMPLATE.MenuItem("ふつう","Menu_TALKNORMAL")
	--
	AYATEMPLATE.MenuItem("控えめに","Menu_TALKPOOR")
	--
	AYATEMPLATE.MenuItem("黙っていて","Menu_TALKNONE")
	--
	AYATEMPLATE.MenuItem("戻る","OpenMenu",150)
}

//---- クローディアに話しかける
Menu_COMMUNICATEOPEN
{
	'\0\s[0]何ですの？\![open,communicatebox]\e'
}

//---- 他のゴーストと話す
Menu_GHOSTCOMSTART
{
	StartCommunicate
}

//---- Claude Code の様子（起動中のセッション一覧）
Menu_CLAUDECODE
{
	_body = CC.ListBody

	if STRLEN(_body) == 0 {
		return '\0\s[4]もう誰も働いておりませんわ。\e'
	}
	//---- 一覧は長くなるので大きいバルーン（\b[2]）で出す
	//---- 本文には記録から拾った文字が入るので、%() で展開せずにつなぐ
	'\u\s[10]\0\s[26]\b[2]ご覧なさい。\w9\n今、これだけ動いておりましてよ。\w8\n\n' + _body
	--
	AYATEMPLATE.MenuItem("見張りを立て直す","Menu_CCWATCH",200)
	--
	AYATEMPLATE.MenuItem("戻る","OpenMenu")
}

//---- filewatch を登録し直す（辞書を読み込み直したあとなど）
Menu_CCWATCH
{
	CC.Start
	--
	'\0\s[0]見張りを立て直しましたわ。\w8\1つつがなく。\e'
}

//---- キャンセルされた
Menu_CANCEL
{
	'\0\s[7]‥\w5‥\w5なら、呼ばないでくださる？\e'
	'\0\s[6]そう。\w9\nでは、またの機会に。\e'
}

//---- トーク頻度
Menu_TALKMAX
{
	//---- たくさん話す(15秒間隔)
	aitalkinterval = 15
	'\0\s[5]よろしくてよ。\w9\nわたくしの話を存分にお聞きなさい！\w8\1お仕事の手は止めませんように。\e'
}

Menu_TALKNORMAL
{
	//---- ふつうに話す(3分間隔)
	aitalkinterval = 180
	'\0\s[0]では、三分に一度くらいにしておきますわ。\e'
}

Menu_TALKPOOR
{
	//---- 控えめに話す(5分間隔)
	aitalkinterval = 300
	'\0\s[6]控えめに、ですわね。\w9\n淑女らしく振る舞いますわ。\w8\1普段からそうなさってください。\e'
}

Menu_TALKNONE
{
	//---- 話さない
	aitalkinterval = 0
	'\0\s[4]‥\w5‥\w5わかりましたわ。\w9\n用があるときだけ呼びなさい。\w8\1お嬢様、少し寂しそうでございますね。\w8\0\s[7]\n\n気のせいですわ！\e'
}

//---- ヘッドライン
Menu_HEADLINECANCEL
{
	//---- キャンセルされた
	'\0\s[0]そう、ではここまでにしますわ。\e'
}
