}

Menu_TALKNONE
{
	//---- 話さない
	aitalkinterval = 0
	'\0\s[4]‥\w5‥\w5わかりましたわ。\w9\n用があるときだけ呼びなさい。\w8\1お嬢様、少し寂しそうでございますね。\w8\0\s[9]\n\n気のせいですわ！'
	--
	CONFIG.AfterItems
}

