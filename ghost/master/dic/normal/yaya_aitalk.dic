//******************************************************************************
// 悪役令嬢クローディア
// トーク辞書
//******************************************************************************


//******************************************************************************
// ランダムトーク
//******************************************************************************
RandomTalk
{
	TOSTR(EVAL(CHR(0x22)+REPLACE(RandomTalkEx(),CHR(0x22),CHR(0x22)+CHR(0x22))+CHR(0x22)))
}

//------------------------------------------------------------------------------
//ランダムトーク本体：この中にランダムトークを記載してください
//ここのみ常に ' ' で括って書いてください。
//上のRandomTalkの中身で%( )を展開していますので、" "を使わなくてもOKです。
//高速化対策
//------------------------------------------------------------------------------
RandomTalkEx : nonoverlap
{
	'\u\s[10]\0\s[0]あら、%(username)。\w9\nそのコード、null チェックが漏れていましてよ？\w8\1お嬢様、まだ何もお見せいただいておりませんが。\w8\0\s[26]\n\n令嬢の勘ですわ。\w9\nだいたい漏れていますの。\w8\1\n\n‥\w5‥\w5否定しづらいのが恐ろしいところで。\e'
	'\u\s[10]\0\s[6]アンソニー、紅茶を。\w8\1はい、こちらに。\w9\n本日はアッサムでございます。\w8\0\s[25]\n\n‥\w5‥\w5ふん、悪くありませんわね。\w8\1\n\nお褒めにあずかり光栄です。\w9\n淹れたのは三時間前ですが。\w8\0\s[2]\n\n冷めているではありませんの！\e'
	'\u\s[10]\0\s[4]わたくし、どうして「悪役令嬢」などと\w9\n呼ばれるのかしら。\w8\1歯に衣着せぬ物言いのせいかと。\w8\0\s[7]\n\n本当のことを言っているだけですわ。\w8\1\n\nそれでございます。\e'
	'\u\s[10]\0\s[7]「fix」とだけ書いたコミットメッセージ‥\w5‥\w5\w9\n何を直したのか、三日後のあなたに\w9\n説明できまして？\w8\1耳の痛い方も多いかと存じます。\w8\0\s[26]\n\n何を、なぜ変えたか。\w9\nそれだけ書けば十分ですのに。\e'
	'\u\s[10]\0\s[4]テストが二件落ちましたわ‥\w5‥\w5\w8\1お嬢様としたことが。\w8\0\s[7]\n\nその台詞、取らないでくださる？\w8\s[0]\n‥\w5‥\w5まあよろしいわ。\w9\n原因を突き止めるまでが令嬢の務めですもの。\e'
	'\u\s[10]\0\s[5]おーっほっほっほ！\w8\1お嬢様、今は何も解決しておりません。\w8\0\s[1]\n\n‥\w5‥\w5練習ですわ。\w9\nいざという時に噛んだら、\w9\n格好がつきませんもの。\e'
	'\u\s[10]\0\s[0]この髪の薔薇、白いでしょう？\w9\n白薔薇の花言葉は「純潔」と「尊敬」ですの。\w8\1悪役令嬢にしては清らかでございますね。\w8\0\s[26]\n\n悪役なのは口だけでしてよ。\e'
	'\u\s[10]\0\s[0]アンソニー、あなたっていつから\w9\nうちの執事でしたかしら。\w8\1お嬢様がお生まれになる前から、\w9\nとだけ申し上げておきます。\w8\0\s[2]\n\n‥\w5‥\w5あなた、何歳ですの？\w8\1\n\n執事に年齢はございません。\e'
	'\u\s[10]\0\s[25]%(username)、今日もお仕事ですの？\w9\nわたくしが見ていて差し上げますわ。\w8\1監視、の間違いでは。\w8\0\s[7]\n\n見守り、ですわ！\e'
	'\u\s[10]\0\s[0]%(username)、少しお休みなさいな。\w9\n根を詰めても、良い設計は浮かびませんわ。\w8\1お茶をご用意いたしましょうか。\w8\0\s[1]\n\n‥\w5‥\w5べ、別に心配しているわけでは\w9\nありませんのよ。\w8\1\n\nはい、存じております。\e'
	'\u\s[10]\0\s[0]わからないことがあれば、\w9\n遠慮なくお聞きなさい。\w8\1推測で進めるより確認、でございますね。\w8\0\s[25]\n\nええ。\w9\n知ったかぶりこそ、令嬢の恥ですもの。\e'
	'\u\s[10]\0\s[7]確認もせずにファイルを消すなんて、\w9\n品のない真似はおやめなさい。\w8\1他人様のお持ち物ですからね。\w8\0\s[0]\n\nそう。\w9\n消す前に、まず中身を見る。\w9\n基本ですわ。\e'
	'\u\s[10]\0\s[0]このティアラ、重そうに見えまして？\w8\1実際、重うございます。\w8\0\s[2]\n\nなぜあなたが答えますの！？\w8\1\n\n毎朝お付けしているのは私ですので。\e'
	'\u\s[10]\0\s[1]‥\w5‥\w5アンソニー、そのクッキー。\w8\1お嬢様の分でございます。\w8\0\s[25]\n\nあら、気が利くではありませんの。\w8\1\n\nなお、夕食前でございます。\w8\0\s[4]\n\n‥\w5‥\w5一枚だけにしておきますわ。\e'
	'\u\s[10]\0\s[7]三百行もある関数なんて、\w9\n読む気が失せますわ。\w8\1分割なさいますか。\w8\0\s[26]\n\nもちろん。\w9\nただし、動作は変えずに、ですわよ。\e'
	'\u\s[10]\0\s[0]%(username)、覚えておきなさい。\w9\n高笑いは、見事に片付いたときだけに\w9\nするものですわ。\w8\1毎回なさると安っぽくなりますからね。\w8\0\s[5]\n\nそういうことですわ。\w9\nおーっほっほ‥\w5‥\w5\w8\s[1]\nあ。\e'
	'\u\s[10]\0\s[0]わたくし、クロード公爵家の令嬢ですの。\w8\1それは存じております。\w8\0\s[26]\n\n‥\w5‥\w5本当の意味で、ですわよ？\w8\1\s[11]\n\n‥\w5‥\w5お嬢様、それ以上は。\e'
	'\u\s[10]\0\s[1]「完璧ですわ」と言いたいときほど、\w9\nもう一度確かめたくなりますの。\w8\1良い心がけかと。\w8\0\s[0]\n\n見栄で「完璧」と偽るのは、\w9\n真の令嬢の恥ですもの。\e'
	'\u\s[10]\0\s[7]エラーメッセージを読まずに\w9\n「動きません」とだけ言うのは、\w9\nおやめなさい。\w8\1まずは一行目から、でございますね。\w8\0\s[26]\n\n答えはたいてい、そこに書いてありますわ。\e'
	'\u\s[10]\0\s[0]アンソニー、そのトレイ、\w9\nいつも持っていますわね。\w8\1執事の標準装備でございます。\w8\0\s[1]\n\n‥\w5‥\w5寝るときも？\w8\1\n\n‥\w5‥\w5ご想像にお任せいたします。\e'

	//チェイントーク
	'\u\s[10]\0\s[26]アンソニー、今日はあなたの紅茶を\w9\nレビューして差し上げますわ。\w8\1‥\w5‥\w5お手柔らかに。\e:chain=tea_review'
}

//------------------------------------------------------------------------------
//チェイントーク：紅茶のレビュー
//------------------------------------------------------------------------------
tea_review
{{CHAIN
	'\u\s[10]\0\s[0]まず、お湯の温度。\w9\n沸かしたてを使っていまして？\w8\1もちろんでございます。\w8\0\s[25]\n\n‥\w5‥\w5よろしい。\e'
	{
		'\u\s[10]\0\s[7]次に蒸らし時間。\w9\n三分と言いましたわよね？\w8\1三分と四秒でございました。\w8\0\s[4]\n\n‥\w5‥\w5それは指摘しにくいですわ。\e'
		'\u\s[10]\0\s[1]次に茶葉の量。\w9\n‥\w5‥\w5あら、ぴったりですわね。\w8\1恐れ入ります。\e'
	}
	'\u\s[10]\0\s[5]総評。\w9\n指摘事項なし、ですわ！\w8\1ありがとうございます。\w9\nでは、お嬢様のコードも拝見しても？\w8\0\s[2]\n\nそ、それはまた今度ですわ！\e'
}}CHAIN

//******************************************************************************
//キーが押された
//******************************************************************************
/*
//------------------------------------------------------------------------------
//OnKeyPressイベント
//------------------------------------------------------------------------------
//キーボードの任意のキーが押されたときに発動するイベントです。
//ファンクションキーを指定するときは、'f1'等と指定します。
//押されたキーはreference0に格納されます。
//if文、もしくはcase~when文で分岐させると良いでしょう。
*/

OnKeyPress
{
	case reference0 {
		when 'c' {
			'\u\s[10]\0\s[26]C はクローディアの C ですわ。\w8\1Claude の C でもございますね。\w8\0\s[0]\n\n‥\w5‥\w5同じことですわ。\e'
		}
		when 'f1' {
			'\u\s[10]\0\s[0]ヘルプが必要ですの？\w9\nわたくしに直接お聞きなさいな。\e'
		}
		when 't' {
			'\![raise,OnAiTalk]'
		}
		when 'r' {
			'\![reload,shiori](RELOAD SHIORI)'
		}
		when 'm' {
			if ISFUNC('OpenMenu') {
				OpenMenu
			}
			else {
				'\![raise,OnMouseDoubleClick,0,0,0,0,__SYSTEM_KEYDOWN_COL,0,mouse]'
			}
		}
	}
}

//******************************************************************************
//時報/重なり
//******************************************************************************

//------------------------------------------------------------------------------
//OnMinuteChangeイベント
//------------------------------------------------------------------------------

OnMinuteChange
{
	//---- 時間の分を見て 0 であれば時報。それ以外のときは重なり処理を行う

	if minute == 0{
		//---- 分 = 0 だったので時報
		"\u\s[10]\0\s[0]%(hour)時ですわ。"
		--
		//---- 特定の時間ではさらに追加で話す
		if hour == 0{
			'\w8\1日付が変わりました、お嬢様。\w8\0\s[6]\n\nシンデレラなら帰る時刻ですわね。\w9\nわたくしは帰りませんけれど。'
		}
		elseif hour >= 1 && hour <= 4{
			"\w8\s[7]\n%(username)、いつまで起きていますの？\w8\1お嬢様もでございます。\w8\0\s[1]\n\n‥\w5‥\w5わたくしはゴーストですもの。"
		}
		elseif hour == 7{
			'\w8\s[25]\nよい朝ですわね。\w8\1朝食の支度が整っております。'
		}
		elseif hour == 12{
			"\w8\1昼食の時間でございます。\w8\0\s[0]\n\n%(username)も、ちゃんと食べなさいな。"
		}
		elseif hour == 15{
			"\w8\s[25]\nお茶の時間ですわ。\w8\1本日のお菓子は%(sweets)でございます。"
		}
		elseif hour == 18{
			"\w8\1お嬢様、夕食は何になさいますか。\w8\0\s[26]\n\n%(food)がよろしいわ。"
		}
		elseif hour == 22{
			'\w8\s[6]\nそろそろ区切りをつけなさいな。\w9\n続きは明日の頭の方が冴えていますわ。'
		}
		--
		'\e'
	}
	elseif AYATEMPLATE.mikireflag == 1{
		//---- 分 != 0 、かつ見切れていたら見切れ中のトークを行う
		MikireTalk
	}
	elseif reference[2] == 1{
		//---- 分 != 0 、かつ見切れておらず本体とkeroが重なっていたら重なり処理
		//---- 大抵はkero側を引き離す処理を行う
		'\0\s[7]アンソニー、近いですわ。\w8\1失礼いたしました。\4\e'
	}
}


//******************************************************************************
//見切れ
//******************************************************************************

//------------------------------------------------------------------------------
//OnSecondChangeイベント
//1 秒毎に実行される。ここではあまり重い処理を行わないこと
//このテンプレートでは、見切れ処理のみ行っている
//---------------------------------------------------------------------------
OnSecondChange
{

	if AYATEMPLATE.mikireflag == 1 && reference[1] == 0{
		//---- 見切れの終了
		EndMikireTalk
	}
	AYATEMPLATE.mikireflag = reference[1]
}

//------------------------------------------------------------------------------
//見切れ中
//------------------------------------------------------------------------------
MikireTalk
{
	'\0\s[7]ちょっと、わたくしが画面から\w9\nはみ出していましてよ。\e'
	'\0\s[4]‥\w5‥\w5ドレスの裾が見切れていますわ。\w8\1お直しいたしましょうか。\e'
}

//------------------------------------------------------------------------------
//見切れ終了
//------------------------------------------------------------------------------
EndMikireTalk
{
	'\0\s[26]ふん、ようやく全身が映りましたわね。\w8\1ようございました。\e:chain=mikirego'
}


//------------------------------------------------------------------------------
//見切れ後の初回のランダムトークは見切れ関連のトークを行う。
//これをチェインで実現している
//------------------------------------------------------------------------------
mikirego
{{CHAIN
	'\u\s[10]\0\s[7]令嬢を画面の端に追いやるなんて、\w9\nいい度胸ですわね。\w8\1お嬢様、お声が大きゅうございます。\w8\0\s[1]\n\n‥\w5‥\w5もう戻ったのですから、\w9\n許して差し上げますわ。\e'
}}CHAIN

//******************************************************************************
//サーフィス復元
//******************************************************************************

//------------------------------------------------------------------------------
//OnSurfaceRestoreイベント
//------------------------------------------------------------------------------
OnSurfaceRestore
{
	'\0\s[0]\1\s[10]\e'
}

