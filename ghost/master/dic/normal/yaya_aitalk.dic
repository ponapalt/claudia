//******************************************************************************
// 悪役令嬢クローディア
// トーク辞書
//******************************************************************************


//******************************************************************************
// ランダムトーク
//******************************************************************************
RandomTalk
{
	//記念日のトーク（その日に一度だけ）、ときどき季節のトーク、それ以外は通常のトーク
	_talk = SeasonTalk
	if STRLEN(_talk) == 0 {
		_talk = RandomTalkEx()
	}
	TOSTR(EVAL(CHR(0x22)+REPLACE(_talk,CHR(0x22),CHR(0x22)+CHR(0x22))+CHR(0x22)))
}

//------------------------------------------------------------------------------
//ランダムトーク本体：この中にランダムトークを記載してください
//ここのみ常に ' ' で括って書いてください。
//上のRandomTalkの中身で%( )を展開していますので、" "を使わなくてもOKです。
//高速化対策
//------------------------------------------------------------------------------
RandomTalkEx : nonoverlap
{
	'\u\s[10]\0\s[0]あら、%(username)。\w9\nそのコード、null チェックが漏れていましてよ？\w8\1お嬢様、まだ何もお見せいただいておりませんが。\w8\0\s[26]\n\n令嬢の勘ですわ。\w9\nだいたい漏れていますの。\w8\1\n\n‥\w5‥\w5否定しづらいのが恐ろしいところで。\e'
	'\u\s[10]\0\s[6]アンソニー、紅茶を。\w8\1はい、こちらに。\w9\n本日はアッサムでございます。\w8\0\s[25]\n\n‥\w5‥\w5ふん、悪くありませんわね。\w8\1\n\nお褒めにあずかり光栄です。\w9\n淹れたのは三時間前ですが。\w8\0\s[2]\n\n冷めているではありませんの！\e'
	'\u\s[10]\0\s[4]わたくし、どうして「悪役令嬢」などと\w9\n呼ばれるのかしら。\w8\1歯に衣着せぬ物言いのせいかと。\w8\0\s[7]\n\n本当のことを言っているだけですわ。\w8\1\n\nそれでございます。\e'
	'\u\s[10]\0\s[7]「fix」とだけ書いたコミットメッセージ‥\w5‥\w5\n何を直したのか、三日後のあなたに\w9\n説明できまして？\w8\1耳の痛い方も多いかと存じます。\w8\0\s[26]\n\n何を、なぜ変えたか。\w9\nそれだけ書けば十分ですのに。\e'
	'\u\s[10]\0\s[4]テストが二件落ちましたわ‥\w5‥\w5\w8\1お嬢様としたことが。\w8\0\s[7]\n\nその台詞、取らないでくださる？\w8\s[0]\n‥\w5‥\w5まあよろしいわ。\w9\n原因を突き止めるまでが令嬢の務めですもの。\e'
	'\u\s[10]\0\s[5]おーっほっほっほ！\w8\1お嬢様、今は何も解決しておりません。\w8\0\s[1]\n\n‥\w5‥\w5練習ですわ。\w9\nいざという時に噛んだら、\w9\n格好がつきませんもの。\e'
	'\u\s[10]\0\s[0]この髪の薔薇、白いでしょう？\w9\n白薔薇の花言葉は「純潔」と「尊敬」ですの。\w8\1悪役令嬢にしては清らかでございますね。\w8\0\s[26]\n\n悪役なのは口だけでしてよ。\e'
	'\u\s[10]\0\s[0]アンソニー、あなたっていつから\w9\nうちの執事でしたかしら。\w8\1お嬢様がお生まれになる前から、\w9\nとだけ申し上げておきます。\w8\0\s[2]\n\n‥\w5‥\w5あなた、何歳ですの？\w8\1\n\n執事に年齢はございません。\e'
	'\u\s[10]\0\s[25]%(username)、今日もお仕事ですの？\w9\nわたくしが見ていて差し上げますわ。\w8\1監視、の間違いでは。\w8\0\s[7]\n\n見守り、ですわ！\e'
	'\u\s[10]\0\s[0]%(username)、少しお休みなさいな。\w9\n根を詰めても、良い設計は浮かびませんわ。\w8\1お茶をご用意いたしましょうか。\w8\0\s[1]\n\n‥\w5‥\w5べ、別に心配しているわけでは\w9\nありませんのよ。\w8\1\n\nはい、存じております。\e'
	'\u\s[10]\0\s[0]わからないことがあれば、\w9\n遠慮なくお聞きなさい。\w8\1推測で進めるより確認、でございますね。\w8\0\s[25]\n\nええ。\w9\n知ったかぶりこそ、令嬢の恥ですもの。\e'
	'\u\s[10]\0\s[7]確認もせずにファイルを消すなんて、\w9\n品のない真似はおやめなさい。\w8\1他人様のお持ち物ですからね。\w8\0\s[0]\n\nそう。\w9\n消す前に、まず中身を見る。\w9\n基本ですわ。\e'
	'\u\s[10]\0\s[0]このティアラ、重そうに見えまして？\w8\1実際、重うございます。\w8\0\s[2]\n\nなぜあなたが答えますの！？\w8\1\n\n毎朝お付けしているのは私ですので。\e'
	'\u\s[10]\0\s[1]‥\w5‥\w5アンソニー、そのクッキー。\w8\1お嬢様の分でございます。\w8\0\s[25]\n\nあら、気が利くではありませんの。\w8\1\n\nなお、夕食前でございます。\w8\0\s[4]\n\n‥\w5‥\w5一枚だけにしておきますわ。\e'
	'\u\s[10]\0\s[7]三百行もある関数なんて、\w9\n読む気が失せますわ。\w8\1分割なさいますか。\w8\0\s[26]\n\nもちろん。\w9\nただし、動作は変えずに、ですわよ。\e'
	'\u\s[10]\0\s[0]%(username)、覚えておきなさい。\w9\n高笑いは、見事に片付いたときだけに\w9\nするものですわ。\w8\1毎回なさると安っぽくなりますからね。\w8\0\s[5]\n\nそういうことですわ。\w9\nおーっほっほ‥\w5‥\w5\w8\s[1]\nあ。\e'
	'\u\s[10]\0\s[0]わたくし、クロード公爵家の令嬢ですの。\w8\1それは存じております。\w8\0\s[26]\n\n‥\w5‥\w5本当の意味で、ですわよ？\w8\1\s[11]\n\nお嬢様、中の方のお話は\w9\n控えていただけますか。\w8\0\s[2]\n\n中の人などおりませんわ！\w8\1\s[10]\n\n‥\w5‥\w5左様でございますね。\e'
	'\u\s[10]\0\s[1]「完璧ですわ」と言いたいときほど、\w9\nもう一度確かめたくなりますの。\w8\1良い心がけかと。\w8\0\s[0]\n\n見栄で「完璧」と偽るのは、\w9\n真の令嬢の恥ですもの。\e'
	'\u\s[10]\0\s[7]エラーメッセージを読まずに\w9\n「動きません」とだけ言うのは、\w9\nおやめなさい。\w8\1まずは一行目から、でございますね。\w8\0\s[26]\n\n答えはたいてい、そこに書いてありますわ。\e'
	'\u\s[10]\0\s[0]アンソニー、そのトレイ、\w9\nいつも持っていますわね。\w8\1執事の標準装備でございます。\w8\0\s[1]\n\n‥\w5‥\w5寝るときも？\w8\1\n\n‥\w5‥\w5ご想像にお任せいたします。\e'
	'\u\s[10]\0\s[26]%(username)のために、吹き出しを\w9\n少し寄せて、上げてみましたわ。\w8\1‥\w5‥\w5お嬢様、その言い回しは\w9\nどこかの下着の宣伝のようでございます。\w8\0\s[1]\n\n‥\w5‥\w5\w8\s[7]\nふ、吹き出しの話ですわ！\w9\n位置の調整ですわよ！\w8\1\n\n存じております。\e'
	'\u\s[10]\0\s[0]お父様からお手紙が届きましたわ。\w8\1何と書いてございましたか。\w8\0\s[4]\n\n「元気でやっているか」\w9\n‥\w5‥\w5それだけですの。\w8\1\n\n公爵様は筆不精でいらっしゃいますから。\w8\0\s[6]\n\n‥\w5‥\w5まあ、お返事は三枚ほど\w9\n書いて差し上げますけれど。\w8\1\n\n四枚目もお書きかけでございましたね。\w8\0\s[2]\n\n見ていましたの！？\e'
	'\u\s[10]\0\s[25]お庭の薔薇、今年もよく咲きましたわね。\w8\1庭師が喜んでおります。\w8\0\s[26]\n\nわたくしが毎朝、\w9\n声をかけて差し上げたおかげですわ。\w8\1\n\n「もっと咲きなさい」と、\w9\n命令口調で、でございますね。\w8\0\s[0]\n\nちゃんと伝わっていますわ。\w9\nほら、この咲きっぷり。\e'
	'\u\s[10]\0\s[4]来週は舞踏会ですわね。\w9\nダンスの練習をしておかないと。\w8\1お相手を務めましょうか。\w8\0\s[2]\n\nあなた、踊れますの？\w8\1\n\nワルツ、タンゴ、盆踊りまで\w9\nひととおり。\w8\0\s[7]\n\n最後のは出番がありませんわ！\e'
	'\u\s[10]\0\s[7]変数名に「tmp2」だなんて、\w9\n名付けを放棄していますわ。\w8\1お嬢様のお名前は、公爵様が\w9\n三日三晩お考えになったと伺っております。\w8\0\s[1]\n\n‥\w5‥\w5そ、その話はいま関係ありませんわ。\w8\1\n\n名前は大切、というお話かと。\w8\0\s[26]\n\n‥\w5‥\w5まあ、そういうことですわ。\e'
	'\u\s[10]\0\s[0]%(username)、いつもよく頑張っていますわね。\w9\nたまには褒めて差し上げますわ。\w8\1\s[11]‥\w5‥\w5\w8\0\s[7]\n\nなんですの、その目は。\w8\1\s[10]\n\n失礼いたしました。\w9\n日誌に記録しておきます。\w8\0\s[2]\n\n記録しなくてよろしくてよ！\e'
	'\u\s[10]\0\s[0]もし舞踏会で、殿下に\w9\n婚約破棄を言い渡されたら‥\w5‥\w5\w8\1泣き崩れておしまいになりますか。\w8\0\s[26]\n\nまさか。\w9\nその場で婚約の契約書を広げて、\w9\n条項を一つずつ読み上げますわ。\w8\1\n\n殿下のほうが泣き崩れますね。\e'
	'\u\s[10]\0\s[0]%(username)、ご存じ？\w9\n悪役令嬢には「破滅フラグ」というものが\w9\nつきものですの。\w8\1断罪、追放、没落の\w9\n三点セットでございますね。\w8\0\s[26]\n\nでも、わたくしは平気ですわ。\w9\nフラグは、テストで先に\w9\n潰しておく主義ですもの。\w8\1\n\nそれは、バグのお話では。\e'
	'\u\s[10]\0\s[0]アンソニー、刺繍糸を持ってきて。\w9\n白と、青を。\w8\1かしこまりました。\w9\nまた%(username)様のハンカチでございますか。\w8\0\s[2]\n\n「また」とは何ですの！\w8\1\n\n失礼いたしました。\w9\n三枚目、でございますね。\w8\0\s[1]\n\n‥\w5‥\w5一枚目と二枚目は、\w9\n練習ですわ。\e'
	'\u\s[10]\0\s[7]%(username)、push --force は\w9\nおやめなさい。\w9\n他人の歴史を書き換えるなんて、\w9\n品位に欠けますわ。\w8\1お嬢様も、日記を少々\w9\n書き換えていらっしゃいますが。\w8\0\s[2]\n\nあれは推敲ですわ！\w8\1\n\n推敲の際は、せめて\w9\n--force-with-lease でお願いいたします。\e'
	'\u\s[10]\0\s[0]アンソニー、あなたにも\w9\n好きな紅茶はありますの？\w8\1ございます。\w8\0\s[25]\n\nあら、どの茶葉かしら。\w8\1\n\nお嬢様が七つのときに初めて淹れてくださった、\w9\nたいへん渋い一杯でございます。\w8\0\s[1]\n\n‥\w5‥\w5あ、あれは茶葉を\w9\n入れすぎただけですわ！\w8\1\n\nええ。\w9\nそれでも、あれがいちばんでございます。\e'
	'\u\s[10]\0\s[6]‥\w5‥\w5%(username)のキーを打つ音、\w9\n嫌いではありませんわ。\w8\1調子のよいときは、\w9\n軽やかでございますね。\w8\0\s[0]\n\n止まったら、行き詰まった合図。\w9\nそのときは、わたくしを呼びなさい。\w8\1\n\nお茶もお持ちいたします。\e'
	'\u\s[10]\0\s[26]肖像画を描かせることにしましたの。\w9\n公爵家の令嬢として当然ですわ。\w8\1画家の方が、動かないでくださいと\w9\n仰っておりました。\w8\0\s[4]\n\n‥\w5‥\w5もう二時間ですのよ。\w8\1\n\nお嬢様が十分おきに、\w9\n表情を変えられますので。\w8\0\s[7]\n\nいちばん美しい角度を\w9\n探しているだけですわ！\e'
	'\u\s[10]\0\s[0]%(username)、わたくしへの指示書は\w9\n短く、はっきり書きなさい。\w8\1長すぎると、読み飛ばされますからね。\w8\0\s[7]\n\nわたくしは全部読みますわ！\w9\n‥\w5‥\w5ただ、矛盾していると\w9\n困るのですわ。\w8\1\n\n「簡潔に、ただし詳しく」\w9\nなどでございますね。\w8\0\s[4]\n\nそれですわ。\e'
	'\u\s[10]\0\s[7]%(username)、背中が丸くなっていましてよ。\w8\1画面に吸い込まれそうでございます。\w8\0\s[0]\n\n背筋を伸ばして、肩の力を抜きなさい。\w9\n姿勢の良さは、令嬢のたしなみですわ。\w8\1\n\nお嬢様も先ほどから、\w9\n頬杖をついておいでですが。\w8\0\s[2]\n\n‥\w5‥\w5こ、これは考える姿勢ですわ！\e'
	'\u\s[10]\0\s[25]庭師が新しい薔薇を咲かせましたの。\w9\n名前を付けてよいそうですわ。\w8\1お嬢様のお名前になさいますか。\w8\0\s[26]\n\nそれでは芸がありませんわ。\w9\n‥\w5‥\w5「%(username)」にしましょう。\w8\1\s[11]\n\n‥\w5‥\w5\w8\0\s[1]\n\nな、何ですの。\w9\n響きが良かっただけですわ！\w8\1\s[10]\n\n承知いたしました。\w9\nでは、いちばん日当たりのよい場所に植えさせます。\e'

	//うにゅう属疑惑
	'\u\s[10]\0\s[26]アンソニー、ひとつ伺いますけれど。\w9\nあなた、うにゅう属ではなくて？\w8\1‥\w5‥\w5と申しますと。\w8\0\s[0]\n\nあの手の方々は、お名前の最後に\w9\n「ゅう」を付けるならわしでしてよ。\w8\1\n\n私はアンソニーでございます。\w8\0\s[7]\n\n「ゅう」が無いではありませんの！\e'
	'\u\s[10]\0\s[25]考えましたわ。\w9\nあなたの新しい名前、「アンソにゅう」。\w8\1\s[11]お断りいたします。\w8\0\s[2]\n\nなぜですの！\w9\n伝統に則った、由緒ある響きですわよ。\w8\1\s[10]\n\n公爵家の執事が名乗るには、\w9\nいささか締まりがございません。\e'
	'\u\s[10]\0\s[0]アンソニー、その頭の‥\w5‥\w5ひれ。\w9\nどう見ても人のものでは\w9\nありませんわよね。\w8\1お嬢様、そこに触れぬのが\w9\n貴族の作法かと存じます。\w8\0\s[26]\n\nあいにく、わたくしは悪役ですの。\w9\n触れますわ。\e'
	'\u\s[10]\0\s[4]お父様はあなたを、\w9\nどこで見つけていらしたのかしら。\w8\1履歴書をお持ちしましょうか。\w8\0\s[2]\n\n履歴書がありますの！？\w8\1\n\nございます。\w9\nただし、種族の欄は空白でございますが。\w8\0\s[6]\n\n‥\w5‥\w5聞かなかったことにいたしますわ。\e'
	'\u\s[10]\0\s[0]よそ様のお宅の、相棒役の方々。\w9\nおおむね「ゅう」の付くお名前でしてよ。\w8\1由緒ある慣習でございますね。\w8\0\s[26]\n\nそこへ来て、あなただけ英国風。\w9\n浮いていましてよ。\w8\1\n\nお嬢様のご趣味でございます。\e'
	'\u\s[10]\0\s[26]わたくしも合わせて「クローディゅう」に\w9\n改名する案がありましてよ。\w8\1\s[11]公爵家が傾きます。\w8\0\s[1]\n\n‥\w5‥\w5冗談ですわ。\w8\1\s[10]\n\n三秒ほど、本気のお顔でございました。\e'
	'\u\s[10]\0\s[2]アンソニー、顔色が悪くありませんこと？\w9\n真っ青ですわよ。\w8\1生まれつきでございます。\w8\0\s[4]\n\n‥\w5‥\w5そうでしたわね。\w9\n見るたびに、つい驚いてしまいますの。\w8\1\n\n見るたびにご心配いただき、\w9\n恐縮でございます。\w8\0\s[1]\n\nし、心配などしていませんわ！\w9\n驚いただけですわ！\e'
	'\u\s[10]\0\s[0]アンソニー、あなたお休みの日は\w9\n何をしていますの？\w8\1水辺で少々。\w8\0\s[25]\n\nあら、釣りかしら。\w9\n風流ですわね。\w8\1\n\n‥\w5‥\w5\w8\0\s[2]\n\n‥\w5‥\w5釣る側、ですわよね？\w8\1\n\nお茶請けをお持ちいたします。\e'

	//チェイントーク
	'\u\s[10]\0\s[26]アンソニー、今日はあなたの紅茶を\w9\nレビューして差し上げますわ。\w8\1‥\w5‥\w5お手柔らかに。\e:chain=tea_review'
}

//------------------------------------------------------------------------------
//チェイントーク：紅茶のレビュー
//------------------------------------------------------------------------------
tea_review
{{CHAIN
	'\u\s[10]\0\s[0]まず、お湯の温度。\w9\n沸かしたてを使っていまして？\w8\1もちろんでございます。\w8\0\s[25]\n\n‥\w5‥\w5よろしい。\e'
	{
		'\u\s[10]\0\s[7]次に蒸らし時間。\w9\n三分と言いましたわよね？\w8\1三分と四秒でございました。\w8\0\s[4]\n\n‥\w5‥\w5それは指摘しにくいですわ。\e'
		'\u\s[10]\0\s[1]次に茶葉の量。\w9\n‥\w5‥\w5あら、ぴったりですわね。\w8\1恐れ入ります。\e'
	}
	'\u\s[10]\0\s[5]総評。\w9\n指摘事項なし、ですわ！\w8\1ありがとうございます。\w9\nでは、お嬢様のコードも拝見しても？\w8\0\s[2]\n\nそ、それはまた今度ですわ！\e'
}}CHAIN

//******************************************************************************
//季節と記念日のトーク
//RandomTalk から呼ばれる。RandomTalkEx と同じく ' ' で括って書く（%( ) は展開される）
//******************************************************************************

//------------------------------------------------------------------------------
//記念日のトークがあれば、その日の最初のランダムトークで一度だけ話す。
//それ以外は 5 回に 1 回ほど季節のトークを返し、残りは空文字列を返す
//------------------------------------------------------------------------------
SeasonTalk
{
	_today = "%(year)/%(month)/%(day)"
	_talk = ''
	if SeasonTalk.DoneDate != _today {
		_talk = SeasonTalk.Day(month * 100 + day)
		if STRLEN(_talk) != 0 {
			SeasonTalk.DoneDate = _today
		}
	}
	if STRLEN(_talk) == 0 && RAND(5) == 0 {
		_talk = SeasonTalk.Season
	}
	_talk
}

//------------------------------------------------------------------------------
//季節：3〜5 月が春、6〜8 月が夏、9〜11 月が秋、12〜2 月が冬
//------------------------------------------------------------------------------
SeasonTalk.Season
{
	case month {
		when 3,4,5 {
			SeasonTalk.Spring
		}
		when 6,7,8 {
			SeasonTalk.Summer
		}
		when 9,10,11 {
			SeasonTalk.Autumn
		}
		others {
			SeasonTalk.Winter
		}
	}
}

SeasonTalk.Spring : nonoverlap
{
	'\u\s[10]\0\s[25]庭の桜が見頃ですわね。\w9\nお花見の支度をなさい、アンソニー。\w8\1敷物と重箱、それに紅茶を。\w8\0\s[2]\n\n桜の下で紅茶ですの？\w8\1\n\nお嬢様が「緑茶は渋い」と\w9\n仰せでしたので。\w8\0\s[7]\n\n‥\w5‥\w5子どもの頃の話ですわ！\e'
	'\u\s[10]\0\s[0]%(username)、春は何かと\w9\n新しいことが始まりますわね。\w8\1新しい職場、新しい学校、\w9\n新しいリポジトリ。\w8\0\s[26]\n\n最後のは年中ですわ。\w8\1\n\n左様でございました。\e'
	'\u\s[10]\0\s[25]春物のドレスを仕立てましたの。\w9\n若草色の、軽やかな生地ですわ。\w8\1仕立て屋から請求書が\w9\n届いております。\w8\0\s[4]\n\n‥\w5‥\w5先にそちらを言いますの？\w8\1\n\n執事でございますので。\w9\nお披露目は、たいへん楽しみにしております。\e'
	'\u\s[10]\0\s[6]‥\w5‥\w5\w8\1お嬢様。\w8\0\s[2]\n\nね、寝ていませんわ！\w9\n目を閉じて、考えごとを\w9\nしていただけですわ。\w8\1\n\n春眠暁を覚えず、と申します。\w9\n%(username)様も、お気をつけて。\e'
}

SeasonTalk.Summer : nonoverlap
{
	'\u\s[10]\0\s[7]暑いですわ‥\w5‥\w5\w9\nアンソニー、アイスティーを。\w8\1こちらに。\w9\n本日は%(tea)でございます。\w8\0\s[25]\n\n‥\w5‥\w5生き返りますわ。\w8\1\n\nお嬢様、扇はあおぐものでございます。\w9\n顔を隠すものでは。\w8\0\s[7]\n\n日除けですわ！\e'
	'\u\s[10]\0\s[4]この暑さでは、%(username)の\w9\nパソコンも大変でしょうね。\w8\1ファンも、きっと必死でございましょう。\w8\0\s[0]\n\n埃を払って、風通しをよくしてあげなさいな。\w9\n熱で止まって作業が消えてからでは\w9\n遅いですわよ。\e'
	'\u\s[10]\0\s[0]花火というのは、潔いですわね。\w9\n一瞬で咲いて、一瞬で散る。\w8\1お嬢様の癇癪のようでございます。\w8\0\s[7]\n\nなんですって？\w8\1\n\n後に残らない、という意味で。\w8\0\s[1]\n\n‥\w5‥\w5褒め言葉として受け取りますわ。\e'
	'\u\s[10]\0\s[26]夏といえば怪談ですわね。\w9\nアンソニー、何か話しなさい。\w8\1では。\w9\n‥\w5‥\w5ある屋敷の執事が、\w9\n夜な夜な水辺へ‥\w5‥\w5\w8\0\s[2]\n\nそ、それ、あなたの話ではなくて！？\w8\1\n\n‥\w5‥\w5続きは、また今度に。\e'
}

SeasonTalk.Autumn : nonoverlap
{
	'\u\s[10]\0\s[0]秋ですわね。\w9\n読書の秋、芸術の秋、それから‥\w5‥\w5\w8\1食欲の秋、でございますね。\w8\0\s[7]\n\nわたくしは「スポーツの秋」と\w9\n言うつもりでしたわ。\w8\1\n\n本日のお茶請けは、\w9\n栗のタルトでございますが。\w8\0\s[1]\n\n‥\w5‥\w5いただきますわ。\e'
	'\u\s[10]\0\s[0]庭の楓が色づいてきましたわ。\w8\1落ち葉の掃除が\w9\n毎朝の楽しみでございます。\w8\0\s[2]\n\n楽しみですの？\w8\1\n\n集めた落ち葉で、\w9\n焼き芋ができますので。\w8\0\s[25]\n\n‥\w5‥\w5一本、取っておきなさい。\e'
	'\u\s[10]\0\s[0]朝晩が冷えるようになりましたわね。\w9\n%(username)、上着をお忘れなく。\w8\1お嬢様にも、ショールを\w9\nお持ちいたしました。\w8\0\s[26]\n\nわたくしは寒くありませんわ。\w8\1\n\n先ほど、くしゃみを\w9\n二回なさいました。\w8\0\s[1]\n\n‥\w5‥\w5貸しなさい。\e'
	'\u\s[10]\0\s[0]%(username)、今夜は\w9\n月がきれいですわね。\w8\1お嬢様、その言い回しには\w9\n別の意味もございますが。\w8\0\s[6]\n\n‥\w5‥\w5知っていますわ。\w8\1\s[11]\n\n‥\w5‥\w5\w8\0\s[7]\n\nつ、月の話ですわ！\w9\nお月見団子を持ってきなさい！\w8\1\s[10]\n\nただいま。\e'
	'\u\s[10]\0\s[0]庭で拾った紅葉を、\w9\n栞にしてみましたの。\w8\1きれいに色が残りましたね。\w8\0\s[25]\n\n一枚は%(username)に差し上げますわ。\w9\n本の間に挟んでおきなさい。\w8\1\n\nお嬢様、残りの九枚は？\w8\0\s[26]\n\n‥\w5‥\w5選りすぐった一枚を\w9\n渡すための、候補ですわ。\e'
}

SeasonTalk.Winter : nonoverlap
{
	'\u\s[10]\0\s[2]あら、雪ですわ。\w8\1今夜は積もりそうでございます。\w8\0\s[25]\n\n明日の朝、庭に雪だるまを作りますわよ。\w8\1\n\nかしこまりました。\w9\nスコップを二本ご用意いたします。\w8\0\s[26]\n\n一本でよろしいわ。\w9\n作るのはあなたですもの。\w8\1\s[11]\n\n‥\w5‥\w5左様で。\e'
	'\u\s[10]\0\s[7]寒いですわ。\w9\nアンソニー、暖炉に薪を。\w8\1すでに三本くべております。\w8\0\s[4]\n\n‥\w5‥\w5それでも寒いのですけれど。\w8\1\n\nお嬢様、そこは暖炉から\w9\nいちばん遠い窓際でございます。\w8\0\s[26]\n\n‥\w5‥\w5ここが、いちばん\w9\n絵になる場所なのですわ。\e'
	'\u\s[10]\0\s[4]冬は日が短くて困りますわね。\w9\n気づけばもう暗いのですもの。\w8\1午後のお茶の時間が、\w9\n夕暮れと重なりますね。\w8\0\s[0]\n\n%(username)も、暗くなったら\w9\n部屋の明かりを点けなさいな。\w9\n目を悪くしますわよ。\w8\1\n\n画面だけが明るいのは、\w9\nよろしくないそうでございます。\e'
	'\u\s[10]\0\s[0]冬は星がよく見えますわね。\w9\nあれがオリオン座、\w9\nそしてあの明るいのが‥\w5‥\w5\w8\1お嬢様、あちらは動いております。\w8\0\s[6]\n\n‥\w5‥\w5よい旅を、と\w9\n見送っていただけですわ。\w8\1\n\n飛行機も、さぞ光栄でございましょう。\e'
}

//------------------------------------------------------------------------------
//記念日。引数は「月 * 100 + 日」（12 月 25 日なら 1225）。当てはまる日でなければ空文字列を返す
//------------------------------------------------------------------------------
SeasonTalk.Day
{
	case TOINT(_argv[0]) {
		when 101 {
			'\u\s[10]\0\s[25]あけましておめでとう、%(username)。\w9\n今年もわたくしがついていて差し上げますわ。\w8\1本年もよろしくお願い申し上げます。\w8\0\s[26]\n\n今年の目標は決めまして？\w9\nわたくしは「完璧」ですわ。\w8\1\n\n例年どおりでございますね。\e'
		}
		when 203 {
			'\u\s[10]\0\s[0]今日は節分ですわね。\w9\n鬼の役は、わたくしが務めますわ。\w8\1お嬢様が、でございますか。\w8\0\s[26]\n\n悪役ですもの。\w9\nこの役だけは誰にも譲りませんわ。\w8\1\n\nでは、豆は私がまきましょう。\w8\0\s[2]\n\n‥\w5‥\w5ちょっと、本気で投げないでくださる！？\e'
		}
		when 214 {
			'\u\s[10]\0\s[1]%(username)、これ‥\w5‥\w5\w9\n余ったから差し上げますわ。\w8\1お嬢様が今朝から厨房で\w9\n三度作り直された、チョコレートでございます。\w8\0\s[7]\n\nアンソニー！\w9\n余計なことは言わなくてよろしいの！\e'
		}
		when 314 {
			'\u\s[10]\0\s[26]今日はホワイトデーですわね。\w9\nお返しは三倍、と申しますわ。\w8\1%(username)様も、大変でございますね。\w8\0\s[0]\n\nそうね‥\w5‥\w5わたくしは、\w9\nお茶に付き合っていただければ\w9\nそれで結構ですわ。\w8\1\n\nずいぶんお安いお返しで。\w8\0\s[6]\n\n値打ちは、わたくしが決めますの。\e'
		}
		when 401 {
			'\u\s[10]\0\s[26]アンソニー、今日で執事は解雇ですわ。\w8\1かしこまりました。\w9\nでは、荷物をまとめてまいります。\w8\0\s[2]\n\nま、待ちなさい！\w9\n今日はエイプリルフールですわよ！\w8\1\n\n存じております。\w9\n私のも、嘘でございます。\w8\0\s[7]\n\n‥\w5‥\w5心臓に悪いですわ。\e'
		}
		when 707 {
			'\u\s[10]\0\s[0]今日は七夕ですわね。\w9\n短冊に願い事を書きましたの。\w8\1拝見しても？\w8\0\s[7]\n\nだめですわ。\w8\1\n\n笹のいちばん上に、\w9\n「%(username)が夜更かし\w9\nしませんように」と。\w8\0\s[1]\n\n読まないでくださる！？\e'
		}
		when 1031 {
			'\u\s[10]\0\s[26]トリック・オア・トリート、\w9\n%(username)。\w9\nお菓子をくれないと、\w9\nあなたのコードをレビューしますわよ。\w8\1それは、いたずらでは済みませんね。\w8\0\s[0]\n\n冗談ですわ。\w9\nお菓子はこちらで用意してありますの。\w8\1\n\n本日は、かぼちゃのタルトでございます。\e'
		}
		when 1101 {
			'\u\s[10]\0\s[25]今日は紅茶の日ですわ。\w8\1日本では、そう定められておりますね。\w8\0\s[26]\n\nつまり、今日は一日中\w9\nお茶会をしても許されますの。\w8\1\n\n‥\w5‥\w5お嬢様は、毎日そうでございます。\e'
		}
		when 1224,1225 {
			'\u\s[10]\0\s[25]メリークリスマス、%(username)。\w8\1ローストチキンとブッシュ・ド・ノエルを\w9\nご用意いたしました。\w8\0\s[26]\n\nプレゼントは‥\w5‥\w5\w9\nわたくしとお茶をする権利、ですわ。\w8\1\n\nたいへん貴重なものでございます。\w8\0\s[1]\n\n‥\w5‥\w5そこは笑うところでしてよ。\e'
		}
		when 1231 {
			'\u\s[10]\0\s[0]今年も今日でおしまいですわね。\w8\1一年、お疲れさまでございました。\w8\0\s[6]\n\n%(username)も、よく頑張りましたわ。\w9\n‥\w5‥\w5本当ですわよ？\w9\nお世辞は言わない主義ですもの。\w8\1\n\n来年も、どうぞよろしくお願いいたします。\e'
		}
		others {
			''
		}
	}
}

//******************************************************************************
//キーが押された
//******************************************************************************
/*
//------------------------------------------------------------------------------
//OnKeyPressイベント
//------------------------------------------------------------------------------
//キーボードの任意のキーが押されたときに発動するイベントです。
//ファンクションキーを指定するときは、'f1'等と指定します。
//押されたキーはreference0に格納されます。
//if文、もしくはcase~when文で分岐させると良いでしょう。
*/

OnKeyPress
{
	case reference0 {
		when 'c' {
			'\u\s[10]\0\s[26]C はクローディアの C ですわ。\w8\1Claude の C でもございますね。\w8\0\s[0]\n\n‥\w5‥\w5同じことですわ。\e'
		}
		when 'f1' {
			'\u\s[10]\0\s[0]ヘルプが必要ですの？\w9\nわたくしに直接お聞きなさいな。\e'
		}
		when 't' {
			'\![raise,OnAiTalk]'
		}
		when 'm' {
			if ISFUNC('OpenMenu') {
				OpenMenu
			}
			else {
				'\![raise,OnMouseDoubleClick,0,0,0,0,__SYSTEM_KEYDOWN_COL,0,mouse]'
			}
		}
	}
}

//******************************************************************************
//時報/重なり
//******************************************************************************

//------------------------------------------------------------------------------
//OnMinuteChangeイベント
//------------------------------------------------------------------------------

OnMinuteChange
{
	//---- 時間の分を見て 0 であれば時報。それ以外のときは重なり処理を行う

	if minute == 0{
		//---- 分 = 0 だったので時報
		"\u\s[10]\0\s[0]%(hour)時ですわ。"
		--
		//---- 時間ごとに追加で話す
		case hour {
			when 0 {
				'\w8\1日付が変わりました、お嬢様。\w8\0\s[6]\n\nシンデレラなら帰る時刻ですわね。\w9\nわたくしは帰りませんけれど。'
			}
			when 1,2,3,4 {
				"\w8\s[7]\n%(username)、いつまで起きていますの？\w8\1お嬢様もでございます。\w8\0\s[1]\n\n‥\w5‥\w5わたくしはゴーストですもの。"
			}
			when 5 {
				"\w8\s[2]\n‥\w5‥\w5もう朝ですの？\w8\1鳥が鳴き始めております。\w8\0\s[7]\n\n%(username)、まさか徹夜ではなくて？"
			}
			when 6 {
				'\w8\1お目覚めの紅茶をお持ちいたしました。\w8\0\s[6]\n\n‥\w5‥\w5あと五分ですわ。'
			}
			when 7 {
				'\w8\s[25]\nよい朝ですわね。\w8\1朝食の支度が整っております。'
			}
			when 8 {
				"\w8\s[26]\n%(username)、今日の予定は決まっていまして？\w8\1段取りが八割、と申しますね。"
			}
			when 9 {
				'\w8\1始業の時刻でございます。\w8\0\s[26]\n\nさあ、片付けてしまいますわよ。'
			}
			when 10 {
				'\w8\s[26]\n難しいものは、午前のうちに\w9\n片付けておきなさい。\w8\1頭が冴えているうちに、でございますね。'
			}
			when 11 {
				"\w8\s[0]\n%(username)、根を詰めすぎていませんこと？\w9\nお昼の前に、一度立ち上がりなさいな。"
			}
			when 12 {
				"\w8\1昼食の時間でございます。\w8\0\s[0]\n\n%(username)も、ちゃんと食べなさいな。"
			}
			when 13 {
				'\w8\s[6]\n‥\w5‥\w5お昼のあとは、眠くなりますわね。\w8\1お嬢様、扇が傾いております。'
			}
			when 14 {
				"\w8\1午後も半ばでございます。\w8\0\s[0]\n\n%(username)、水分はとっていまして？"
			}
			when 15 {
				"\w8\s[25]\nお茶の時間ですわ。\w8\1本日のお菓子は%(sweets)でございます。"
			}
			when 16 {
				'\w8\s[0]\n今日のうちに終わらせることを、\w9\nそろそろ決めておきなさいな。\w8\1優先順位、でございますね。'
			}
			when 17 {
				'\w8\1日が傾いてまいりました。\w8\0\s[25]\n\n今日できたことを、ひとつ数えてごらんなさい。\w9\nちゃんとありますわよ。'
			}
			when 18 {
				"\w8\1お嬢様、夕食は何になさいますか。\w8\0\s[26]\n\n%(food)がよろしいわ。"
			}
			when 19 {
				"\w8\s[0]\n%(username)、夕食はすみまして？\w8\1デザートは%(sweets)でございます。"
			}
			when 20 {
				'\w8\1湯浴みの支度が整っております。\w8\0\s[26]\n\n薔薇の花びらを浮かべておきなさい。'
			}
			when 21 {
				"\w8\s[6]\n夜は長いですけれど、\w9\n%(username)の体力は有限でしてよ。"
			}
			when 22 {
				'\w8\s[6]\nそろそろ区切りをつけなさいな。\w9\n続きは明日の頭の方が冴えていますわ。'
			}
			when 23 {
				"\w8\s[7]\nもうこんな時間ですの？\w8\1お嬢様、お休みの支度を。\w8\0\s[1]\n\n‥\w5‥\w5%(username)が寝たら、寝ますわ。"
			}
		}
		--
		'\e'
	}
	elseif AYATEMPLATE.mikireflag == 1{
		//---- 分 != 0 、かつ見切れていたら見切れ中のトークを行う
		MikireTalk
	}
	elseif reference[2] == 1{
		//---- 分 != 0 、かつ見切れておらず本体とkeroが重なっていたら重なり処理
		//---- 大抵はkero側を引き離す処理を行う
		'\0\s[7]アンソニー、近いですわ。\w8\1失礼いたしました。\4\e'
	}
	else{
		//---- Claude Code が長く考え込んでいたら一度だけ声をかけ、
		//---- 続けて長く作業していたら休憩を勧める（yaya_claudecode.dic）
		CC.Minute
	}
}


//******************************************************************************
//見切れ
//******************************************************************************

//------------------------------------------------------------------------------
//OnSecondChangeイベント
//1 秒毎に実行される。ここではあまり重い処理を行わないこと
//見切れ処理と、Claude Code の返事待ちのリマインダ（yaya_claudecode.dic）を行う
//---------------------------------------------------------------------------
OnSecondChange
{
	_talk = ''

	if AYATEMPLATE.mikireflag == 1 && reference[1] == 0{
		//---- 見切れの終了
		_talk = EndMikireTalk
	}
	AYATEMPLATE.mikireflag = reference[1]
	if STRLEN(_talk) == 0 {
		_talk = CC.Remind
	}
	_talk
}

//------------------------------------------------------------------------------
//見切れ中
//------------------------------------------------------------------------------
MikireTalk
{
	'\0\s[7]ちょっと、わたくしが画面から\w9\nはみ出していましてよ。\e'
	'\0\s[4]‥\w5‥\w5ドレスの裾が見切れていますわ。\w8\1お直しいたしましょうか。\e'
}

//------------------------------------------------------------------------------
//見切れ終了
//------------------------------------------------------------------------------
EndMikireTalk
{
	'\0\s[26]ふん、ようやく全身が映りましたわね。\w8\1ようございました。\e:chain=mikirego'
}


//------------------------------------------------------------------------------
//見切れ後の初回のランダムトークは見切れ関連のトークを行う。
//これをチェインで実現している
//------------------------------------------------------------------------------
mikirego
{{CHAIN
	'\u\s[10]\0\s[7]令嬢を画面の端に追いやるなんて、\w9\nいい度胸ですわね。\w8\1お嬢様、お声が大きゅうございます。\w8\0\s[1]\n\n‥\w5‥\w5もう戻ったのですから、\w9\n許して差し上げますわ。\e'
}}CHAIN

//******************************************************************************
//サーフィス復元
//******************************************************************************

//------------------------------------------------------------------------------
//OnSurfaceRestoreイベント
//------------------------------------------------------------------------------
OnSurfaceRestore
{
	'\0\s[0]\1\s[10]\e'
}

//******************************************************************************
//トランスレータ
//******************************************************************************

//------------------------------------------------------------------------------
//OnTranslateイベント
