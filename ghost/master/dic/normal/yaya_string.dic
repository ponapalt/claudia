//******************************************************************************
//オーナードローメニュー
//右クリックされたキャラ（yaya_mouse.dic の OnMouseDown が menuscope に覚える）に
//合わせて、クローディア用とアンソニー用の画像と色を返し分ける。
//画像は work/menu/make-menu.ps1 で作る。配置（alignment）は descript.txt にある。
//******************************************************************************
On_menu.background.bitmap.filename
{
	MenuFile('background')
}

On_menu.foreground.bitmap.filename
{
	MenuFile('foreground')
}

On_menu.sidebar.bitmap.filename
{
	MenuFile('sidebar')
}

On_menu.background.font.color.r { MenuColor('background', 0) }
On_menu.background.font.color.g { MenuColor('background', 1) }
On_menu.background.font.color.b { MenuColor('background', 2) }

On_menu.foreground.font.color.r { MenuColor('foreground', 0) }
On_menu.foreground.font.color.g { MenuColor('foreground', 1) }
On_menu.foreground.font.color.b { MenuColor('foreground', 2) }

On_menu.disable.font.color.r { MenuColor('disable', 0) }
On_menu.disable.font.color.g { MenuColor('disable', 1) }
On_menu.disable.font.color.b { MenuColor('disable', 2) }

On_menu.separator.color.r { MenuColor('separator', 0) }
On_menu.separator.color.g { MenuColor('separator', 1) }
On_menu.separator.color.b { MenuColor('separator', 2) }

On_menu.frame.color.r { MenuColor('frame', 0) }
On_menu.frame.color.g { MenuColor('frame', 1) }
On_menu.frame.color.b { MenuColor('frame', 2) }

MenuFile
{
	//_argv[0]: background / foreground / sidebar
	if menuscope == 1 {
		'menu/menu_anthony_' + _argv[0] + '.png'
	}
	else {
		'menu/menu_' + _argv[0] + '.png'
	}
}

MenuColor
{
	//_argv[0]: 項目名、_argv[1]: 0=赤 1=緑 2=青
	_rgb = IARRAY
	if menuscope == 1 {
		case _argv[0] {
			when 'background' { _rgb = (34, 38, 58) }
			when 'foreground' { _rgb = (52, 86, 168) }
			when 'disable' { _rgb = (138, 146, 170) }
			when 'separator' { _rgb = (169, 177, 196) }
			when 'frame' { _rgb = (38, 42, 59) }
		}
	}
	else {
		case _argv[0] {
			when 'background' { _rgb = (58, 36, 25) }
			when 'foreground' { _rgb = (140, 59, 31) }
			when 'disable' { _rgb = (138, 117, 96) }
			when 'separator' { _rgb = (185, 141, 74) }
			when 'frame' { _rgb = (180, 83, 47) }
		}
	}
	_rgb[_argv[1]]
}


//******************************************************************************
//おすすめサイトのリストを書きやすくするためのコア
//基本的には以下はいじらなくていいです。
//******************************************************************************
On_sakura.recommendsites
{
	AYATEMPLATE.LinkMenuConvert(On_sakura.recommendsites_EX)
}

On_sakura.portalsites
{
	AYATEMPLATE.LinkMenuConvert(On_sakura.portalsites_EX)
}

On_kero.recommendsites
{
	AYATEMPLATE.LinkMenuConvert(On_kero.recommendsites_EX)
}
