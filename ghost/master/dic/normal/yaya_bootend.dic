//******************************************************************************
// 悪役令嬢クローディア
// 起動/終了トーク辞書
//******************************************************************************

//******************************************************************************
//初回起動 OnFirstBoot
//******************************************************************************

OnFirstBoot
{
	//---- 変数の初期化
	username         = 'あなた'
	teachusername    = 0// ユーザー名覚え用

	_vanishcount = TOINT(reference[0])

	//---- Vanishカウントを見て、真の初回か否かを判定する
	if _vanishcount <= 0{
		//---- ほんとうに初めての起動
		'\u\s[10]\0\s[26]ごきげんよう。\w9\nわたくしはクローディア。\w9\nクロード公爵家の令嬢ですわ。\w8\1執事のアンソニーでございます。\w9\n以後、お見知りおきを。\w8\0\s[0]\n\nあなたのデスクトップ、\w9\nしばらくわたくしが預かって差し上げますわ。\w8\1お嬢様、預かるのではなく\w9\nお邪魔するのでございます。\w8\0\s[7]\n\n細かいですわね。\w8\s[0]\n‥\w5‥\w5お名前を教えてくださるなら、\w9\n話しかけて「名前を覚えて」と\w9\nおっしゃいなさい。\w8\s[25]\nそれでは、よろしくお願いいたしますわ。\e'
		return
	}
	elseif _vanishcount == 1{
		//vanish１回なら誤操作かもしれない
		'\u\s[10]\0\s[7]‥\w5‥\w5一度追い出しておいて、\w9\nまた呼び戻すなんて。\w8\1お嬢様、お顔が。\w8\0\s[1]\n\n‥\w5‥\w5べつに嬉しくなどありませんわ。'
	}
	elseif _vanishcount < 10{
		//2-9回
		'\u\s[10]\0\s[4]また、ですの？\w8\1これで何度目でございましょう。\w8\0\s[7]\n\n数えなくてよろしい！'
	}
	else{
		//10回以上
		"\u\s[10]\0\s[6]%(_vanishcount)回。\w9\nもう、何も申しませんわ。\w8\1お嬢様が黙ると、かえって恐ろしゅうございます。"
	}
	--
	'\w8\0\s[0]\n\n‥\w5‥\w5まあよろしいわ。\w9\n改めて、よろしくお願いいたしますわ。\e'
}


//******************************************************************************
//通常の起動 OnBoot
//******************************************************************************

OnBoot
{
	//---- Claude Code のセッションの見張りを始める（yaya_claudecode.dic）
	CC.Start
	--
	//---- まず双方のサーフィスを表示
	'\0\s[0]\1\s[10]'
	--
	//---- 起動時間を確認してあいさつを変化
	_timeslot = GetTimeSlot

	case _timeslot{
		when '朝'{
			"\0\s[25]ごきげんよう、%(username)。\w9\nよい朝ですわね。\w8\1モーニングティーをお持ちいたしました。"
			'\0\s[6]‥\w5‥\w5\w8\1お嬢様、朝でございます。\w8\0\s[2]\n\n‥\w5‥\w5お、起きていましたわよ！'
			"\0\s[0]ごきげんよう、%(username)。\w9\n今朝の紅茶は%(tea)ですわ。\w8\1淹れたてでございます。\w8\0\s[26]\n\n朝の一杯を逃すなんて、\w9\nもったいないことですわよ。"
		}
		when '昼'{
			"\0\s[0]ごきげんよう、%(username)。\w9\nお昼はもう召し上がりまして？\w8\1%(food)がございますよ。"
			"\0\s[0]ごきげんよう、%(username)。\w9\n午後に備えて、しっかり\w9\n食べておきなさいな。\w8\1食後に%(sweets)もございます。\w8\0\s[25]\n\nそれは別腹ですわね。"
		}
		when '日中'{
			"\0\s[26]あら、%(username)。\w9\nわたくしに会いに来ましたの？\w8\1お仕事の合間でございましょう。\w8\0\s[7]\n\n‥\w5‥\w5どちらでもよろしくてよ。"
			'\0\s[0]ごきげんよう。\w9\n午後もしっかり働きなさいな。\w8\1お嬢様もでございます。'
			"\0\s[6]‥\w5‥\w5あら、%(username)。\w9\n少し考え事をしていましたの。\w8\1お茶菓子を何にするかで、\w9\n半刻ほど。\w8\0\s[7]\n\n大事なことですわ！"
		}
		when '夜'{
			"\0\s[0]ごきげんよう、%(username)。\w9\n今日もお疲れさまでしたわね。\w8\1夜のお茶はカモミールになさいますか。\w8\0\s[25]\n\nええ、そうしてちょうだい。"
			'\0\s[0]ごきげんよう。\w9\n夜はこれからですわね。\w8\1お嬢様、夜更かしはほどほどに。\w8\0\s[26]\n\nわたくしではなく、\w9\nこの方に言いなさいな。'
			"\0\s[1]‥\w5‥\w5お、おかえりなさい、%(username)。\w8\1お嬢様は先ほどから、\w9\nそわそわとお待ちでございました。\w8\0\s[7]\n\nアンソニー、口が過ぎましてよ。"
		}
		others{
			//それ以外の時間の場合
			"\0\s[7]こんな時間に何をしていますの、%(username)。\w8\1お嬢様も起きておいでです。\w8\0\s[1]\n\n‥\w5‥\w5わたくしは、待っていただけですわ。"
			"\0\s[2]あら、%(username)。\w9\nこんな夜更けにどうしましたの？\w8\1眠れないのでしたら、\w9\nホットミルクをお持ちします。\w8\0\s[0]\n\n少し付き合って差し上げますわ。\w9\n少しだけですわよ。"
			'\0\s[4]夜更かしは美容の敵ですのに。\w8\1お嬢様、巻き髪が一本ほどけております。\w8\0\s[2]\n\nみ、見ないでちょうだい！'
		}
	}//caseの終わり
	--
	//---- 話し終わって 5 秒たったら、返事待ちの Claude Code がないか見る（yaya_claudecode.dic）
	//---- timerraise は実行された瞬間から数えるので、トークの最後に置く
	CC.BootTimer + '\e'
}

//------------------------------------------------------------------------------
//朝/昼/夜などをおおざっぱに調べる関数
//------------------------------------------------------------------------------
GetTimeSlot
{
	case hour{
		when 22,23,0,1,2,3 {'深夜'}
		when 4,5,6,7,8,9,10,11 {'朝'}
		when 12,13 {'昼'}
		when 14,15,16,17 {'日中'}
		when 18,19,20,21 {'夜'}
	}//caseの終わり
}


//******************************************************************************
//終了 OnClose
//******************************************************************************

OnClose
{
	'\1\s[10]'
	--
	//---- 本日 Claude Code に依頼していたら、その数をひとこと（yaya_ccstats.dic）
	CCS.CloseReport
	--
	//この部分には\eつけないでね！
	_timeslot = GetTimeSlot
	if _timeslot == '朝'{
		//---- 朝に終了
		"\0\s[0]お出かけですの？\w9\nいってらっしゃいませ、%(username)。\w8\1お気をつけて。"
	}
	elseif _timeslot == "昼" || _timeslot == "日中"{
		//---- 昼/日中に終了
		'\0\s[7]もう行ってしまいますの？\w8\1お嬢様、お引き止めしてはなりません。\w8\0\s[1]\n\n‥\w5‥\w5わかっていますわ。\w9\nごきげんよう。'
	}
	elseif _timeslot == '夜'{
		"\0\s[25]今日もよく頑張りましたわね、%(username)。\w9\nごきげんよう。\w8\1お休みなさいませ。"
	}
	else{
		//---- 深夜に終了
		"\0\s[6]ようやく寝る気になりましたのね。\w9\nおやすみなさい、%(username)。\w8\1良い夢を。"
	}
	--
	'\w9\w9\-\e'
}


//******************************************************************************
//最小化からの復帰 OnWindowStateRestore
//******************************************************************************

OnWindowStateRestore
{
	'\u\s[10]\0\s[7]わたくしを隠すなんて、いい度胸ですわね。\w8\1お嬢様、お仕事の邪魔だったのでございましょう。\e'
	'\u\s[10]\0\s[26]ふん、やはりわたくしがいないと\w9\n寂しいのでしょう？\w8\1‥\w5‥\w5ノーコメントでございます。\e'
	'\u\s[10]\0\s[0]ようやく出してくださいましたわね。\w8\1その間に、お茶を淹れ直しておきました。\e'
	"\u\s[10]\0\s[6]‥\w5‥\w5ふう、窮屈でしたわ。\w8\1おかえりなさいませ、%(username)。\w8\0\s[26]\n\n次は、もう少し広いところに\w9\n仕舞ってくださるかしら。\e"
}


//******************************************************************************
//最小化 OnWindowStateMinimize
//SSP の設定で「最小化時に喋る」が有効なときだけ表示される
//reference[0] は最小化の理由（system / script / sakuraapi / user）
//******************************************************************************

OnWindowStateMinimize
{
	//---- 自分（さくらスクリプトや SAORI）から最小化したときは黙っておく
	if reference[0] == 'script' || reference[0] == 'sakuraapi'{
		return ''
	}

	'\u\s[10]\0\s[7]あら、わたくしを仕舞い込むおつもり？\w8\1行ってまいります。\e'
	'\u\s[10]\0\s[6]しばしお休みいたしますわ。\w8\1ごゆるりと。\e'
	"\u\s[10]\0\s[26]よろしくてよ。\w9\n用があればお呼びなさいな、%(username)。\e"
}


//******************************************************************************
//全画面アプリによる最小化と復帰
//OnWindowStateMinimize / OnWindowStateRestore を上書きして発生する
//reference[0] は常に fullscreen
//******************************************************************************

OnFullScreenAppMinimize
{
	'\u\s[10]\0\s[26]全画面ですの。\w9\nお邪魔はいたしませんわ。\w8\1ごゆっくり。\e'
	'\u\s[10]\0\s[0]何か始めるのですわね。\w8\1お茶は冷めぬようにしておきます。\e'
}

OnFullScreenAppRestore
{
	'\u\s[10]\0\s[25]おかえりなさいませ。\w9\n首尾はいかがでしたの？\w8\1お帰りをお待ちしておりました。\e'
	'\u\s[10]\0\s[7]ずいぶん長うございましたわね。\w8\1お嬢様、お待ちかねでございました。\w8\0\s[1]\n\n待ってなどいませんわ。\e'
	'\u\s[10]\0\s[6]画面が戻りましたわね。\w9\n少し目を休めなさいな。\w8\1紅茶をお淹れいたします。\e'
}
