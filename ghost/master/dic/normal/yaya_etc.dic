//******************************************************************************
// 悪役令嬢クローディア
// 種々のイベント辞書
//******************************************************************************

//******************************************************************************
//シェル切り替え
//******************************************************************************

//------------------------------------------------------------------------------
//シェルチェンジ開始
//------------------------------------------------------------------------------

OnShellChanging
{
	'\0\s[0]お召し替えですわ。\w8\1のぞいてはなりませんよ。\e'
}

//------------------------------------------------------------------------------
//シェルチェンジ完了
//------------------------------------------------------------------------------
OnShellChanged
{
	_escaped_name = SHIORI3FW.EscapeAllTags(reference[0])
	"\0\s[26]「%(_escaped_name)」、いかがかしら？\w8\1よくお似合いでございます。\e"
}


//******************************************************************************
//インストール関連
//******************************************************************************

//------------------------------------------------------------------------------
//インストール中のメッセージ
//------------------------------------------------------------------------------
OnInstallBegin
{
	'\0\s[6]インストールしていますわ‥\w6‥\w6\e'
}

//------------------------------------------------------------------------------
//インストール完了メッセージ
//------------------------------------------------------------------------------
OnInstallComplete
{
	_ref0 = SPLIT(reference[0],' with',2)[0]//hogehoge with hemohemo

	'\0\s[0]'
	--
	if _ref0 == 'shell' {
		'シェル'
	}
	elseif _ref0 == 'ghost' {
		'ゴースト'
	}
	elseif _ref0 == 'balloon' {
		'バルーン'
	}
	elseif _ref0 == 'plugin' {
		'プラグイン'
	}
	--
	_escaped_name = SHIORI3FW.EscapeAllTags(reference[1])
	"「%(_escaped_name)」のインストール、完了ですわ。\n"
	--
	if basewarenameex == 'SSP' {
		_id = ''
		if _ref0 == 'shell' {
			_id = 'shell'
		}
		elseif _ref0 == 'ghost' {
			_id = 'ghost'
		}
		elseif _ref0 == 'balloon' {
			_id = 'balloon'
		}

		if _id != '' {
			'切り替えますの？'
			--
			AYATEMPLATE.MenuItem("切り替える","OnAYATEMPLATE.InstallChange",_id,200)
			--
			AYATEMPLATE.MenuItem("切り替えない","Menu_CANCEL")
		}
	}
}

OnAYATEMPLATE.InstallChange
{
	"\![change,%(AYATEMPLATE.EscapeText(reference[0])),lastinstalled]"
}

//------------------------------------------------------------------------------
//インストール失敗メッセージ
//------------------------------------------------------------------------------
OnInstallFailure
{
	_escaped_message = SHIORI3FW.EscapeAllTags(reference[0])
	"\0\s[4]インストールに失敗しましたわ。\n\n理由：%(_escaped_message)\e"
}

//------------------------------------------------------------------------------
//インストール拒否（他のゴーストのためのアーカイブだった）
//------------------------------------------------------------------------------
OnInstallRefuse
{
	_escaped_name = SHIORI3FW.EscapeAllTags(reference[0])
	"\0\s[7]これは%(_escaped_name)宛ての荷物ですわ。\w9\nわたくしに渡されても困りますの。\w8\1先方にお届けくださいませ。\e"
}


//******************************************************************************
//消滅関連
//******************************************************************************

//------------------------------------------------------------------------------
//消滅指示
//------------------------------------------------------------------------------
OnVanishSelecting
{
	'\0\s[2]‥\w5‥\w5本気ですの？\w8\1お考え直しを。\e'
}

//------------------------------------------------------------------------------
//消滅開始
//------------------------------------------------------------------------------
OnVanishSelected
{
	"\0\s[4]‥\w5‥\w5そう。\w9\nそれがあなたの判断なら、従いますわ。\w8\1お世話になりました。\w8\0\s[0]\n\nごきげんよう、%(username)。\w9\nどうかお元気で。\e"
}

//------------------------------------------------------------------------------
//消滅中止
//------------------------------------------------------------------------------
OnVanishCancel
{
	"\0\s[7]‥\w5‥\w5趣味の悪い冗談ですわ、%(username)。\w8\1お嬢様、目元が。\w8\0\s[1]\n\nな、泣いてなどいませんわ！\e"
}

//------------------------------------------------------------------------------
//他のゴーストが消滅して自分に切り替わった
//------------------------------------------------------------------------------
OnVanished
{
	_escaped_name = SHIORI3FW.EscapeAllTags(reference[0])
	"\0\s[4]%(_escaped_name)、行ってしまいましたのね。\w8\1またどこかでお会いできますよ。\w8\0\s[6]\n\n‥\w5‥\w5ええ、そうですわね。\e"
}


//******************************************************************************
//メールチェック
//******************************************************************************

//------------------------------------------------------------------------------
//メールチェック開始
//------------------------------------------------------------------------------
OnBIFFBegin
{
	'\0\s[0]アンソニー、郵便を確かめてちょうだい。\1\s[10]かしこまりました。\e'
}

//------------------------------------------------------------------------------
//メールチェック成功
//------------------------------------------------------------------------------
OnBIFFComplete
{
	if TOINT(reference[0]) == 0{
		//---- メールは無かった
		'\1\s[10]本日のお便りはございません。\w8\0\s[0]そう、静かな日ですわね。\e'
	}
	else{
		//---- メールが届いていた
		"\1\s[10]%(reference[0])通のお便りが届いております。\w8\0\s[0]%(username)、目を通しておきなさいな。\e"
	}
}

//------------------------------------------------------------------------------
//メールチェック失敗
//------------------------------------------------------------------------------
OnBIFFFailure
{
	if reference[0] == 'timeout'{
		//---- タイムアウト
		'\1\s[10]郵便局から返事がございません。\w8\0\s[4]困りましたわね。\e'
	}
	elseif reference[0] == 'kick'{
		//---- 蹴られた
		'\1\s[10]門前払いされました。\w8\0\s[7]失礼な郵便局ですこと。\e'
	}
	elseif reference[0] == 'defect'{
		//---- 設定誤り
		"\1\s[10]設定に誤りがあるようでございます。\w8\0\s[0]%(username)、メールの設定を見直しなさいな。\e"
	}
	else{
		//---- 原因不明
		'\1\s[10]原因はわかりませんが、失敗いたしました。\w8\0\s[4]‥\w5‥\w5あら。\e'
	}
}


//******************************************************************************
//ネットワーク更新
//******************************************************************************

//------------------------------------------------------------------------------
//ネットワーク更新開始
//------------------------------------------------------------------------------
OnUpdateBegin
{
	'\0\s[26]わたくしを更新しますわ。\w9\nより優雅になって差し上げましてよ。\e'
	'\0\s[0]ネットワーク更新を始めますわ。\w8\1少々お待ちくださいませ。\e'
}

//------------------------------------------------------------------------------
//ネットワーク更新準備完了
//------------------------------------------------------------------------------
OnUpdateReady
{
	"\0\s[0]%(TOINT(reference[0])+1)個のファイルを取り寄せますわ。\e"
}

//------------------------------------------------------------------------------
//ネットワーク更新終了
//------------------------------------------------------------------------------
OnUpdateComplete
{
	if reference[0] == 'none'{
		//---- 更新すべきファイルが無かった
		'\0\s[26]更新はありませんでしたわ。\w9\nわたくしはもとより完成されていますもの。\w8\1作者様がお忙しいだけでございます。\e'
	}
	else{
		//---- 実際に更新が完了した
		'\0\s[5]更新完了ですわ！\w9\nおーっほっほっほ！\w8\1お見事でございます。\e'
	}
}

//------------------------------------------------------------------------------
//ネットワーク更新失敗
//------------------------------------------------------------------------------
OnUpdateFailure
{
	if reference[0] == 'timeout'{
		//---- タイムアウトした
		'\0\s[4]‥\w5‥\w5時間切れですわ。'
	}
	elseif reference[0] == 'md5 miss'{
		//---- MD5値が一致しなかった
		'\u\s[10]\0\s[4]ファイルの MD5 値が合いませんわ。\w8\1お手数ですが、配布元へご報告いただけますと幸いです。'
	}
	else{
		//---- 上記以外の理由で失敗した
		_escaped_message = SHIORI3FW.EscapeAllTags(reference[0])
		"\0\s[4]「%(_escaped_message)」ですって。"
	}
	--
	'\w8\n\nネットワーク更新、失敗ですわ。\w9\nわたくしとしたことが‥\w5‥\w5\e'
}

//------------------------------------------------------------------------------
//ネットワーク更新 ダウンロード開始
//------------------------------------------------------------------------------
OnUpdate.OnDownloadBegin
{
	_escaped_name = SHIORI3FW.EscapeAllTags(reference[0])
	"\0\s[0]「%(_escaped_name)」を取り寄せていますわ。\e"
}

//------------------------------------------------------------------------------
//ネットワーク更新 MD5値照合開始
//------------------------------------------------------------------------------
OnUpdate.OnMD5CompareBegin
{
	'\0\s[6]中身を検めますわ‥\w5‥\w5\e'
}

//------------------------------------------------------------------------------
//ネットワーク更新 MD5値一致
//------------------------------------------------------------------------------
OnUpdate.OnMD5CompareComplete
{
	'\0\s[0]問題ありませんわね。\e'
}

//------------------------------------------------------------------------------
//ネットワーク更新 MD5値不一致
//------------------------------------------------------------------------------
OnUpdate.OnMD5CompareFailure
{
	'\0\s[7]中身が合いませんわ。\w9\nどこかで壊れたようですわね。\e'
}

//******************************************************************************
//ヘッドラインセンス
//******************************************************************************

//------------------------------------------------------------------------------
//ヘッドラインセンス開始
//------------------------------------------------------------------------------
OnHeadlinesenseBegin
{
	_escaped_name = SHIORI3FW.EscapeAllTags(reference[0])
	"\0\s[0]%(_escaped_name)のヘッドラインを取り寄せていますわ。\e"
}

//------------------------------------------------------------------------------
//ヘッドライン読み上げ
//------------------------------------------------------------------------------
OnHeadlinesense.OnFind
{
	_escaped_name = SHIORI3FW.EscapeAllTags(reference[0])
	//---- はじめのセリフ
	if reference[2] == "First" || reference[2] == "First and Last"{
		//---- 最初のページ
		"\0\b2\s[0]%(_escaped_name)のヘッドラインですわ。"
	}
	elseif reference[2] == 'Next'{
		//---- 真ん中あたりのページ
		"\0\b2\s[0]%(_escaped_name)のヘッドライン、続きですわ。"
	}
	elseif reference[2] == 'Last'{
		//---- 最後のページ
		"\0\b2\s[0]%(_escaped_name)のヘッドライン、これで最後ですわ。"
	}
	--
	//---- ヘッドライン本体
	"\n\n%(reference[3])\n"
	--
	//---- 選択肢
	if reference[2] == "First" || reference[2] == "Next"{
		//---- 次のページがある場合
		AYATEMPLATE.MenuItem("次のページ","")
		--
		AYATEMPLATE.MenuItem('サイトへ',reference[1])
		--
		AYATEMPLATE.MenuItem("やめる","Menu_HEADLINECANCEL",150)
	}
	else{
		//---- 次のページがない場合
		AYATEMPLATE.MenuItem('サイトへ',reference[1])
		--
		AYATEMPLATE.MenuItem("やめる","Menu_HEADLINECANCEL",150)
	}
}

//------------------------------------------------------------------------------
//ヘッドライン更新が無かった
//------------------------------------------------------------------------------
OnHeadlinesenseComplete
{
	_escaped_name = SHIORI3FW.EscapeAllTags(reference[0])
	"\0\s[0]%(_escaped_name)、更新はありませんわ。\e"
}

//------------------------------------------------------------------------------
//ヘッドラインセンス失敗
//------------------------------------------------------------------------------
OnHeadlinesenseFailure
{
	'\0\s[4]ヘッドラインの取得に失敗しましたわ。\n\n理由：'
	--
	if reference[0] == "can't download"{
		'ダウンロードできませんでした。'
	}
	elseif reference[0] == "can't analyze"{
		'解析できませんでした。'
	}
	else{
		'不明ですわ。'
	}
	--
	'\e'
}


