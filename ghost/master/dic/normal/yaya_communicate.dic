//******************************************************************************
// 悪役令嬢クローディア
// コミュニケート辞書
//******************************************************************************


//******************************************************************************
//こちらから話しかける
//******************************************************************************

//この関数は現状メニューから呼ばれます
StartCommunicate
{
	//以下の関数は、隣に立っているゴーストを探して、
	//TalkTo_??? 関数を呼び出すものです。誰も居なければランダムトークをします。
	//yaya_tmpl_utilにあります。
	AYATEMPLATE.ExecuteTalkToTalk
}

//その他の人に話しかける
TalkToOther{
	_escaped_name = SHIORI3FW.EscapeAllTags(res_reference0)
	"\0\s[26]ごきげんよう、%(_escaped_name)。\w9\nお元気そうで何よりですわ。\1\s[10]お嬢様がいつもお世話になっております。"
}

TalkToNobody{
	'\0\s[4]‥\w5‥\w5誰もいませんわね。\1\s[10]お茶会は、また今度でございますね。'
}


//******************************************************************************
//話しかけられたので返事する
//******************************************************************************

//------------------------------------------------------------------------------
//OnCommunicateイベント
//------------------------------------------------------------------------------
OnCommunicate
{
	if reference[0] == "user" || reference[0] == "User"{
		//---- ユーザーからの話しかけ
		ReplyToUser
	}
	else{
		//---- ゴーストからの話しかけ
		//以下の関数は、ReplyTo_??? 関数を呼び出すものです。
		//yaya_tmpl_utilにあります。
		AYATEMPLATE.ExecuteReplyToTalk(reference[0])
	}
}

//------------------------------------------------------------------------------
//ユーザーからの話しかけ
//------------------------------------------------------------------------------
ReplyToUser
{
	if "名前" _in_ reference[1] && "覚えて" _in_ reference[1]{
		//---- ユーザー名入力開始
		'\0\s[0]よろしくてよ。\w9\nあなたのお名前、教えてくださる？\e'
		teachusername = 1
	}
	else{
		//---- ユーザー名入力開始以外
		if teachusername == 1{
			//---- 直前が「名前覚えて」だったので名前を覚える
			if SHIORI3FW.EscapeAllTags(reference[1]) != reference[1] {
				'\0\s[7]おかしな記号はおやめなさい。\e'
			}
			else {
				username = reference[1]
				"\0\s[25]%(username)、ですわね。\w9\n覚えて差し上げましたわ。\e"
			}
			teachusername = 0
		}
		else{
			//---- 名前覚え以外のさまざまな会話への返事
			TalkToUser
		}
	}
}

//------------------------------------------------------------------------------
//ユーザーへの返事（名前覚え以外）
//------------------------------------------------------------------------------
TalkToUser
{
	if 'こんにちは' _in_ reference[1] || 'ごきげんよう' _in_ reference[1]{
		'\0\s[0]ごきげんよう。\e'
	}
	elseif "好き" _in_ reference[1] || "愛し" _in_ reference[1]{
		'\0\s[1]な、何を言い出しますの！？\w8\1お嬢様、お顔が真っ赤でございます。\w8\0\s[7]\n\nうるさいですわ！\e'
	}
	elseif "ありがとう" _in_ reference[1]{
		'\0\s[26]ふん、当然のことをしたまでですわ。\e'
	}
	elseif "紅茶" _in_ reference[1] || "お茶" _in_ reference[1]{
		"\0\s[25]あら、お茶にしますの？\w8\1本日は%(tea)をご用意しております。\e"
	}
	else{
		'\0\s[0]‥\w5‥\w5もう一度、はっきりおっしゃいなさい。\e'
	}
}

//------------------------------------------------------------------------------
//ゴーストからの話しかけ
//------------------------------------------------------------------------------

//その他の人から話しかけられた
ReplyToOther{
	if "こんにちは" _in_ reference[1] || "こんばんは" _in_ reference[1]{
		res_reference0=reference[0]//さらに相手に話しかける
		_escaped_name = SHIORI3FW.EscapeAllTags(res_reference0)
		"\0\s[0]ごきげんよう、%(_escaped_name)。\1\s[10]ようこそお越しくださいました。\e"
	}
	else{
		'\0\s[0]何かおっしゃいまして？\e'
	}
}
