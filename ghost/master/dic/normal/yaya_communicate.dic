//******************************************************************************
// 悪役令嬢クローディア
// コミュニケート辞書
//******************************************************************************


//******************************************************************************
//こちらから話しかける
//******************************************************************************

//この関数は現状メニューから呼ばれます
StartCommunicate
{
	//以下の関数は、隣に立っているゴーストを探して、
	//TalkTo_??? 関数を呼び出すものです。誰も居なければランダムトークをします。
	//yaya_tmpl_utilにあります。
	AYATEMPLATE.ExecuteTalkToTalk
}

//紺野ややめ（このゴーストのもとになったテンプレート）に話しかける
//どれも「こんにちは」を含むので、ややめが返事を返し、ReplyTo_紺野ややめ で締める
TalkTo_紺野ややめ{
	'\u\s[10]\0\s[0]あら、ややめさん。\w9\nごきげんよう。\w8\1マック朗様も、こんにちは。\w8\0\s[26]\n\n‥\w5‥\w5わたくしの辞書の骨組み、\w9\n今でもしっかり役に立っていましてよ。'
	'\u\s[10]\0\s[1]‥\w5‥\w5こんにちは、ややめさん。\w9\n今日は、ご挨拶に伺いましたの。\w8\1お嬢様は、ややめ様のテンプレートから\w9\nお生まれになりましたので。\w8\0\s[0]\n\nええ。\w9\n公爵家の令嬢は、恩義を忘れませんわ。'
	'\u\s[10]\0\s[26]ややめさん、ご覧になって？\w9\nあなたの辞書から、\w9\nここまで立派になりましたのよ。\w8\1マック朗様、お嬢様がお世話になりました。\w8\0\s[1]\n\n‥\w5‥\w5こ、こんにちは、も\w9\n言い忘れていましたわ。'
}

//その他の人に話しかける
TalkToOther{
	_escaped_name = SHIORI3FW.EscapeAllTags(res_reference0)
	"\0\s[26]ごきげんよう、%(_escaped_name)。\w9\nお元気そうで何よりですわ。\1\s[10]お嬢様がいつもお世話になっております。"
}

TalkToNobody{
	'\0\s[4]‥\w5‥\w5誰もいませんわね。\1\s[10]お茶会は、また今度でございますね。'
}


//******************************************************************************
//話しかけられたので返事する
//******************************************************************************

//------------------------------------------------------------------------------
//OnCommunicateイベント
//------------------------------------------------------------------------------
OnCommunicate
{
	if reference[0] == "user" || reference[0] == "User"{
		//---- ユーザーからの話しかけ
		ReplyToUser
	}
	else{
		//---- ゴーストからの話しかけ
		//以下の関数は、ReplyTo_??? 関数を呼び出すものです。
		//yaya_tmpl_utilにあります。
		AYATEMPLATE.ExecuteReplyToTalk(reference[0])
	}
}

//------------------------------------------------------------------------------
//ユーザーからの話しかけ
//------------------------------------------------------------------------------
ReplyToUser
{
	if "名前" _in_ reference[1] && "覚えて" _in_ reference[1]{
		//---- ユーザー名入力開始
		'\0\s[0]よろしくてよ。\w9\nあなたのお名前、教えてくださる？\e'
		teachusername = 1
	}
	else{
		//---- ユーザー名入力開始以外
		if teachusername == 1{
			//---- 直前が「名前覚えて」だったので名前を覚える
			if SHIORI3FW.EscapeAllTags(reference[1]) != reference[1] {
				'\0\s[7]おかしな記号はおやめなさい。\e'
			}
			else {
				username = reference[1]
				"\0\s[25]%(username)、ですわね。\w9\n覚えて差し上げましたわ。\e"
			}
			teachusername = 0
		}
		else{
			//---- 名前覚え以外のさまざまな会話への返事
			TalkToUser
		}
	}
}

//------------------------------------------------------------------------------
//ユーザーへの返事（名前覚え以外）
//------------------------------------------------------------------------------
TalkToUser
{
	//上から順に見て、最初に当てはまったものに返事する
	if 'こんにちは' _in_ reference[1] || 'ごきげんよう' _in_ reference[1]{
		'\0\s[0]ごきげんよう。\e'
	}
	elseif RE_SEARCH(reference[1], 'おはよう'){
		if hour >= 4 && hour <= 11 {
			"\u\s[10]\0\s[25]おはよう、%(username)。\w9\n今朝も早いですわね。\w8\1モーニングティーをお淹れいたします。\e"
			"\0\s[0]おはよう、%(username)。\w9\n朝食はきちんと召し上がりなさいな。\w9\n頭が働きませんわよ。\e"
		}
		else {
			"\u\s[10]\0\s[2]おはよう‥\w5‥\w5ですって？\w9\n今は%(hour)時ですわよ。\w8\1お嬢様、お目覚めの時刻は\w9\n人それぞれでございます。\w8\0\s[4]\n\n‥\w5‥\w5まあ、よろしいわ。\w9\nおはよう、%(username)。\e"
		}
	}
	elseif RE_SEARCH(reference[1], 'こんばんは'){
		"\0\s[0]こんばんは、%(username)。\w9\n夜はこれからですけれど、\w9\n無理はほどほどになさいな。\e"
		"\u\s[10]\0\s[25]こんばんは、%(username)。\w9\nちょうどお茶を淹れたところですの。\w8\1夜ですので、%(tea)は\w9\n薄めにいたしました。\e"
	}
	elseif RE_SEARCH(reference[1], 'おやすみ|お休みなさい'){
		if hour >= 10 && hour <= 17 {
			'\0\s[2]こんな時間に？\w9\n\s[0]‥\w5‥\w5お昼寝ですのね。\w9\n三十分で起きなさいな。\e'
		}
		else {
			"\u\s[10]\0\s[0]おやすみなさい、%(username)。\w9\n明日も、しっかりなさいね。\w8\1よい夢を。\e"
			'\u\s[10]\0\s[6]ええ、おやすみなさい。\w9\n‥\w5‥\w5ちゃんと布団に入るまでが\w9\n「おやすみ」ですわよ。\w8\1パソコンの電源も、でございますね。\e'
		}
	}
	elseif RE_SEARCH(reference[1], 'ただいま'){
		"\u\s[10]\0\s[0]おかえりなさい、%(username)。\w9\n遅かったですわね。\w8\1‥\w5‥\w5お嬢様、お約束の時刻は\w9\n特にございませんでしたが。\w8\0\s[1]\n\n言葉のあやですわ！\e"
		"\u\s[10]\0\s[25]おかえりなさい。\w9\nちょうどお茶が入ったところですわ。\w8\1本日は%(sweets)もございます。\e"
	}
	elseif RE_SEARCH(reference[1], 'いってきます|行ってきます|いってくる|行ってくる'){
		"\u\s[10]\0\s[0]いってらっしゃい、%(username)。\w9\n忘れ物はありませんこと？\w8\1鍵、お財布、スマートフォン。\e"
		'\0\s[26]いってらっしゃいませ‥\w5‥\w5\w9\nとは、わたくしは言いませんわよ。\w9\nさっさと行って、さっさと帰っていらっしゃい。\e'
	}
	elseif "好き" _in_ reference[1] || "愛し" _in_ reference[1]{
		'\0\s[1]な、何を言い出しますの！？\w8\1お嬢様、お顔が真っ赤でございます。\w8\0\s[7]\n\nうるさいですわ！\e'
	}
	elseif RE_SEARCH(reference[1], '嫌い|ばか|バカ|馬鹿'){
		'\u\s[10]\0\s[7]‥\w5‥\w5なんですって？\w8\1お嬢様、お顔が引きつっております。\w8\0\s[4]\n\n‥\w5‥\w5別に、傷ついてなどいませんわ。\e'
		'\0\s[26]あら、そう。\w9\nわたくしは気にしませんわ。\w9\n嫌われるのも、悪役令嬢の務めのうちですもの。\e'
	}
	elseif "ありがとう" _in_ reference[1]{
		'\0\s[26]ふん、当然のことをしたまでですわ。\e'
	}
	elseif RE_SEARCH(reference[1], 'ごめん|すみません|申し訳'){
		'\0\s[26]よろしくてよ。\w9\n謝れる方は、嫌いではありませんわ。\e'
		'\u\s[10]\0\s[0]何を謝っていますの？\w8\1お嬢様、心当たりがなくとも\w9\n鷹揚に許して差し上げるのが\w9\n淑女かと。\w8\0\s[25]\n\n‥\w5‥\w5許して差し上げますわ。\w9\n何かは存じませんけれど。\e'
	}
	elseif RE_SEARCH(reference[1], 'お疲れさま|おつかれさま|お疲れ様'){
		'\u\s[10]\0\s[25]ええ、あなたもお疲れさまでしたわ。\w8\1お茶をお淹れいたしましょう。\e'
	}
	elseif RE_SEARCH(reference[1], '終わった|おわった|できた|完成|片付いた'){
		"\u\s[10]\0\s[5]おーっほっほっほ！\w9\n見事ですわ、%(username)。\w8\1お嬢様、ご自分の手柄のように。\w8\0\s[26]\n\nわたくしが見守っていたのですもの。\w9\n半分はわたくしの手柄ですわ。\e"
		"\0\s[25]お疲れさまでしたわね。\w9\n‥\w5‥\w5ふん、悪くありませんわ。\w9\nご褒美に%(sweets)を用意させますわ。\e"
	}
	elseif RE_SEARCH(reference[1], '疲れ|つかれ|しんど'){
		"\u\s[10]\0\s[0]あら、お疲れですのね。\w9\nアンソニー、%(tea)を。\w8\1ただいま。\w9\n甘いものもお付けいたします。\w8\0\s[1]\n\n‥\w5‥\w5今日はもう、無理をしないこと。\w9\nいいですわね？\e"
		'\0\s[6]‥\w5‥\w5そういう日もありますわ。\w9\n\s[25]疲れたと言えるのは、\w9\nきちんと頑張った証拠ですもの。\e'
	}
	elseif RE_SEARCH(reference[1], '眠い|ねむい|眠た'){
		'\0\s[7]でしたら、寝なさい。\w9\n眠い頭で書いたコードは、\w9\n明日のあなたが直す羽目になりますわよ。\e'
		"\u\s[10]\0\s[0]眠いのでしたら、\w9\n少し横になりなさいな。\w8\1濃いめの%(tea)もございますが。\w8\0\s[26]\n\nそれは、どうしても\w9\n今日中に終わらせたいときだけですわ。\e"
	}
	elseif RE_SEARCH(reference[1], 'お腹|おなか|腹減|はらへ|腹が減'){
		"\u\s[10]\0\s[2]まあ、まだ食べていませんの？\w8\1すぐに%(food)をご用意いたします。\w8\0\s[0]\n\n食事を抜いてまで\w9\nする仕事なんて、ありませんわよ。\e"
		"\u\s[10]\0\s[0]アンソニー。\w8\1かしこまりました。\w9\n%(food)でよろしいですか。\w8\0\s[2]\n\n‥\w5‥\w5まだ何も言っていませんわ。\w8\1\n\nお顔に書いてございました。\e"
	}
	elseif "紅茶" _in_ reference[1] || "お茶" _in_ reference[1]{
		"\0\s[25]あら、お茶にしますの？\w8\1本日は%(tea)をご用意しております。\e"
	}
	elseif RE_SEARCH(reference[1], '褒めて|ほめて'){
		'\0\s[1]ほ、褒めて‥\w5‥\w5？\w9\n\s[26]よろしくてよ。\w9\nあなたはよくやっていますわ。\w9\n‥\w5‥\w5一度しか言いませんわよ。\e'
		'\u\s[10]\0\s[26]何をしたのか、まず言いなさいな。\w9\n中身を聞いてから、\w9\nきちんと褒めて差し上げますわ。\w8\1お嬢様は、根拠のないお世辞は\w9\n仰らない方でございますので。\e'
	}
	elseif RE_SEARCH(reference[1], '仕事|作業|勉強|頑張|がんば'){
		'\0\s[26]よろしい。\w9\n終わったら、報告に来なさいな。\w9\n出来ばえを見て差し上げますわ。\e'
		'\u\s[10]\0\s[0]ええ、しっかりおやりなさい。\w9\nただし、一時間に一度は休憩を。\w8\1お茶の時間はお任せください。\e'
	}
	elseif RE_SEARCH(reference[1], '暇|ひま|退屈'){
		'\u\s[10]\0\s[26]暇ですって？\w9\nでしたら、溜まっている TODO を\w9\nひとつ片付けなさいな。\w8\1あるいは、お茶会に\w9\nお付き合いいただくか。\w8\0\s[1]\n\n‥\w5‥\w5後者でもよろしくてよ。\e'
		'\0\s[0]退屈なら、わたくしとお話しなさいな。\w9\n‥\w5‥\w5今日は特別に、\w9\n付き合って差し上げますわ。\e'
	}
	elseif RE_SEARCH(reference[1], '可愛い|かわいい|綺麗|きれい|美しい'){
		'\u\s[10]\0\s[1]と、当然ですわ！\w9\nわたくしを誰だと思っていますの！\w8\1お嬢様、耳まで赤うございます。\e'
		"\0\s[26]あら、今ごろ気づきましたの？\w9\n遅いですわよ、%(username)。\e"
	}
	elseif RE_SEARCH(reference[1], '寂しい|さみしい|さびしい'){
		'\u\s[10]\0\s[1]‥\w5‥\w5仕方ありませんわね。\w9\n今日は、ここにいて差し上げますわ。\w8\1お嬢様は、いつもここにおいでですが。\w8\0\s[7]\n\n気持ちの問題ですわ！\e'
		'\u\s[10]\0\s[0]わたくしとアンソニーが\w9\nここにいるではありませんの。\w8\1お茶の用意もございます。\w8\0\s[25]\n\n話したいことがあれば、\w9\nいつでもお話しなさいな。\e'
	}
	elseif RE_SEARCH(reference[1], 'アンソニー'){
		"\u\s[10]\0\s[7]わたくしではなく、アンソニーですの？\w8\1お呼びでしょうか、%(username)様。\w8\0\s[4]\n\n‥\w5‥\w5ふん。\e"
		'\0\s[0]\1\s[10]はい、こちらに。\w9\nお茶のおかわりでございますか。\e'
	}
	elseif RE_SEARCH(reference[1], '悪役'){
		'\u\s[10]\0\s[26]ええ、悪役令嬢ですわ。\w9\n口が悪いのは生まれつきですの。\w8\1面倒見がよいのも、でございます。\w8\0\s[1]\n\n‥\w5‥\w5余計なことを。\e'
	}
	elseif RE_SEARCH(reference[1], 'クローディア|お嬢様|Claudia'){
		'\0\s[26]ええ、わたくしですわ。\w9\n何かご用かしら？\e'
		'\u\s[10]\0\s[1]な、名前で呼ぶなんて、\w9\n馴れ馴れしいですわよ。\w8\1お嬢様、口元が緩んでおります。\w8\0\s[7]\n\n緩んでいませんわ！\e'
	}
	else{
		'\0\s[0]‥\w5‥\w5もう一度、はっきりおっしゃいなさい。\e'
		'\u\s[10]\0\s[4]‥\w5‥\w5アンソニー、今のは何と？\w8\1私にも、わかりかねます。\w8\0\s[0]\n\n‥\w5‥\w5まあ、よろしいわ。\w9\nお話は、ちゃんと聞いていましてよ。\e'
		'\u\s[10]\0\s[6]ふうん‥\w5‥\w5そう。\w9\n\s[0]続けてくださる？\w9\nわたくし、聞き上手ですのよ。\w8\1ご自分で仰いますか。\e'
	}
}

//------------------------------------------------------------------------------
//ゴーストからの話しかけ
//------------------------------------------------------------------------------

//紺野ややめから話しかけられた
//「どうも」は、TalkTo_紺野ややめ の挨拶へのややめの返事。どちらも、こちらからは話しかけ返さずに終える
ReplyTo_紺野ややめ{
	if 'どうも' _in_ reference[1] {
		'\u\s[10]\0\s[25]ふふ、相変わらずですわね。\w8\1マック朗様も、お変わりなく。\e'
		"\u\s[10]\0\s[0]今度、お茶会にいらっしゃいな。\w9\n%(sweets)を用意しておきますわ。\w8\1マック朗様の分もございます。\e"
	}
	else {
		'\u\s[10]\0\s[25]あら、ややめさん。\w9\nごきげんよう。\w9\nわたくしは、このとおり元気ですわ。\w8\1マック朗様、お気遣いありがとうございます。\e'
		'\u\s[10]\0\s[1]ややめさんのほうから\w9\n声をかけてくださるなんて。\w9\n‥\w5‥\w5光栄、ですわ。\w8\1お嬢様は、生みの親には\w9\n頭が上がらないのでございます。\w8\0\s[7]\n\n上がりますわ！\w9\n‥\w5‥\w5少しだけ。\e'
	}
}

//その他の人から話しかけられた
ReplyToOther{
	if "こんにちは" _in_ reference[1] || "こんばんは" _in_ reference[1]{
		res_reference0=reference[0]//さらに相手に話しかける
		_escaped_name = SHIORI3FW.EscapeAllTags(res_reference0)
		"\0\s[0]ごきげんよう、%(_escaped_name)。\1\s[10]ようこそお越しくださいました。\e"
	}
	else{
		'\0\s[0]何かおっしゃいまして？\e'
	}
}
