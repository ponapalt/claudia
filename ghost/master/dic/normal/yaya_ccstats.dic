//******************************************************************************
// 悪役令嬢クローディア
// Claude Code の功績録辞書
//******************************************************************************
//
//これまでの働きを数えて、功績録、称号、節目のお祝い、期間ごとの業務報告として読み上げる。
//好かれ具合ではなく、やってきたことを数えて称える。数える元は 2 つ。
//
//1. Claude Code の依頼の履歴 %USERPROFILE%\.claude\history.jsonl（CCS.Hist*）
//   送った依頼が 1 行に 1 件ずつ入っている。中身はこういう 1 行の JSON。
//
//     {"display":"...","pastedContents":{...},"timestamp":1790311762291,
//      "project":"C:\\path\\to\\project","sessionId":"..."}
//
//   1 行ずつ PARSEJSON（YAYA 600 系）でハッシュにして（CC.ParseJSON）、
//   数えるのに使うのは timestamp（ミリ秒）と project だけ。display（依頼の本文）は
//   読み上げない。作業フォルダごとの数は、名前をキーにしたハッシュ（ccshproj）に入れる。
//   Claude Code の内部のファイルで仕様は公開されていないので、形が変わって
//   読めなくなったら、2 の数字だけで話す。
//   行は時刻の順に足されていくので、読み終えた位置（ccshpos）を覚えておき、次からは
//   増えた分だけを読む。位置がずれても数え直さないよう、最後に数えた行の時刻
//   （ccshlast）より古い行は飛ばす。最初の読み込みは重いので、OnMinuteChange から
//   少しずつ読み進める（CCS.Minute）。
//
//2. このゴーストが見張りの中で数えるもの（CCS.Count。yaya_claudecode.dic から呼ぶ）
//   返事待ちに応えた回数、大仕事の完了、長考、Claude が働いた時間、続けて作業した
//   時間、開いたセッション、休憩を勧めた回数。数え始めたのは ccssince から。
//   番外の称号のために、なでた・つついた回数（yaya_mouse.dic）、最小化した回数
//   （yaya_bootend.dic）、功績録を開いた回数も数える。
//
//称号は 2 種類。まっとうな称号（CCS.Titles）と、番外の称号（CCS.OddTitles）。
//番外の称号は功績録の最後の頁に並べ、一度にいくつも届いたら授与のトークを 1 回にまとめる。
//番外の称号のうち日付や依頼の間を見るものは、それを足す前に読み終えていた履歴を
//CCS.Backfill で一度だけ読み直して数える（ほかの数には触らない）。
//
//「本日」は午前 4 時で区切る（夜更かしの作業を前の日に入れるため。CCS.DayKey）。
//
//業務報告（功績録の 1 頁目）は、選んだ期間について履歴を読み直して数える（CCS.Span）。
//2 の数は日ごとの合計を、日が変わるときに ccsdlog に残す（CCS.RollDay）。
//残し始めたのは ccsdlogsince からで、それより前の日の分は無い。
//
//注意: YAYA では関数を裸の文で呼ぶと、その戻り値もブロックの出力候補になる。
//副作用だけの関数（CCS.Init、CCS.Count、CCS.HistRead など）は値を返さないように書いてある。
//******************************************************************************


//******************************************************************************
//下ごしらえ
//******************************************************************************

//------------------------------------------------------------------------------
//変数の初期値を入れる。値は返さない（裸で呼ぶため）
//------------------------------------------------------------------------------
CCS.Init
{
	_names = ( /
		'ccshpos', 'ccshlast', 'ccshn', 'ccshfirst', 'ccshdays', 'ccshdaykey', 'ccshdayn', /
		'ccshstreak', 'ccshstreakmax', 'ccshdaymax', 'ccshdaymaxkey', 'ccshready', /
		'ccsanswer', 'ccsdone', 'ccslong', 'ccsbusy', 'ccswork', 'ccsworkmax', /
		'ccsnew', 'ccslate', 'ccsbreak', 'ccsday', /
		'ccsd_answer', 'ccsd_done', 'ccsd_busy', 'ccsd_work', 'ccsd_new', /
		'ccsmile', 'ccsanniv', 'ccshsn', /
		'ccsnade', 'ccsrude', 'ccscookie', 'ccshide', 'ccsrecord', /
		'ccsbpos', 'ccsbprev', /
		'ccshwkend', 'ccshxmas', 'ccshnewyear', 'ccshfri13', 'ccshrapid', 'ccshreturn' /
	)
	_name  = ''
	_i     = 0

	//---- 番外の称号のために、読み終えた履歴を読み直す範囲（CCS.Backfill）
	//---- 初めて呼ばれたときの読み終えた位置まで。それより後は CCS.HistLine が数える
	if !ISVAR('ccsbdone') {
		ccsbdone = 0
		ccsbend  = 0
		if ISVAR('ccshlast') {
			ccsbend = ccshlast
		}
		if ccsbend <= 0 {
			ccsbdone = 1
		}
	}
	foreach _names ; _name {
		if !ISVAR(_name) {
			LETTONAME(_name, 0)
		}
	}
	if !ISVAR('ccssince') || ccssince <= 0 {
		ccssince = GETSECCOUNT
	}
	//---- 時刻ごとの依頼の数（0 時台から 23 時台まで）
	if ARRAYSIZE(ccshhour) != 24 {
		ccshhour = IARRAY
		for _i = 0 ; _i < 24 ; _i++ {
			ccshhour ,= 0
		}
	}
	//---- 作業フォルダの名前ごとの依頼の数
	//---- 前の版では名前と数を別々の配列（ccshpname / ccshpcount）に入れていたので、移し替える
	if GETTYPE(ccshproj) != 5 {
		ccshproj = IHASH()
		if ISVAR('ccshpname') {
			foreach ccshpname ; _i, _name {
				ccshproj[_name] = TOINT(ccshproj[_name]) + TOINT(ccshpcount[_i])
			}
			ERASEVAR('ccshpname', 'ccshpcount')
		}
	}
	//---- すでに授けた称号の ID
	if !ISVAR('ccstitles') {
		ccstitles = IARRAY
	}
	//---- 見届けた数の日ごとの記録（CCS.RollDay）。キーは業務日の番号、値は
	//---- 「返事待ち,大仕事,働いた秒数,作業した秒数,セッション」。ccsdlogsince から残している
	if GETTYPE(ccsdlog) != 5 {
		ccsdlog      = IHASH()
		ccsdlogsince = ccsday
		if ccsdlogsince <= 0 {
			ccsdlogsince = CCS.Today
		}
	}
	//---- 履歴の月ごとの読み始めの位置（CCS.Span）。キーは 202609 の形の月
	if GETTYPE(ccshmpos) != 5 {
		ccshmpos = IHASH()
	}
	//---- 業務報告の期間（CCS.PeriodRange）と、指定した期間の始まりと終わり
	if !ISVAR('ccsperiod') {
		ccsperiod = 'today'
	}
	if !ISVAR('ccsqfrom') {
		ccsqfrom = 0
		ccsqto   = 0
	}
}

//------------------------------------------------------------------------------
//業務日の番号（20260925 の形）。午前 4 時までは前の日として数える
//  _argv[0] Unix 秒
//------------------------------------------------------------------------------
CCS.DayKey
{
	_t = GETTIME(_argv[0] - 14400)
	_t[0] * 10000 + _t[1] * 100 + _t[2]
}

//---- 今日の業務日の番号
CCS.Today
{
	CCS.DayKey(GETSECCOUNT)
}

//---- 業務日の番号を「2026年9月25日」にする
CCS.DateText
{
	_key = TOINT(_argv[0])
	TOINT(_key / 10000) + '年' + TOINT((_key / 100) % 100) + '月' + (_key % 100) + '日'
}

//---- Unix 秒を「2026年9月25日」にする（こちらは午前 4 時で区切らない）
CCS.SecDate
{
	_t = GETTIME(_argv[0])
	_t[0] + '年' + _t[1] + '月' + _t[2] + '日'
}

//------------------------------------------------------------------------------
//数を 3 桁ごとに区切る（6829 → 6,829）
//------------------------------------------------------------------------------
CCS.Comma
{
	_s    = TOSTR(TOINT(_argv[0]))
	_text = ''

	while STRLEN(_s) > 3 {
		_text = ',' + SUBSTR(_s, STRLEN(_s) - 3, 3) + _text
		_s    = SUBSTR(_s, 0, STRLEN(_s) - 3)
	}
	_s + _text
}

//------------------------------------------------------------------------------
//日が変わっていたら、本日の分を 0 に戻す。値は返さない
//------------------------------------------------------------------------------
CCS.RollDay
{
	_today = CCS.Today

	CCS.Init
	if ccsday != _today {
		//---- 前の日の分を、期間の業務報告のために残す
		if ccsday > 0 && ccsd_answer + ccsd_done + ccsd_busy + ccsd_work + ccsd_new > 0 {
			ccsdlog[TOSTR(ccsday)] = ccsd_answer + ',' + ccsd_done + ',' + ccsd_busy + ',' + ccsd_work + ',' + ccsd_new
		}
		ccsday      = _today
		ccsd_answer = 0
		ccsd_done   = 0
		ccsd_busy   = 0
		ccsd_work   = 0
		ccsd_new    = 0
	}
}


//******************************************************************************
//ゴーストが自分で数えるもの（yaya_claudecode.dic から呼ぶ）
//******************************************************************************

//------------------------------------------------------------------------------
//数を足す。値は返さない（裸で呼ぶため）
//  _argv[0] 何を数えるか / _argv[1] 足す数（秒数など。省略すると 1）
//    answer 返事待ちに応えた（waiting から busy に戻った）
//    done   大仕事（90 秒以上）が片付いた
//    long   10 分を超える長考が片付いた
//    busy   Claude が働いた秒数
//    work   続けて作業していた秒数（CC.MarkWork の区切りの中で）
//    new    新しいセッションが立ち上がった
//    late   そのうち夜更け（CC.IsLate）のもの
//    break  休憩を勧めた
//    nade   クローディアの頭や髪をなでた（yaya_mouse.dic から）
//    rude   クローディアの胸元や裾に触れた（yaya_mouse.dic から）
//    cookie アンソニーのトレイに手を出した（yaya_mouse.dic から）
//    hide   ユーザーが最小化した（yaya_bootend.dic から）
//    record 功績録を開いた（CCS.Record から）
//------------------------------------------------------------------------------
CCS.Count
{
	_n = 1

	if _argc >= 2 {
		_n = TOINT(_argv[1])
	}
	CCS.RollDay
	case _argv[0] {
		when 'answer' {
			ccsanswer   += _n
			ccsd_answer += _n
		}
		when 'done' {
			ccsdone   += _n
			ccsd_done += _n
		}
		when 'long' {
			ccslong += _n
		}
		when 'busy' {
			ccsbusy   += _n
			ccsd_busy += _n
		}
		when 'work' {
			ccswork   += _n
			ccsd_work += _n
		}
		when 'new' {
			ccsnew   += _n
			ccsd_new += _n
		}
		when 'late' {
			ccslate += _n
		}
		when 'break' {
			ccsbreak += _n
		}
		when 'nade' {
			ccsnade += _n
		}
		when 'rude' {
			ccsrude += _n
		}
		when 'cookie' {
			ccscookie += _n
		}
		when 'hide' {
			ccshide += _n
		}
		when 'record' {
			ccsrecord += _n
		}
	}
}

//------------------------------------------------------------------------------
//続けて作業した時間の最長記録を更新する。値は返さない
//  _argv[0] 今の区切りで続けて作業している秒数
//------------------------------------------------------------------------------
CCS.WorkSpan
{
	CCS.Init
	if _argv[0] > ccsworkmax {
		ccsworkmax = _argv[0]
	}
}


//******************************************************************************
//依頼の履歴（history.jsonl）
//******************************************************************************

//---- 履歴のファイルの場所。見つからなければ空文字列
CCS.HistPath
{
	_home = GETENV('USERPROFILE')
	_path = ''
	if STRLEN(_home) > 0 {
		_path = REPLACE(_home, '\', '/') + '/.claude/history.jsonl'
	}
	_path
}

//------------------------------------------------------------------------------
//読み残しがあれば 1
//------------------------------------------------------------------------------
CCS.HistPending
{
	_path = CCS.HistPath
	_size = 0
	_is   = 0

	CCS.Init
	if STRLEN(_path) > 0 {
		_size = FSIZE(_path)
		if _size > 0 && _size != ccshpos {
			_is = 1
		}
	}
	_is
}

//------------------------------------------------------------------------------
//履歴を読み進める。値は返さない（裸で呼ぶため）
//  _argv[0] 一度に読む行数の上限
//------------------------------------------------------------------------------
CCS.HistRead
{
	_path  = CCS.HistPath
	_size  = 0
	_line  = ''
	_n     = 0
	_pos   = 0

	CCS.Init
	if STRLEN(_path) > 0 {
		_size = FSIZE(_path)
	}
	if _size > 0 && _size != ccshpos {
		//---- ファイルが縮んだ（作り直された）ら頭から。数えた分は ccshlast で飛ばす
		//---- 月ごとの読み始めの位置（CCS.Span）も使えなくなる
		if _size < ccshpos {
			ccshpos  = 0
			ccshmpos = IHASH()
		}
		if FOPEN(_path, 'r') {
			if ccshpos > 0 {
				void FSEEK(_path, ccshpos, 'SEEK_SET')
			}
			while _n < _argv[0] {
				_line = FREAD(_path)
				if _line == -1 {
					break
				}
				CCS.HistLine(_line)
				_n++
			}
			_pos = FTELL(_path)
			void FCLOSE(_path)
			if _pos > 0 {
				ccshpos = _pos
			}
		}
		//---- 最初に全部を読み終えたら、それまでの節目は祝わずに済ませる
		if ccshready != 1 && ccshpos == _size {
			ccshready = 1
			CCS.QuietMilestones
		}
	}
}

//------------------------------------------------------------------------------
//履歴の 1 行を数える。値は返さない
//------------------------------------------------------------------------------
CCS.HistLine
{
	_h    = CC.ParseJSON(_argv[0])
	_ms   = TOINT(_h['timestamp'])
	_prev = 0
	_sec  = 0
	_t    = IARRAY
	_key  = 0
	_name = ''

	//---- 読めない行（形が変わったときなど）と、もう数えた行は数えない
	if _ms <= 0 || _ms <= ccshlast {
		return
	}
	_prev    = ccshlast / 1000
	ccshlast = _ms
	_sec     = _ms / 1000
	CCS.HistOdd(_sec, _prev)

	ccshn += 1
	//---- ゴーストが数え始めてからの依頼（セッションの数と比べるため）
	if _sec >= ccssince {
		ccshsn += 1
	}
	if ccshfirst <= 0 || _sec < ccshfirst {
		ccshfirst = _sec
	}
	_t = GETTIME(_sec)
	ccshhour[_t[4]] += 1

	//---- 登城した日と、続けて登城した日数
	_key = CCS.DayKey(_sec)
	if _key != ccshdaykey {
		ccshdays += 1
		if ccshdaykey == CCS.DayKey(_sec - 86400) {
			ccshstreak += 1
		}
		else {
			ccshstreak = 1
		}
		if ccshstreak > ccshstreakmax {
			ccshstreakmax = ccshstreak
		}
		ccshdaykey = _key
		ccshdayn   = 0
	}
	ccshdayn += 1
	if ccshdayn > ccshdaymax {
		ccshdaymax    = ccshdayn
		ccshdaymaxkey = _key
	}

	//---- 作業フォルダごとの数（無いキーに += 1 すると文字列の 1 になるので TOINT を挟む）
	_name = CC.Label('', _h['project'])
	if STRLEN(_name) > 0 {
		ccshproj[_name] = TOINT(ccshproj[_name]) + 1
	}
}

//------------------------------------------------------------------------------
//番外の称号のために、依頼 1 件の日時を数える。値は返さない
//  _argv[0] この依頼の Unix 秒 / _argv[1] ひとつ前の依頼の Unix 秒（無ければ 0）
//------------------------------------------------------------------------------
CCS.HistOdd
{
	_sec  = TOINT(_argv[0])
	_prev = TOINT(_argv[1])
	_t    = GETTIME(_sec)
	_d    = GETTIME(_sec - 14400)

	//---- 土日（業務日で。金曜の深夜は金曜のうち）
	if _d[3] == 0 || _d[3] == 6 {
		ccshwkend += 1
	}
	//---- 日付はカレンダーのまま
	if _t[1] == 12 && (_t[2] == 24 || _t[2] == 25) {
		ccshxmas += 1
	}
	if _t[1] == 1 && _t[2] == 1 {
		ccshnewyear += 1
	}
	if _t[2] == 13 && _t[3] == 5 {
		ccshfri13 += 1
	}
	//---- 前の依頼からの間
	if _prev > 0 {
		if _sec - _prev <= 3 {
			ccshrapid += 1
		}
		if _sec - _prev >= 30 * 86400 {
			ccshreturn += 1
		}
	}
}

//------------------------------------------------------------------------------
//番外の称号を足す前に読み終えていた履歴を、番外の分だけ数え直す。値は返さない
//ほかの数（ccshn など）には触らない。ccsbend の時刻の行まで読んだら終わり
//  _argv[0] 一度に読む行数の上限
//------------------------------------------------------------------------------
CCS.Backfill
{
	_path = CCS.HistPath
	_size = 0
	_line = ''
	_h    = IHASH()
	_ms   = 0
	_n    = 0
	_pos  = 0

	CCS.Init
	if ccsbdone == 1 {
		return
	}
	if STRLEN(_path) > 0 {
		_size = FSIZE(_path)
	}
	//---- 履歴が無い、または作り直されて縮んだときは、あきらめる
	if _size <= 0 || _size < ccsbpos {
		ccsbdone = 1
		return
	}
	if FOPEN(_path, 'r') {
		if ccsbpos > 0 {
			void FSEEK(_path, ccsbpos, 'SEEK_SET')
		}
		while _n < _argv[0] {
			_line = FREAD(_path)
			if _line == -1 {
				ccsbdone = 1
				break
			}
			_n++
			_h  = CC.ParseJSON(_line)
			_ms = TOINT(_h['timestamp'])
			if _ms <= 0 {
				continue
			}
			if _ms > ccsbend {
				ccsbdone = 1
				break
			}
			CCS.HistOdd(_ms / 1000, ccsbprev)
			ccsbprev = _ms / 1000
		}
		_pos = FTELL(_path)
		void FCLOSE(_path)
		if _pos > 0 {
			ccsbpos = _pos
		}
	}
}

//------------------------------------------------------------------------------
//本日の依頼の数
//------------------------------------------------------------------------------
CCS.TodayRequests
{
	_n = 0
	if ccshdaykey == CCS.Today {
		_n = ccshdayn
	}
	_n
}

//------------------------------------------------------------------------------
//いちばん依頼の多い作業フォルダ。ハッシュで name 名前 / count 数。無ければ空のハッシュ
//------------------------------------------------------------------------------
CCS.TopProject
{
	_top  = IHASH()
	_name = ''
	_n    = 0

	foreach ccshproj ; _name, _n {
		if HASH_SIZE(_top) == 0 || _n > _top['count'] {
			_top = IHASH('name', _name, 'count', _n)
		}
	}
	_top
}

//------------------------------------------------------------------------------
//いちばん依頼の多い時刻（時）。履歴が無ければ -1
//------------------------------------------------------------------------------
CCS.PeakHour
{
	_best = -1
	_i    = 0
	_n    = 0

	foreach ccshhour ; _i, _n {
		if _n > 0 && (_best < 0 || _n > ccshhour[_best]) {
			_best = _i
		}
	}
	_best
}

//------------------------------------------------------------------------------
//_argv[0] 時台から _argv[1] 時台までの依頼の数
//------------------------------------------------------------------------------
CCS.HourSum
{
	_sum  = 0
	_i    = TOINT(_argv[0])
	_last = TOINT(_argv[1])

	while _i <= _last {
		_sum += ccshhour[_i]
		_i++
	}
	_sum
}


//******************************************************************************
//期間の業務報告のための集計
//******************************************************************************

//---- 業務日の番号の日の正午の Unix 秒
CCS.KeySec
{
	_key = TOINT(_argv[0])
	GETSECCOUNT(_key / 10000, (_key / 100) % 100, _key % 100, 12, 0, 0)
}

//---- 業務日の番号に日数を足す（引くときは負の数）
CCS.KeyAdd
{
	CCS.DayKey(CCS.KeySec(_argv[0]) + TOINT(_argv[1]) * 86400 + 14400)
}

//---- _argv[0] の日から _argv[1] の日までの日数（両端を含む）
CCS.KeyDays
{
	(CCS.KeySec(_argv[1]) - CCS.KeySec(_argv[0]) + 43200) / 86400 + 1
}

//---- 業務日の番号を「10月4日（日）」にする
//  _argv[1] が 1 なら「2026年10月4日」、2 なら「10月4日」（どちらも曜日なし）
CCS.KeyText
{
	_key = TOINT(_argv[0])
	_t   = GETTIME(CCS.KeySec(_key))

	if _argv[1] == 1 {
		return CCS.DateText(_key)
	}
	if _argv[1] == 2 {
		return _t[1] + '月' + _t[2] + '日'
	}
	_t[1] + '月' + _t[2] + '日（' + SUBSTR('日月火水木金土', _t[3], 1) + '）'
}

//------------------------------------------------------------------------------
//業務報告の期間。ID と名前を同じ順に並べる（CCS.PeriodBar）
//------------------------------------------------------------------------------
CCS.PeriodIDs
{
	('today', 'yesterday', 'week', 'lastweek', 'month', 'lastmonth', 'year', 'custom')
}

CCS.PeriodNames
{
	('本日', '昨日', '今週', '先週', '今月', '先月', '今年', '指定')
}

//------------------------------------------------------------------------------
//期間の始まりと終わりの業務日の番号を、配列で返す
//  _argv[0] 期間の ID（CCS.PeriodIDs）。週は月曜に始まる
//  custom は ccsqfrom から ccsqto まで。まだ指定されていなければ本日
//------------------------------------------------------------------------------
CCS.PeriodRange
{
	_today = CCS.Today
	_t     = GETTIME(CCS.KeySec(_today))
	_mon   = CCS.KeyAdd(_today, -((_t[3] + 6) % 7))
	_first = _t[0] * 10000 + _t[1] * 100 + 1
	_from  = _today
	_to    = _today

	case _argv[0] {
		when 'yesterday' {
			_from = CCS.KeyAdd(_today, -1)
			_to   = _from
		}
		when 'week' {
			_from = _mon
		}
		when 'lastweek' {
			_from = CCS.KeyAdd(_mon, -7)
			_to   = CCS.KeyAdd(_mon, -1)
		}
		when 'month' {
			_from = _first
		}
		when 'lastmonth' {
			_to   = CCS.KeyAdd(_first, -1)
			_from = (_to / 100) * 100 + 1
		}
		when 'year' {
			_from = _t[0] * 10000 + 101
		}
		when 'custom' {
			if ccsqfrom > 0 && ccsqto > 0 {
				_from = ccsqfrom
				_to   = ccsqto
			}
		}
	}
	(_from, _to)
}

//------------------------------------------------------------------------------
//月ごとの読み始めの位置の索引（ccshmpos）から、_argv[0] の月かそれより前で
//いちばん近い月を探す。配列で (位置, その月)。使える月が無ければ (0, 0)
//------------------------------------------------------------------------------
CCS.MonthPos
{
	_want = TOINT(_argv[0])
	_best = 0
	_pos  = 0
	_m    = ''
	_p    = 0

	foreach ccshmpos ; _m, _p {
		if TOINT(_m) <= _want && TOINT(_m) > _best {
			_best = TOINT(_m)
			_pos  = TOINT(_p)
		}
	}
	(_pos, _best)
}

//------------------------------------------------------------------------------
//期間の依頼を、履歴（history.jsonl）を読み直して数える
//  _argv[0] 始まり / _argv[1] 終わり（業務日の番号）
//  ハッシュで返す
//    n 依頼 / days 登城した日 / max 一日の最多 / maxkey その日 / late 深夜（0〜4時台）/
//    peak よく働く時刻（依頼が無ければ -1）/ lands 作業フォルダの数 /
//    p0〜p2、c0〜c2 依頼の多い作業フォルダの名前と数（無い分は空文字列と 0）
//
//  時刻と作業フォルダは JSON を解かずに文字列で拾う。行は時刻の順に並ぶが、
//  少し前後しても取りこぼさないよう、終わりの次の日を越えた行が出てから読むのをやめる。
//  月の頭の行の位置を ccshmpos に覚えておき、次からは始まりの前の月の頭から読む。
//  覚えた位置の行がその月でなければ（履歴が作り直されたなど）、索引を捨てて頭から読む
//------------------------------------------------------------------------------
CCS.Span
{
	_from  = TOINT(_argv[0])
	_to    = TOINT(_argv[1])
	_stop  = CCS.KeyAdd(_to, 1)
	_path  = CCS.HistPath
	_seek  = IARRAY
	_check = 0
	_prevm = 0
	_pos   = 0
	_line  = ''
	_i     = 0
	_ms    = 0
	_key   = 0
	_m     = 0
	_j     = 0
	_t     = IARRAY
	_name  = ''
	_n     = 0
	_days  = 0
	_max   = 0
	_maxkey = 0
	_late  = 0
	_daykey = 0
	_dayn  = 0
	_hour  = IARRAY
	_proj  = IHASH()
	_r     = IHASH()
	_top   = IARRAY
	_best  = ''
	_c     = 0
	_k     = 0

	for _i = 0 ; _i < 24 ; _i++ {
		_hour ,= 0
	}
	CCS.Init
	if STRLEN(_path) > 0 && FSIZE(_path) > 0 && FOPEN(_path, 'r') {
		_seek = CCS.MonthPos(CCS.KeyAdd(_from, -1) / 100)
		if _seek[0] > 0 && _seek[0] < FSIZE(_path) {
			void FSEEK(_path, _seek[0], 'SEEK_SET')
			_check = _seek[1]
		}
		while 1 {
			_pos  = FTELL(_path)
			_line = FREAD(_path)
			if _line == -1 {
				break
			}
			_i = STRSTR(_line, '"timestamp":', 0)
			if _i < 0 {
				continue
			}
			_ms = TOINT(SUBSTR(_line, _i + 12, 20))
			if _ms <= 0 {
				continue
			}
			_key = CCS.DayKey(_ms / 1000)
			_m   = _key / 100

			//---- 索引で飛んだ先がその月の頭でなければ、索引を捨てて頭から読み直す
			if _check > 0 {
				if _m != _check {
					ccshmpos = IHASH()
					_prevm   = 0
					void FSEEK(_path, 0, 'SEEK_SET')
					_check = 0
					continue
				}
				_check = 0
				_prevm = _m
			}
			//---- 月の頭の行の位置を覚える（頭から読んだか、前の月から読み続けたときだけ）
			if _m > _prevm {
				if (_prevm > 0 || _pos == 0) && !HASH_EXIST(ccshmpos, TOSTR(_m)) {
					ccshmpos[TOSTR(_m)] = _pos
				}
				_prevm = _m
			}

			if _key > _stop {
				break
			}
			if _key < _from || _key > _to {
				continue
			}
			_n += 1
			if _key != _daykey {
				_days  += 1
				_daykey = _key
				_dayn   = 0
			}
			_dayn += 1
			if _dayn > _max {
				_max    = _dayn
				_maxkey = _key
			}
			_t = GETTIME(_ms / 1000)
			_hour[_t[4]] += 1
			if _t[4] <= 4 {
				_late += 1
			}
			//---- 作業フォルダも文字列のまま拾う（JSON を解くと 1 年分で 1 秒ほどかかるため）
			//---- 円記号は \\ と重なったままだが、CC.ProjectName は最後の区切りの後ろだけを取るので同じ名前になる
			_name = ''
			_i    = STRSTR(_line, '"project":"', 0)
			if _i >= 0 {
				_j    = STRSTR(_line, '"', _i + 11)
				_name = CC.Label('', SUBSTR(_line, _i + 11, _j - _i - 11))
			}
			if STRLEN(_name) > 0 {
				_proj[_name] = TOINT(_proj[_name]) + 1
			}
		}
		void FCLOSE(_path)
	}

	_r = IHASH('n', _n, 'days', _days, 'max', _max, 'maxkey', _maxkey, 'late', _late, 'peak', -1, 'lands', HASH_SIZE(_proj))
	for _i = 0 ; _i < 24 ; _i++ {
		if _hour[_i] > 0 && (_r['peak'] < 0 || _hour[_i] > _hour[_r['peak']]) {
			_r['peak'] = _i
		}
	}
	//---- 依頼の多い作業フォルダを 3 つまで
	for _k = 0 ; _k < 3 ; _k++ {
		_best = ''
		_c    = 0
		foreach _proj ; _name, _i {
			if ASEARCH(_name, _top) < 0 && _i > _c {
				_best = _name
				_c    = _i
			}
		}
		if _c > 0 {
			_top ,= _best
		}
		_r['p' + _k] = _best
		_r['c' + _k] = _c
	}
	_r
}

//------------------------------------------------------------------------------
//期間のうち、わたくしどもが見届けた数を合わせる（日ごとの記録 ccsdlog と本日の分）
//  _argv[0] 始まり / _argv[1] 終わり（業務日の番号）
//  配列で (返事待ちに応えた, 大仕事の完了, 働いた秒数, 作業した秒数, セッション)
//------------------------------------------------------------------------------
CCS.SpanWatch
{
	_from = TOINT(_argv[0])
	_to   = TOINT(_argv[1])
	_sum  = (0, 0, 0, 0, 0)
	_key  = ''
	_v    = ''
	_a    = IARRAY
	_i    = 0

	CCS.RollDay
	foreach ccsdlog ; _key, _v {
		if TOINT(_key) >= _from && TOINT(_key) <= _to {
			_a = SPLIT(_v, ',')
			for _i = 0 ; _i < 5 ; _i++ {
				_sum[_i] += TOINT(_a[_i])
			}
		}
	}
	if ccsday >= _from && ccsday <= _to {
		_sum[0] += ccsd_answer
		_sum[1] += ccsd_done
		_sum[2] += ccsd_busy
		_sum[3] += ccsd_work
		_sum[4] += ccsd_new
	}
	_sum
}


//******************************************************************************
//称号
//******************************************************************************

//------------------------------------------------------------------------------
//称号 1 つ。ハッシュで id / name 称号 / word アンソニーのひとこと
//------------------------------------------------------------------------------
CCS.Title
{
	IHASH('id', _argv[0], 'name', _argv[1], 'word', _argv[2])
}

//------------------------------------------------------------------------------
//授けられる称号（CCS.Title）を並べる
//同じ種類の称号は、いちばん上のものだけを並べる
//------------------------------------------------------------------------------
CCS.Titles
{
	_list = IARRAY
	_top  = CCS.TopProject
	_late = CCS.HourSum(0, 4)

	//---- 依頼の数
	if ccshn >= 50000 {
		_list ,= CCS.Title('req50000', '数え切れぬ依頼を下せし者', 'もはや数える私の手が追いつきません。')
	}
	elseif ccshn >= 10000 {
		_list ,= CCS.Title('req10000', '万の依頼を下せし者', '一万件でございます。\w9\n記録帳が二冊目に入りました。')
	}
	elseif ccshn >= 5000 {
		_list ,= CCS.Title('req5000', '五千の依頼を下せし者', '五千件。立派な古参でございます。')
	}
	elseif ccshn >= 1000 {
		_list ,= CCS.Title('req1000', '千の依頼を下せし者', '千件でございます。\w9\n慣れた手つきになってまいりました。')
	}
	elseif ccshn >= 100 {
		_list ,= CCS.Title('req100', '駆け出しの依頼主', '百件でございます。ここからが本番かと。')
	}

	//---- 登城した日数
	if ccshdays >= 365 {
		_list ,= CCS.Title('days365', '一年登城の重臣', '三百六十五日分の登城でございます。')
	}
	elseif ccshdays >= 100 {
		_list ,= CCS.Title('days100', '百日登城の功労者', '百日。もはや城の一員でございます。')
	}
	elseif ccshdays >= 30 {
		_list ,= CCS.Title('days30', '常連の客人', 'お顔を覚えてしまいました。')
	}

	//---- 続けて登城した日数
	if ccshstreakmax >= 30 {
		_list ,= CCS.Title('streak30', '皆勤の鉄人', 'ひと月、一日も欠かさずでございます。')
	}
	elseif ccshstreakmax >= 7 {
		_list ,= CCS.Title('streak7', '七日続けて登城せし者', '一週間、休まずでございます。')
	}

	//---- 作業フォルダの数
	if HASH_SIZE(ccshproj) >= 30 {
		_list ,= CCS.Title('land30', '三十の領地を束ねし大領主', '地図が足りなくなってまいりました。')
	}
	elseif HASH_SIZE(ccshproj) >= 10 {
		_list ,= CCS.Title('land10', '十の領地を治めし者', '手広くお治めでございます。')
	}
	elseif HASH_SIZE(ccshproj) >= 3 {
		_list ,= CCS.Title('land3', '三つの領地の主', '領地が増えてまいりました。')
	}

	//---- いちばん手をかけた作業フォルダ
	if TOINT(_top['count']) >= 300 {
		_list ,= CCS.Title('top', _top['name'] + 'の開拓者', 'よく耕された領地でございます。')
	}

	//---- 一日の最多
	if ccshdaymax >= 300 {
		_list ,= CCS.Title('daymax300', '嵐を呼ぶ依頼主', '一日で三百件。\w9\nあの日のことは忘れられません。')
	}
	elseif ccshdaymax >= 100 {
		_list ,= CCS.Title('daymax100', '一日百依頼の猛者', '一日で百件でございます。')
	}

	//---- 時刻
	if _late >= 1000 {
		_list ,= CCS.Title('late1000', '夜の支配者', '念のため申し上げますが、\w9\n褒めてはおりません。')
	}
	elseif _late >= 100 {
		_list ,= CCS.Title('late100', '夜更かしの騎士', '念のため申し上げますが、\w9\n褒めてはおりません。')
	}
	if CCS.HourSum(5, 7) >= 100 {
		_list ,= CCS.Title('early100', '暁の働き者', '早起きは三文の徳でございます。')
	}

	//---- ゴーストが見届けたもの
	if ccsanswer >= 1000 {
		_list ,= CCS.Title('answer1000', '打てば響く者', '呼ばれて千回、応えて千回でございます。')
	}
	elseif ccsanswer >= 100 {
		_list ,= CCS.Title('answer100', '呼べば応える者', 'ベルを鳴らす甲斐がございます。')
	}
	if ccslong >= 10 {
		_list ,= CCS.Title('long10', '待つことを知る者', '長考を十度、辛抱強くお待ちになりました。')
	}
	if ccsworkmax >= 21600 {
		_list ,= CCS.Title('work6h', '不眠の城主', '六時間続けて、でございます。\w9\nお体を大事に。')
	}
	elseif ccsworkmax >= 14400 {
		_list ,= CCS.Title('work4h', '根気の人', '四時間続けて作業なさいました。')
	}
	if ccsbreak >= 10 {
		_list ,= CCS.Title('break10', '休憩を勧められ続ける者', 'これも称号でございます。一応。')
	}
	_list
}

//------------------------------------------------------------------------------
//番外の称号。書式は CCS.Titles と同じ。功績録では別の頁に並べる
//------------------------------------------------------------------------------
CCS.OddTitles
{
	_list  = IARRAY
	_top   = CCS.TopProject
	_names = HASH_KEYS(ccshproj)
	_name  = ''
	_lname = ''
	_temp  = ''
	_desk  = 0

	//---- 時刻
	if ccshhour[4] >= 30 {
		_list ,= CCS.Title('o.hour4', '午前四時の住人', '四時からの依頼は、\w9\n翌日の分として数えております。')
	}
	if ccshhour[12] >= 100 {
		_list ,= CCS.Title('o.lunch', '昼餉を忘れし者', '昼食はお済みでしょうか。')
	}
	if ccshhour[15] >= 100 {
		_list ,= CCS.Title('o.tea', '三時のお茶を抜く者', 'クッキーは、\w9\nトレイに残ったままでございます。')
	}

	//---- 日付と曜日
	if ccshxmas >= 1 {
		_list ,= CCS.Title('o.xmas', '聖夜に依頼を下せし者', 'サンタの代わりに、\w9\nClaude が参りました。')
	}
	if ccshnewyear >= 1 {
		_list ,= CCS.Title('o.newyear', '元日から働く者', 'おせちより先に、\w9\n依頼でございます。')
	}
	if ccshfri13 >= 1 {
		_list ,= CCS.Title('o.fri13', '十三日の金曜日に働きし者', '何事もなく、何よりでございました。')
	}
	if ccshwkend >= 300 {
		_list ,= CCS.Title('o.weekend', '休日返上の人', '土日も登城なさっております。')
	}

	//---- 依頼の間
	if ccshrapid >= 100 {
		_list ,= CCS.Title('o.rapid', '矢継ぎ早の依頼主', '返事を待たずに、\w9\n次の依頼でございます。')
	}
	if ccshreturn >= 1 {
		_list ,= CCS.Title('o.return', '帰ってきた放蕩者', 'おかえりなさいませ。\w9\nお部屋はそのままでございます。')
	}

	//---- 領地の治め方
	if ccshn >= 300 && HASH_SIZE(_top) > 0 {
		if TOINT(_top['count']) * 10 >= ccshn * 9 {
			_list ,= CCS.Title('o.ichizu', '一途な依頼主', 'ひとつの領地を、\w9\n脇目もふらずお耕しでございます。')
		}
		elseif HASH_SIZE(ccshproj) >= 10 && TOINT(_top['count']) * 5 < ccshn {
			_list ,= CCS.Title('o.utsurigi', '移り気な領主', 'どの領地にも、\w9\n少しずつお顔を出されます。')
		}
	}
	//---- 領地の名前
	foreach _names ; _name {
		_lname = TOLOWER(_name)
		if STRLEN(_temp) == 0 && RE_SEARCH(_lname, '^test|test$|^(tmp|temp|hoge|fuga|piyo|foo|untitled|sandbox|scratch|playground)$|^新しいフォルダー') {
			_temp = _name
		}
		if _lname == 'desktop' || _name == 'デスクトップ' {
			_desk = 1
		}
	}
	if STRLEN(_temp) > 0 {
		_list ,= CCS.Title('o.temp', _temp + 'の仮領主', 'いつ本当の名を\w9\nお付けになるのでしょう。')
	}
	if _desk {
		_list ,= CCS.Title('o.desk', '机上の領主', 'デスクトップで直接とは。\w9\n散らかりますよ。')
	}

	//---- セッション
	if ccsnew >= 30 && ccshsn < ccsnew * 2 {
		_list ,= CCS.Title('o.guest', '一言で去る客人', 'お茶をお出しする前に、\w9\nお帰りになります。')
	}
	if ccslong >= 100 {
		_list ,= CCS.Title('o.long100', '悠久を待つ者', '紅茶が百度冷めました。')
	}
	if ccsbreak >= 50 {
		_list ,= CCS.Title('o.break50', '聞き流しの達人', '休憩のおすすめ、\w9\n五十回目でございます。')
	}

	//---- わたくしどもへのふるまい
	if ccsnade >= 30 {
		_list ,= CCS.Title('o.nade', '令嬢の御髪に触れし不敬者', 'お嬢様は、まんざらでも‥\w5‥\w5\w9\n失礼いたしました。')
	}
	if ccsrude >= 10 {
		_list ,= CCS.Title('o.rude', '成敗されし不埒者', '私の台帳に、\w9\nお名前が十度載りました。')
	}
	if ccscookie >= 30 {
		_list ,= CCS.Title('o.cookie', 'クッキー泥棒', 'トレイのクッキーが、\w9\n数えるたびに減っております。')
	}
	if ccshide >= 30 {
		_list ,= CCS.Title('o.hide', '令嬢を仕舞い込む者', 'お嬢様、窮屈だと\w9\nお嘆きでございました。')
	}
	if ccsrecord >= 20 {
		_list ,= CCS.Title('o.record', '称号を気にしすぎる者', '功績録をお開きになるのは、\w9\nこれで二十回目でございます。')
	}
	_list
}


//******************************************************************************
//節目のお祝い
//******************************************************************************

//------------------------------------------------------------------------------
//最初に履歴を読み終えたとき、それまでに届いていた節目を「祝い済み」にする
//入れたとたんに称号の授与が続かないように。値は返さない
//------------------------------------------------------------------------------
CCS.QuietMilestones
{
	_list = (CCS.Titles, CCS.OddTitles)
	_t    = IHASH()

	ccsmile   = ccshn / 1000
	ccstitles = IARRAY
	foreach _list ; _t {
		ccstitles ,= _t['id']
	}
}

//------------------------------------------------------------------------------
//OnMinuteChange から 1 分おきに呼ぶ（CC.Minute から）。
//履歴を読み進め、節目に届いていたら一度だけ祝う。話すことが無ければ空文字列
//------------------------------------------------------------------------------
CCS.Minute
{
	_talk = ''

	//---- 最初の読み込みは重いので、1 分に 1500 行ずつ
	if CCS.HistPending {
		CCS.HistRead(1500)
	}
	elseif ccsbdone != 1 {
		CCS.Backfill(1500)
	}
	//---- 履歴のファイルが無いときも、ここで祝う準備を済ませる
	if ccshready != 1 && !CCS.HistPending {
		ccshready = 1
		CCS.QuietMilestones
	}
	CCS.RollDay
	//---- 執務で集中している間は、お祝いを次の休憩まで取っておく（yaya_teatimer.dic）
	if ccshready == 1 && CC.TalkOK(120) && !TM.Focusing {
		_talk = CCS.Milestone
		if STRLEN(_talk) > 0 {
			cctalkat = GETSECCOUNT
		}
	}
	_talk
}

//------------------------------------------------------------------------------
//届いた節目があれば、そのトーク。1 回に 1 つだけ。無ければ空文字列
//記念日 → 新しい称号 → 依頼の千件ごと の順に見る
//------------------------------------------------------------------------------
CCS.Milestone
{
	_now   = GETTIME
	_first = IARRAY
	_list  = IARRAY
	_new   = IARRAY
	_t     = IHASH()

	//---- 使い始めた日（記録の残る最初の日）の記念日
	if ccshfirst > 0 {
		_first = GETTIME(ccshfirst)
		if _now[1] == _first[1] && _now[2] == _first[2] && _now[0] > _first[0] && ccsanniv != _now[0] {
			ccsanniv = _now[0]
			return CCS.TalkAnniv(_now[0] - _first[0])
		}
	}

	//---- 新しい称号（上の段に上がったときも）
	_list = CCS.Titles
	foreach _list ; _t {
		if ASEARCH(_t['id'], ccstitles) < 0 {
			ccstitles ,= _t['id']
			return CCS.TalkTitle(_t['name'], _t['word'])
		}
	}
	//---- 新しい番外の称号。履歴を読み直している間は待ち、一度に届いた分はまとめて
	if ccsbdone == 1 {
		_list = CCS.OddTitles
		_new  = IARRAY
		foreach _list ; _t {
			if ASEARCH(_t['id'], ccstitles) < 0 {
				ccstitles ,= _t['id']
				_new      ,= _t
			}
		}
		if ARRAYSIZE(_new) == 1 {
			return CCS.TalkOddTitle(_new[0]['name'], _new[0]['word'])
		}
		elseif ARRAYSIZE(_new) >= 2 {
			return CCS.TalkOddTitles(_new[0]['name'], ARRAYSIZE(_new))
		}
	}

	//---- 依頼の千件ごと
	if ccshn / 1000 > ccsmile {
		ccsmile = ccshn / 1000
		return CCS.TalkThousand(ccsmile * 1000)
	}
	''
}

//---- 記念日。_argv[0] 何年目か
CCS.TalkAnniv
{
	"\u\s[10]\0\s[25]今日は記念日ですわよ、%(username)。\w9\nあなたの記録が始まって、\w9\nちょうど%(_argv[0])年ですわ。\w8\1始まりは%(CCS.SecDate(ccshfirst))でございました。\w8\0\n\nこれからも励みなさいな。\w8\1記念の%(sweets)をご用意いたしました。\e"
	"\u\s[10]\0\s[26]覚えていまして？\w9\n%(_argv[0])年前の今日、\w9\nあなたの最初の依頼が\w9\n記録されましたのよ。\w8\1あれから%(CCS.Comma(ccshn))件でございます。\w8\0\s[5]\n\nおーっほっほっほ！\w9\n立派になりましたこと！\e"
}

//---- 新しい称号。_argv[0] 称号 / _argv[1] アンソニーのひとこと
//---- 称号には作業フォルダの名前が入ることがあるので、%() で展開せずにつなぐ
CCS.TalkTitle
{
	'\u\s[10]\0\s[26]あら、' + username + '。\w9\n新しい称号を授けて差し上げますわ。\w8\1「' + _argv[0] + '」。\w9\n' + _argv[1] + '\w8\0\s[25]\n\n謹んでお受けなさいな。\e'
	'\u\s[10]\0\s[5]おーっほっほっほ！\w9\nまた功績が増えましたわね。\w8\1称号「' + _argv[0] + '」でございます。\w9\n' + _argv[1] + '\e'
}

//---- 新しい番外の称号。引数は CCS.TalkTitle と同じ
CCS.TalkOddTitle
{
	'\u\s[10]\0\s[0]あら、アンソニーが\w9\n何か言いたそうですわ。\w8\1番外の称号、\w9\n「' + _argv[0] + '」でございます。\w9\n' + _argv[1] + '\w8\0\s[26]\n\n‥\w5‥\w5受け取っておきなさいな、\w9\n' + username + '。\e'
	'\u\s[10]\0\s[7]‥\w5‥\w5アンソニー、\w9\nまた妙なものを数えましたわね？\w8\1番外の称号でございます。\w9\n「' + _argv[0] + '」。\w9\n' + _argv[1] + '\w8\0\s[1]\n\nそんなもの、\w9\n授けた覚えはありませんわ。\e'
}

//---- 新しい番外の称号が一度にいくつも。_argv[0] 最初の称号 / _argv[1] 数
CCS.TalkOddTitles
{
	'\u\s[10]\0\s[7]‥\w5‥\w5アンソニー、\w9\nその記録帳の余白は何ですの？\w8\1番外の称号が' + _argv[1] + '件、\w9\n溜まっております。\w8\0\s[2]\n\nそんなに！？\w8\1\n\n「' + _argv[0] + '」ほか、\w9\n功績録の最後の頁に並べました。\e'
}

//---- 依頼の千件ごと。_argv[0] 件数
CCS.TalkThousand : nonoverlap
{
	"\u\s[10]\0\s[5]おーっほっほっほ！\w9\n依頼が%(CCS.Comma(_argv[0]))件に届きましたわ！\w8\1記録帳に印をつけておきます。\e"
	"\u\s[10]\0\s[25]%(username)、ご存じ？\w9\nあなたの依頼、これで\w9\n%(CCS.Comma(_argv[0]))件目ですのよ。\w8\1記念に%(tea)をお淹れいたしました。\e"
	"\u\s[10]\0\s[8]%(CCS.Comma(_argv[0]))件。\w9\nよくもまあ、これだけ\w9\n働かせましたこと。\w8\1お嬢様は褒めていらっしゃいます。\w8\0\s[9]\n\n余計な通訳はいりませんわ。\e"
}


//******************************************************************************
//功績録（メニューから）
//******************************************************************************

//------------------------------------------------------------------------------
//功績録。頁ごとに独立したトークで、上端の見出し（CCS.Tabs）から頁を自由に切り替える
//  1 報告（期間の業務報告）/ 2 依頼 / 3 領地 / 4 見届け / 5 称号 / 6 番外の称号
//  _argv[0] 頁の番号（1〜6）。省略するとメニューから開いたものとして数え、
//           本日の業務報告（1 頁目）を出す
//           Claude Code が無い PC では、頁の代わりに CCS.PageNoClaude を出す
//------------------------------------------------------------------------------
CCS.Record
{
	_page = 0
	_odd  = IARRAY

	//---- 見出しから頁を開いたときも、保存した値の移し替え（CCS.Init）を済ませてから
	CCS.Init
	//---- 読み残しがあれば、ここで全部読む（本日の分を数えるため、頁を切り替えたときも）
	if CCS.HistPending {
		CCS.HistRead(100000)
	}
	if _argc > 0 {
		_page = _argv[0]
	}
	else {
		CCS.Count('record')
		if ccsbdone != 1 {
			CCS.Backfill(100000)
		}
		if CCS.NoClaude {
			return CCS.PageNoClaude
		}
		ccsperiod = 'today'
		_page     = 1
	}
	//---- 番外の称号が 1 つも無ければ、6 頁目は出さない
	_odd = CCS.OddTitles
	if _page == 6 && ARRAYSIZE(_odd) == 0 {
		_page = 5
	}
	case _page {
		when 1 {
			CCS.PageReport
		}
		when 2 {
			CCS.PageHistory
		}
		when 3 {
			CCS.PageLand
		}
		when 4 {
			CCS.PageWatch
		}
		when 6 {
			CCS.PageOddTitles
		}
		others {
			CCS.PageTitles
		}
	}
}

//---- 頁の上端の見出し。今の頁は墨の太字で示し、ほかの頁は選択肢（深赤土）にする
//  _argv[0] 今の頁の番号。選ぶと Menu_CCPAGE1〜6（yaya_menu.dic）が呼ばれる
//  各頁は、見出しから表までを \_q の中で一度に出し、そのあとの掛け合いだけ間を取って話す
CCS.Tabs
{
	_names = ('報告', '依頼', '領地', '見届け', '称号')
	_odd   = CCS.OddTitles
	_i     = 0
	_name  = ''
	_talk  = ''

	if ARRAYSIZE(_odd) > 0 {
		_names ,= '番外'
	}
	foreach _names ; _i, _name {
		if _i > 0 {
			_talk += '｜'
		}
		if _i + 1 == _argv[0] {
			_talk += '\f[bold,1]' + _name + '\f[default]'
		}
		else {
			_talk += '\q[' + _name + ',Menu_CCPAGE' + (_i + 1) + ']'
		}
	}
	_talk + '\n\f[align,center]―― ◇ ――\n\f[align,left]'
}

//------------------------------------------------------------------------------
//Claude Code を使っていない PC なら 1
//  セッションの置き場所も、依頼の記録も、見張りで数えたものも無いとき。
//  前に使っていた PC（記録が残っている）では 0 にして、いつもの頁を出す
//------------------------------------------------------------------------------
CCS.NoClaude
{
	_is = 0

	CCS.Init
	if !CC.HasSessionDir && ccshn == 0 && ccsanswer + ccsdone + ccsbusy + ccsnew == 0 {
		_is = 1
	}
	_is
}

//---- Claude Code が無い PC で功績録を開いたとき。頁の見出しは出さない
//  番外の称号（なでた回数など、Claude Code が無くても貯まるもの）があれば、ここに並べる
CCS.PageNoClaude
{
	_list = CCS.OddTitles
	_t    = IHASH()
	_talk = '\u\s[10]\0\s[3]\b[2]あら、この館には Claude Code が\w9\n見当たりませんわね。\w8'

	if ARRAYSIZE(_list) == 0 {
		_talk += '\1功績録は、Claude Code での\w9\nお働きを記す帳面でございます。\w8\0\s[0]\n\nお使いになる日が来たら、\w9\nわたくしどもが記録して差し上げますわ。'
	}
	else {
		_talk += '\1功績録は白紙でございます。\w9\nただ、余白にこのようなものが。\w8\0\s[7]\n\n\_q'
		foreach _list ; _t {
			_talk += '「' + _t['name'] + '」\n'
		}
		_talk += '\_q\w8\1\n\n番外の称号でございます。\w8\0\s[1]\nこんなもの、\w9\n授けた覚えはありませんわ。'
	}
	_talk
}

//---- 2・3 頁目で、依頼の記録が見つからないとき
//  _argv[0] 頁の番号
CCS.PageNoHistory
{
	'\u\s[10]\0\s[3]\b[2]\_q' + CCS.Tabs(_argv[0]) + 'Claude Code の依頼の記録が\n見つかりませんわ。\_q\w8\1わたくしどもで数えた分は、\w9\n「見届け」の頁にございます。'
}

//---- 2 頁目: 依頼の記録
CCS.PageHistory
{
	_span = (GETSECCOUNT - ccshfirst) / 86400 + 1
	_talk = ''

	if ccshn == 0 {
		return CCS.PageNoHistory(2)
	}
	_talk  = '\u\s[10]\0\s[26]\b[2]\_q' + CCS.Tabs(2) + 'あなたの功績録ですわ。\nとくとご覧なさい。\n\n'
	_talk += '・記録の始まり　' + CCS.SecDate(ccshfirst) + '\n'
	_talk += '・登城した日　' + CCS.Comma(ccshdays) + '日（' + CCS.Comma(_span) + '日のうち）\n'
	_talk += '・依頼　' + CCS.Comma(ccshn) + '件\n'
	_talk += '・一日の最多　' + CCS.Comma(ccshdaymax) + '件（' + CCS.DateText(ccshdaymaxkey) + '）\n'
	_talk += '・続けて登城した最長　' + CCS.Comma(ccshstreakmax) + '日\_q\w8'
	if ccshn >= 1000 {
		_talk += '\1一日あたり' + (ccshn / ccshdays) + '件でございます。\w8\0\s[25]\n\nよく働きましたこと。\w9\n褒めて差し上げますわ。'
	}
	else {
		_talk += '\1これからでございますね。\w8\0\s[0]\n\n記録はまだまだ伸びますわ。'
	}
	_talk
}

//---- 3 頁目: 領地と時刻
CCS.PageLand
{
	_top  = IHASH()
	_peak = 0
	_late = 0
	_talk = ''

	if ccshn == 0 {
		return CCS.PageNoHistory(3)
	}
	_top  = CCS.TopProject
	_peak = CCS.PeakHour
	_late = CCS.HourSum(0, 4)
	_talk  = '\u\s[10]\0\s[0]\b[2]\_q' + CCS.Tabs(3) + '治めた領地と、働く時刻ですわ。\n\n'
	_talk += '・治めた領地　' + HASH_SIZE(ccshproj) + 'か所\n'
	if HASH_SIZE(_top) > 0 {
		_talk += '・いちばんの領地　' + _top['name'] + '（' + CCS.Comma(_top['count']) + '件）\n'
	}
	_talk += '・よく働く時刻　' + _peak + '時台\n'
	_talk += '・深夜（0〜4時台）の依頼　' + CCS.Comma(_late) + '件\n'
	_talk += '・早朝（5〜7時台）の依頼　' + CCS.Comma(CCS.HourSum(5, 7)) + '件\_q\w8'
	if _late * 10 >= ccshn {
		_talk += '\0\s[7]\n\n深夜の依頼が多すぎましてよ。\w8\1念のため、褒めてはおりません。'
	}
	elseif _peak >= 5 && _peak <= 11 {
		_talk += '\0\s[25]\n\n朝のうちに片付ける。\w9\n感心な働き方ですわ。\w8\1お嬢様より早起きでございます。'
	}
	else {
		_talk += '\0\s[26]\n\n規則正しくて結構ですわ。\w8\1夜更かしは控えめでございますね。'
	}
	_talk
}

//---- 4 頁目: わたくしどもが見届けた分
CCS.PageWatch
{
	_talk = ''

	CCS.Init
	if ccsanswer + ccsdone + ccsbusy + ccsnew == 0 {
		return '\u\s[10]\0\s[0]\b[2]\_q' + CCS.Tabs(4) + 'わたくしどもが見届けた分は、\nまだこれからですわ。\_q\w8\1記録は' + CCS.SecDate(ccssince) + 'より\w9\nつけ始めております。'
	}
	_talk  = '\u\s[10]\0\s[26]\b[2]\_q' + CCS.Tabs(4) + 'わたくしどもが見届けた分ですわ。\n' + CCS.SecDate(ccssince) + 'から数えていますの。\n\n'
	_talk += '・返事待ちに応えた　' + CCS.Comma(ccsanswer) + '回\n'
	_talk += '・大仕事の完了（1分半以上）　' + CCS.Comma(ccsdone) + '回\n'
	_talk += '・10分を超える長考　' + CCS.Comma(ccslong) + '回\n'
	_talk += '・Claude が働いた時間　' + CC.Duration(ccsbusy) + '\n'
	_talk += '・続けて作業した最長　' + CC.Duration(ccsworkmax) + '\n'
	_talk += '・開いたセッション　' + CCS.Comma(ccsnew) + '（夜更けに' + CCS.Comma(ccslate) + '）\n'
	_talk += '・休憩のおすすめ　' + CCS.Comma(ccsbreak) + '回\_q\w8'
	if ccsbreak > 0 {
		_talk += '\1休憩のおすすめを' + ccsbreak + '回。\w9\nお聞き入れの回数は、\w9\n数えておりません。'
	}
	else {
		_talk += '\1これからも記録してまいります。'
	}
	_talk
}

//---- 5 頁目: 称号
CCS.PageTitles
{
	_list = CCS.Titles
	_t    = IHASH()
	_talk = ''

	if ARRAYSIZE(_list) == 0 {
		return '\u\s[10]\0\s[0]\b[2]\_q' + CCS.Tabs(5) + '称号は、まだございませんわね。\nこれからの働きに期待しますわ。\_q\w8\1精進でございます。'
	}
	_talk = '\u\s[10]\0\s[26]\b[2]\_q' + CCS.Tabs(5) + '以上の功績をもって、\n次の称号を授けますわ。\n\n'
	foreach _list ; _t {
		_talk += '「' + _t['name'] + '」\n'
	}
	_talk += '\_q\w8'
	if ARRAYSIZE(_list) >= 5 {
		_talk += '\0\s[5]\nおーっほっほっほ！\w9\n見事な働きぶりですわ！\w8\1おめでとうございます。'
	}
	else {
		_talk += '\0\s[25]\n謹んでお受けなさいな。\w8\1おめでとうございます。'
	}
	_talk
}

//---- 6 頁目: 番外の称号（1 つも無ければ頁ごと出さない）
CCS.PageOddTitles
{
	_list = CCS.OddTitles
	_t    = IHASH()
	_talk = ''

	_talk = '\u\s[10]\0\s[7]\b[2]\_q' + CCS.Tabs(6) + '‥‥アンソニーが記録帳の余白に\n妙なものを書いていましたわ。\n\n'
	foreach _list ; _t {
		_talk += '「' + _t['name'] + '」\n'
	}
	_talk += '\_q\w8\1番外の称号でございます。\w8\0\s[1]\nこんなもの、\w9\n授けた覚えはありませんわ。\w8\1\n\nすでにお渡し済みでございます。'
	_talk
}

//---- 1 頁目の、見出しの下の期間の切り替え。今の期間は太字、ほかは選択肢にする
//  _argv[0] 今の期間の ID。選ぶと OnCCSPeriod（yaya_menu.dic）が呼ばれる
//  指定した期間を見ているときの選び直しは、見出しの横の選択肢から（CCS.PageReport）
CCS.PeriodBar
{
	_ids   = CCS.PeriodIDs
	_names = CCS.PeriodNames
	_i     = 0
	_id    = ''
	_talk  = ''

	foreach _ids ; _i, _id {
		if _i > 0 {
			_talk += '・'
		}
		if _id == _argv[0] {
			_talk += '\f[bold,1]' + _names[_i] + '\f[default]'
		}
		else {
			_talk += '\q[' + _names[_i] + ',OnCCSPeriod,' + _id + ']'
		}
	}
	_talk + '\n'
}

//------------------------------------------------------------------------------
//1 頁目: 業務報告。ccsperiod の期間について、依頼の履歴を読み直して数え、
//見届けた数は日ごとの記録（ccsdlog）から合わせる
//------------------------------------------------------------------------------
CCS.PageReport
{
	_id    = ccsperiod
	_ids   = CCS.PeriodIDs
	_range = IARRAY
	_from  = 0
	_to    = 0
	_today = CCS.Today
	_r     = IHASH()
	_w     = IARRAY
	_span  = 0
	_n     = 0
	_name  = ''
	_year  = 0
	_avg   = 0
	_all   = 0
	_k     = 0
	_talk  = ''

	CCS.RollDay
	if ASEARCH(_id, _ids) < 0 {
		_id = 'today'
	}
	_range = CCS.PeriodRange(_id)
	_from  = _range[0]
	_to    = _range[1]
	_span  = CCS.KeyDays(_from, _to)
	_r     = CCS.Span(_from, _to)
	_w     = CCS.SpanWatch(_from, _to)
	_n     = _r['n']
	_name  = CCS.PeriodNames
	_name  = _name[ASEARCH(_id, _ids)]

	//---- 見出しと期間
	//---- 吹き出し（24 行）に選択肢まで収まるよう、期間の選択肢の下は半行だけ空ける
	_talk  = '\u\s[10]\0\s[0]\b[2]\_q' + CCS.Tabs(1) + CCS.PeriodBar(_id) + '\n[half]'
	if _id == 'custom' {
		_talk += '\f[color,140,59,31]\f[bold,1]◆ 指定した期間の業務報告\f[default]　\q[選び直す,OnCCSPeriod,custom]\n'
	}
	else {
		_talk += '\f[color,140,59,31]\f[bold,1]◆ ' + _name + 'の業務報告\f[default]\n'
	}
	//---- 今年でない日が入るときは、年を書く（曜日は書かない）
	_year = (_from / 10000 != _today / 10000 || _to / 10000 != _today / 10000)
	_talk += '\f[color,107,78,61]' + CCS.KeyText(_from, _year)
	if _to != _from {
		_talk += '〜' + CCS.KeyText(_to, _year)
	}
	_talk += '\f[default]\n\n'

	//---- 依頼の履歴から
	if _span == 1 {
		_talk += '・依頼　' + CCS.Comma(_n) + '件\n'
	}
	else {
		_talk += '・依頼　' + CCS.Comma(_n) + '件（' + CCS.Comma(_span) + '日のうち' + CCS.Comma(_r['days']) + '日登城）\n'
		if _n > 0 {
			_talk += '・一日の最多　' + CCS.Comma(_r['max']) + '件（' + CCS.KeyText(_r['maxkey'], 2 - _year) + '）\n'
		}
	}
	if _n > 0 {
		_talk += '・よく働く時刻　' + _r['peak'] + '時台（深夜 ' + CCS.Comma(_r['late']) + '件）\n'
		_talk += '・治めた領地　' + _r['lands'] + 'か所\n'
		for _k = 0 ; _k < 3 ; _k++ {
			if _r['c' + _k] > 0 {
				_talk += '　' + SHIORI3FW.MakeShortText(_r['p' + _k], 30) + '　' + CCS.Comma(_r['c' + _k]) + '件\n'
			}
		}
	}
	//---- わたくしどもが見届けた分。日ごとの記録が始まる前だけの期間では出さない
	if _to < ccsdlogsince {
		_talk += '\f[color,107,78,61]（Claude の働きぶりは、' + CCS.KeyText(ccsdlogsince, 1) + 'から記録）\f[default]'
	}
	else {
		_talk += '・Claude が働いた時間　' + CC.Duration(_w[2]) + '\n'
		_talk += '・作業していた時間　' + CC.Duration(_w[3]) + '\n'
		_talk += '・セッション ' + CCS.Comma(_w[4]) + '・大仕事 ' + CCS.Comma(_w[1]) + '回・返事待ち ' + CCS.Comma(_w[0]) + '回'
		if _from < ccsdlogsince {
			_talk += '\n\f[color,107,78,61]（働いた時間から下は、' + CCS.KeyText(ccsdlogsince, 2 - _year) + 'からの分）\f[default]'
		}
	}
	_talk += '\_q\w8'

	//---- ひとこと
	if _n == 0 && _w[2] == 0 {
		if _id == 'today' {
			_talk += '\0\s[6]\n\n本日はまだ、何もしておりませんのね。\w8\1嵐の前の静けさでございます。'
		}
		else {
			_talk += '\0\s[0]\n\nこの間は、お休みでしたのね。\w8\1骨休めも、お仕事のうちでございます。'
		}
	}
	elseif _id == 'today' && _n >= 10 && _n == ccshdaymax {
		_talk += '\0\s[5]\n\nおーっほっほっほ！\w9\n一日の最多記録ですわよ！\w8\1記録帳を書き換えておきます。'
	}
	elseif _n >= 10 && _r['late'] * 4 >= _n {
		_talk += '\0\s[7]\n\n深夜の依頼が多すぎましてよ。\w9\n夜は眠るものですわ。\w8\1念のため、褒めてはおりません。'
	}
	elseif _span == 1 {
		if _n >= 100 {
			_talk += '\0\s[2]\n\n百件を超えましたの！？\w9\n見事ですけれど、働きすぎですわ。\w8\1' + tea + 'を濃いめにお淹れいたします。'
		}
		elseif _n >= 20 {
			_talk += '\0\s[25]\n\nよく働きましたこと。\w9\n褒めて差し上げますわ。\w8\1お疲れさまでございます。'
		}
		else {
			_talk += '\0\s[0]\n\nほどほどの一日ですわね。\w8\1無理のない働き方は、\w9\n長続きいたします。'
		}
	}
	elseif _r['days'] == 0 || ccshdays == 0 {
		_talk += '\0\s[0]\n\n依頼はなくとも、\w9\nClaude は働いていましたのね。\w8\1記録しておきます。'
	}
	else {
		//---- 登城した日の一日あたりを、これまで全体と比べる
		_avg = _n / _r['days']
		_all = ccshn / ccshdays
		if _avg * 2 >= _all * 3 {
			_talk += '\0\s[2]\n\nいつもより、ずいぶん\w9\n精が出ましたのね。\w8\1登城した日は一日あたり' + _avg + '件。\w9\nふだんは' + _all + '件でございます。'
		}
		elseif _avg * 2 <= _all {
			_talk += '\0\s[0]\n\nいつもより、ゆったりした\w9\n日々でしたわね。\w8\1登城した日は一日あたり' + _avg + '件。\w9\nふだんは' + _all + '件でございます。'
		}
		else {
			_talk += '\0\s[26]\n\nいつもどおりの働きぶりですわ。\w9\n結構ですこと。\w8\1一日あたり' + _avg + '件でございます。'
		}
	}
	_talk
}

//------------------------------------------------------------------------------
//終了のあいさつの前に添える、本日のひとこと。依頼が無ければ空文字列
//------------------------------------------------------------------------------
CCS.CloseReport
{
	_n    = 0
	_talk = ''

	CCS.RollDay
	_n = CCS.TodayRequests
	if _n > 0 {
		if ccsd_busy >= 60 {
			_talk = '\0\s[26]本日は依頼' + CCS.Comma(_n) + '件、\w9\nClaude は' + CC.Duration(ccsd_busy) + '働きましたわ。'
		}
		else {
			_talk = '\0\s[26]本日の依頼は' + CCS.Comma(_n) + '件でしたわね。'
		}
		_talk += '\w9\w9\n'
	}
	_talk
}


//******************************************************************************
//AI グラフ（SHIORI リソース getaistate）
//******************************************************************************

//------------------------------------------------------------------------------
//功績録の数を 6 軸のレーダーチャートにする。本日の分は加算値にして目立たせる。
//Claude Code の数がまだ何も無ければ空を返し、システム辞書の既定のグラフ
//（SHIORI3EV.On_getaistate）に任せる。背景の画像は ghost/master/ai0.png と ai0_dark.png
//（work/aigraph/make-aigraph.ps1 で作る）
//  依頼       history.jsonl から数えた依頼の件数
//  登城日     依頼のあった日の数
//  領地       依頼のあった作業フォルダの数（本日の分は分けない）
//  返事待ち   返事待ちに応えた回数
//  大仕事     1 分半を超える仕事が片付いた回数
//  稼働(時間) Claude が働いた時間
//------------------------------------------------------------------------------
On_getaistate
{
	_req   = 0
	_reqd  = 0
	_days  = 0
	_daysd = 0
	_land  = 0
	_ans   = 0
	_ansd  = 0
	_done  = 0
	_doned = 0
	_busy  = 0
	_busyd = 0
	_v     = IARRAY
	_a     = IARRAY
	_m     = IARRAY
	_i     = 0

	CCS.Init
	CCS.RollDay
	if ccshn + ccsanswer + ccsdone + ccsbusy + ccsnew == 0 {
		return ''
	}
	_reqd = CCS.TodayRequests
	_req  = ccshn - _reqd
	_days = ccshdays
	if _reqd > 0 {
		_daysd = 1
		_days -= 1
	}
	_land  = HASH_SIZE(ccshproj)
	_ansd  = ccsd_answer
	_ans   = ccsanswer - _ansd
	_doned = ccsd_done
	_done  = ccsdone - _doned
	//---- 時間は小数 1 桁まで
	_busyd = TOREAL(ccsd_busy / 360) / 10
	_busy  = TOREAL((ccsbusy - ccsd_busy) / 360) / 10

	_v = (_req, _days, _land, _ans, _done, _busy)
	_a = (_reqd, _daysd, 0, _ansd, _doned, _busyd)
	for _i = 0 ; _i < 6 ; _i++ {
		_m ,= SHIORI3FW.AIGraphMax(_v[_i] + _a[_i])
	}
	SHIORI3FW.AIGraphJoin(_v) + C_BYTE1 + '依頼,登城日,領地,返事待ち,大仕事,稼働(時間)' + C_BYTE1 + SHIORI3FW.AIGraphJoin(_a) + C_BYTE1 + SHIORI3FW.AIGraphJoin(_m)
}
