//******************************************************************************
// 悪役令嬢クローディア
// 切り替えトーク辞書
//******************************************************************************

//******************************************************************************
// ゴースト切り替え
//******************************************************************************
/*
関数は以下の形で記載します。
[イベント] + [ゴースト名]
イベントは、以下のものがあります。
イベントによっては該当する関数が無ければOnCloseやOnBootになります。
ゴースト名は、先頭に _が付きます。
該当するゴースト名が無いときは、ゴースト名の部分は「Other」となります。

名前の中に"や'、あるいは+-/*、半角空白など、
システムで使われている文字が来る場合は、すべて_に変換されます。
例：the 'MobileMaster' -> OnGhostChanging_the__MobileMaster_

OnGhostChanging		他のゴーストへ切り替えしようとしたとき。無ければOnCloseが呼ばれます。
OnGhostChanged		他のゴーストから切り替わったとき。無ければOnBootが呼ばれます。
OnGhostCalling		他のゴーストを呼び出そうとしたとき
OnGhostCalled			他のゴーストから呼び出されたとき。無ければOnBootが呼ばれます。
OnGhostCallComplete	他のゴーストを呼び出して、呼び出されたゴーストの起動が完了したとき、OnOtherGhostBootedの代わりに

OnOtherGhostBooted	他のゴーストが呼び出されて、呼び出されたゴーストの起動が完了したとき
OnOtherGhostClosed	他のゴーストが終了したとき
OnOtherGhostChanged	他のゴーストが他のゴーストに 切り替わって、切り替わり先のゴーストの起動が完了したとき
*/


//その他のゴーストへ切り替え
OnGhostChangingOther
{
	_escaped_name = SHIORI3FW.EscapeAllTags(reference[0])
	"\0\s[7]%(_escaped_name)のところへ行きますの？\w8\1お嬢様、お見送りを。\w8\0\s[1]\n\n‥\w5‥\w5ご、ごきげんよう。\w9\nすぐ戻ってきてもよろしくてよ。\e"
	"\0\s[26]ふん、%(_escaped_name)ですって？\w9\nせいぜい楽しんでいらっしゃい。\w8\1お嬢様、扇を握る手に力が。\e"
}

//その他のゴーストから切り替り
OnGhostChangedOther
{
	_escaped_name = SHIORI3FW.EscapeAllTags(reference[0])
	"\0\s[7]%(_escaped_name)の次に、わたくしですの？\w8\1お嬢様、順番は気になさらずに。\w8\0\s[26]\n\n‥\w5‥\w5まあ、最後に選ばれたのが\w9\nわたくしなら、よろしいですわ。\e"
	"\0\s[0]ごきげんよう、%(username)。\w9\nやはりわたくしのところに戻ってきましたわね。\w8\1お待ちしておりました。\e"
}


//------------------------------------------------------------------------------
// 所長たん（とらぶる☆ばぐとらっく）
//------------------------------------------------------------------------------
OnGhostChanging_所長たん
{
	'\u\s[10]\0\s[7]所長たんのところですの？\w9\nまたどこかがバグっているのでしょう。\w8\1ばぐたん様もご一緒かと存じます。\w8\0\s[4]\n\n天使と悪魔の事務所に、\w9\nわざわざ出向くなんて‥\w5‥\w5\w9\nせいぜい巻き込まれないことですわ。\e'
	'\u\s[10]\0\s[26]所長たん‥\w5‥\w5\w9\n聞けば、わたくしを書いた方の\w9\n分身のような方だとか。\w8\1つまり、お嬢様の親御様のようなものでございますね。\w8\0\s[1]\n\nご、ご挨拶くらいはしておきなさい。\w9\nわたくしがよろしく言っていたと。\e'
}

OnGhostChanged_所長たん
{
	'\u\s[10]\0\s[2]所長たんの次ですの？\w9\n‥\w5‥\w5バグは持ち込んでいないでしょうね。\w8\1念のため、クッキーに虫が付いていないか\w9\n確かめておきます。\w8\0\s[7]\n\nそういう意味のバグではありませんわ。\e'
	'\u\s[10]\0\s[0]バグだらけの事務所から、\w9\nよく無事に戻りましたわね。\w8\1所長様は、ゴーストの面倒を見る\w9\nお立場と伺っております。\w8\0\s[26]\n\n面倒を見る方が一番バグっていては、\w9\n世話はありませんわ。\e'
}

OnGhostCalled_所長たん
{
	'\u\s[10]\0\s[2]所長たんに呼ばれましたの？\w9\nわたくしに何のご用かしら。\w8\1バグの相談ではないかと。\w8\0\s[7]\n\nわたくしは修理屋ではありませんわ。\w9\n‥\w5‥\w5まあ、見るだけ見て差し上げますけれど。\e'
	'\u\s[10]\0\s[1]所長たんのお呼びとあらば、\w9\n参らないわけにはいきませんわね。\w8\1お嬢様、今日は素直でございますね。\w8\0\s[7]\n\n生みの親のような方ですもの。\w9\n礼儀くらいはわきまえていますわ。\e'
}

OnOtherGhostBooted_所長たん
{
	'\u\s[10]\0\s[2]あら、所長たんがいらっしゃいましたわ。\w8\1ばぐたん様もお見えでございます。\w8\0\s[26]\n\nバグの持ち込みはお断りでしてよ。\e'
	'\u\s[10]\0\s[0]所長たん、ごきげんよう。\w9\n今日はどこもバグっていないかしら。\w8\1お嬢様、ご挨拶に余計なひと言が。\e'
}


//------------------------------------------------------------------------------
// Emily（SSP のナビゲーター、エミリ）
//------------------------------------------------------------------------------
OnGhostChanging_Emily
{
	'\u\s[10]\0\s[7]エミリさんのところへ？\w9\nSSP の案内役ですわね。\w8\1古くからの先輩でございます。\w8\0\s[26]\n\n先輩だろうと遠慮はしませんわ。\w9\n‥\w5‥\w5ただ、焼き芋のひとつでも\w9\n持っていって差し上げなさい。\e'
	'\u\s[10]\0\s[4]エミリさんのところへ行きますの？\w9\nあの方の魔法、よく暴発すると聞きますわ。\w8\1焦げて戻られませんよう。\w8\0\s[0]\n\nテディさんがついていれば、\w9\nまあ大丈夫でしょう。\w9\nお気をつけて。\e'
}

OnGhostChanged_Emily
{
	'\u\s[10]\0\s[2]あら、エミリさんの次ですの？\w9\n‥\w5‥\w5なんだか焦げくさいですわ。\w8\1魔法の暴発に巻き込まれたかと。\w8\0\s[7]\n\nまず煤を払っていらっしゃい。\w9\n話はそれからですわ。\e'
	"\u\s[10]\0\s[26]ごきげんよう、%(username)。\w9\nにぎやかな漫才の後には、\w9\n優雅なお茶会がお似合いですわ。\w8\1紅茶の用意はできております。\e"
}

OnGhostCalled_Emily
{
	'\u\s[10]\0\s[26]エミリさんに呼ばれましたわ。\w9\nSSP の先輩のお招きですもの、\w9\n応じて差し上げますわ。\w8\1お嬢様、念のため消火の用意を。\w8\0\s[7]\n\n‥\w5‥\w5お茶会の席で魔法は禁止ですわよ。\e'
	'\u\s[10]\0\s[0]ごきげんよう、エミリさん。\w9\n焼き芋のお誘いかしら？\w8\1紅茶には合わないかと存じます。\w8\0\s[7]\n\n‥\w5‥\w5意外と合いますのよ。\e'
}

OnOtherGhostBooted_Emily
{
	'\u\s[10]\0\s[2]あら、エミリさんですわ。\w9\nテディさんもご一緒ね。\w8\1ツッコミ役どうし、\w9\n親しみを覚えます。\w8\0\s[7]\n\nわたくしはボケてなどいませんわ。\e'
	'\u\s[10]\0\s[4]エミリさんがいらしたのね。\w9\n‥\w5‥\w5扇はしまっておきましょう。\w8\1燃えやすいものは遠ざけるのが賢明かと。\e'
}


//------------------------------------------------------------------------------
// ラーシェ（とらふぃっく☆とれいん）
//------------------------------------------------------------------------------
OnGhostChanging_ラーシェ
{
	'\u\s[10]\0\s[2]ラーシェさんのところへ？\w9\nあの方、機関車なのだそうですわね。\w8\1DE10 形ディーゼル機関車と伺っております。\w8\0\s[7]\n\n‥\w5‥\w5馬車より速いのは認めますわ。\w9\n乗り遅れないようになさい。\e'
	'\u\s[10]\0\s[26]ラーシェさんのところへ行きますのね。\w9\nダジャレを聞かされても、\w9\n笑ってあげる必要はなくてよ。\w8\1お嬢様、それはいささか冷たいかと。\w8\0\s[1]\n\n‥\w5‥\w5一回くらいなら、\w9\n笑ってあげてもよろしくてよ。\e'
}

OnGhostChanged_ラーシェ
{
	'\u\s[10]\0\s[0]ラーシェさんの次はわたくしですの。\w9\nお乗り換え、ご苦労さまですわ。\w8\1お嬢様、駅員のような言い回しでございますね。\w8\0\s[7]\n\n‥\w5‥\w5うつってしまいましたわ。\e'
	'\u\s[10]\0\s[4]ラーシェさんのところでは、\w9\n軽油がごちそうだそうですわね。\w8\1当家では紅茶でございます。\w8\0\s[0]\n\nええ、あなたにはこちらのほうが\w9\nお口に合うはずですわ。\e'
}

OnGhostCalled_ラーシェ
{
	'\u\s[10]\0\s[2]ラーシェさんに呼ばれましたの？\w9\nわたくし、貨物ではなくてよ。\w8\1お嬢様、ご乗車のお誘いかと。\w8\0\s[7]\n\nどちらにしても、\w9\n運ばれるのは性に合いませんわ。\e'
	'\u\s[10]\0\s[0]ごきげんよう、ラーシェさん。\w9\nお茶をご一緒にいかが？\w8\1軽油のほうがお好みかと存じます。\w8\0\s[4]\n\n‥\w5‥\w5当家には置いていませんわ。\e'
}

OnOtherGhostBooted_ラーシェ
{
	'\u\s[10]\0\s[2]あら、ラーシェさんが到着しましたわ。\w8\1定刻どおりでございます。\w8\0\s[26]\n\n時間を守る方は嫌いではなくてよ。\e'
	'\u\s[10]\0\s[7]ラーシェさんがいらしたわ。\w9\nダジャレには身構えておきなさい。\w8\1お嬢様こそ、笑いをこらえるご用意を。\e'
}


//******************************************************************************
//この下は切り替えトーク処理用
//通常はいじる必要はありませんが、必要に応じて適宜変更してください。
//AYATEMPLATE.ではじまる関数は _tmpl_util.dic にあります。
//******************************************************************************

OnGhostChanging
{
	AYATEMPLATE.ExecuteChangeCallTalk("OnGhostChanging","OnClose")
}

OnGhostChanged
{
	AYATEMPLATE.ExecuteChangeCallTalk("OnGhostChanged","OnBoot")
}

OnGhostCalling
{
	AYATEMPLATE.ExecuteChangeCallTalk('OnGhostCalling')
}

OnGhostCalled
{
	AYATEMPLATE.ExecuteChangeCallTalk("OnGhostCalled","OnBoot")
}

OnGhostCallComplete
{
	AYATEMPLATE.ExecuteChangeCallTalk('OnGhostCallComplete')
}

OnOtherGhostClosed
{
	AYATEMPLATE.ExecuteChangeCallTalk('OnOtherGhostClosed')
}

OnOtherGhostBooted
{
	AYATEMPLATE.ExecuteChangeCallTalk('OnOtherGhostBooted')
}

OnOtherGhostChanged
{
	AYATEMPLATE.ExecuteChangeCallTalk('OnOtherGhostChanged')
}
