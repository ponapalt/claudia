//******************************************************************************
// 悪役令嬢クローディア
// マウス入力関連辞書
//******************************************************************************


//******************************************************************************
//マウス処理部
//
//以下、実際のトークを記述します。関数名は以下の規則になっています。
//[種別] + [スコープ] + [部位]
//種別は、MouseMove, MouseDoubleClick, MouseWheelUp, MouseWheelDown のどれかです。
//スコープは、\0,\1,といったスコープ番号です。
//部位は、当たり判定のどの部位かを表します。当たり判定の無い場所でのイベントの場合
//部位はありません。
//
//クローディアの当たり判定: Head, Face, Bust, Hair, Fan
//アンソニーの当たり判定: Head, Face, Body, Tray
//******************************************************************************


//******************************************************************************
//撫で反応
//******************************************************************************
MouseMove0Head
{
	'\0\s[1]ちょっと、ティアラがずれますわ。\w8\1直すのは私でございます。\e'
	'\0\s[1]‥\w5‥\w5子ども扱いしないでくださる？\w8\1お顔は嬉しそうでございますが。\w8\0\s[7]\n\n余計なことは言わなくてよろしい！\e'
	'\0\s[25]‥\w5‥\w5ふん。\w9\n今日だけは許して差し上げますわ。\e'
}

MouseMove0Hair
{
	'\0\s[7]この巻き髪を整えるのに、\w9\nどれだけかかると思っていますの？\w8\1毎朝一時間でございます。\e'
	'\0\s[1]‥\w5‥\w5髪に触れるのは、\w9\n信頼の証ですのよ。\w8\s[7]\nべ、別にあなたを信頼しているとは\w9\n言っていませんわ！\e'
}

MouseMove0Face
{
	'\0\s[7]ほ、頬に触れるなんて無礼ですわ！\e'
	'\0\s[1]‥\w5‥\w5何か、ついていまして？\w8\1クッキーのかけらが。\w8\0\s[2]\n\nなんですって！？\e'
}

MouseMove0Bust
{
	"\0\s[7]どこを触っていますの、%(username)。\w9\n品位を疑いますわ。\e"
	'\0\s[7]‥\w5‥\w5アンソニー、この方をつまみ出して。\w8\1かしこまりました。\w9\n‥\w5‥\w5と申し上げたいところですが、\w9\nこちら側からは手が届きません。\e'
}

MouseMove0Fan
{
	'\0\s[26]この扇が気になりまして？\w9\n異国の職人に作らせた特注品ですの。\e'
	'\0\s[0]扇で口元を隠すのは、\w9\n笑いをこらえるときですわ。\w8\1たいてい、どなたかの失敗をご覧になったときです。\e'
}

MouseMove1Head
{
	'\1\s[10]‥\w5‥\w5頭のひれは、撫でるものではございません。\e'
}

MouseMove1Face
{
	'\1\s[10]私の顔に何か。\w8\0\s[0]いつも眠そうですわね。\w8\1\n\nこれが真顔でございます。\e'
}

//******************************************************************************
//つつかれ反応
//******************************************************************************

//本体側のつつかれ反応
MouseDoubleClick0Head
{
	'\0\s[7]痛いですわ！\w9\n令嬢の頭をなんだと思っていますの！\e'
	'\0\s[2]きゃっ！\w8\s[7]\n‥\w5‥\w5今のは、聞かなかったことにしなさい。\e'
}

MouseDoubleClick0Face
{
	'\0\s[7]つつかないでくださる？\e'
	"\0\s[4]‥\w5‥\w5%(username)、わたくしに何か恨みでも？\w8\1心当たりがおありなのでは。\w8\0\s[7]\n\nありませんわ！\e"
}

MouseDoubleClick0Bust
{
	'\0\s[7]‥\w5‥\w5扇ではたきますわよ。\e'
	'\0\s[7]無礼者！\w8\1お嬢様、落ち着いてくださいませ。\e'
}

MouseDoubleClick0Fan
{
	'\0\s[5]おーっほっほっほ！\w8\1お嬢様、扇はそのために開くものでは‥\w5‥\w5\w8\0\s[26]\n\nそのためのものですわ。\e'
}

MouseDoubleClick0
{
	//それ以外のつつきでメニュー展開
	OpenMenu
}

//kero側のつつかれ反応
MouseDoubleClick1Tray
{
	'\1\s[11]お、お待ちください。\w9\n紅茶がこぼれます。\e'
	'\1\s[10]クッキーをご所望でございますか。\w8\0\s[7]それはわたくしの分ですわ！\e'
}

MouseDoubleClick1
{
	//kero側のつつかれ処理
	'\1\s[10]何かご用でございますか。\e'
	'\1\s[11]‥\w5‥\w5突然つつかれますと、驚きます。\w8\0\s[25]今のお顔、珍しいですわね。\e'
	'\1\s[10]私をつついても、お嬢様の機嫌は直りませんよ。\w8\0\s[7]どういう意味ですの！\e'
}

//******************************************************************************
//マウス処理部コア
//AYATEMPLATE.MouseMoveWheelFuncの2番目の数字が「感度」です。
//1番目の数字（0か1）は、MoveかWheelかを判別するためのもので、
//変更の必要はありません。
//******************************************************************************

OnMouseMove
{
	AYATEMPLATE.MouseMoveWheelFunc(0,50,'MouseMove')
}

OnMouseWheel
{
	_result = ''
	if TOINT(reference[2]) > 0 {
		_result = AYATEMPLATE.MouseMoveWheelFunc(1,4,'MouseWheelUp')
	}
	else {
		_result = AYATEMPLATE.MouseMoveWheelFunc(1,4,'MouseWheelDown')
	}

	if _result == '' {
		_result = AYATEMPLATE.MouseMoveWheelFunc(1,4,'MouseWheel')
	}

	_result
}

OnMouseDoubleClick
{
	AYATEMPLATE.MouseEventExec('MouseDoubleClick')
}
