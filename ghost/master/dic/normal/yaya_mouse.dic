//******************************************************************************
// 悪役令嬢クローディア
// マウス入力関連辞書
//******************************************************************************


//******************************************************************************
//マウス処理部
//
//以下、実際のトークを記述します。関数名は以下の規則になっています。
//[種別] + [スコープ] + [部位]
//種別は、MouseMove, MouseDoubleClick, MouseWheelUp, MouseWheelDown のどれかです。
//スコープは、\0,\1,といったスコープ番号です。
//部位は、当たり判定のどの部位かを表します。当たり判定の無い場所でのイベントの場合
//部位はありません。
//
//クローディアの当たり判定: Head, Face, Bust, Hair, Fan, Skirt, Foot
//アンソニーの当たり判定: Head, Face, Body, Tray, Foot
//******************************************************************************


//******************************************************************************
//撫で反応
//******************************************************************************
MouseMove0Head
{
	'\0\s[1]ちょっと、ティアラがずれますわ。\w8\1直すのは私でございます。\e'
	'\0\s[1]‥\w5‥\w5子ども扱いしないでくださる？\w8\1お顔は嬉しそうでございますが。\w8\0\s[7]\n\n余計なことは言わなくてよろしい！\e'
	'\0\s[25]‥\w5‥\w5ふん。\w9\n今日だけは許して差し上げますわ。\e'
}

MouseMove0Hair
{
	'\0\s[7]この巻き髪を整えるのに、\w9\nどれだけかかると思っていますの？\w8\1毎朝一時間でございます。\e'
	'\0\s[1]‥\w5‥\w5髪に触れるのは、\w9\n信頼の証ですのよ。\w8\s[7]\nべ、別にあなたを信頼しているとは\w9\n言っていませんわ！\e'
}

MouseMove0Face
{
	'\0\s[7]ほ、頬に触れるなんて無礼ですわ！\e'
	'\0\s[1]‥\w5‥\w5何か、ついていまして？\w8\1クッキーのかけらが。\w8\0\s[2]\n\nなんですって！？\e'
}

MouseMove0Bust
{
	"\0\s[7]どこを触っていますの、%(username)。\w9\n品位を疑いますわ。\e"
	'\0\s[7]‥\w5‥\w5アンソニー、この方をつまみ出して。\w8\1かしこまりました。\w9\n‥\w5‥\w5と申し上げたいところですが、\w9\nこちら側からは手が届きません。\e'
}

MouseMove0Fan
{
	'\0\s[26]この扇が気になりまして？\w9\n異国の職人に作らせた特注品ですの。\e'
	'\0\s[0]扇で口元を隠すのは、\w9\n笑いをこらえるときですわ。\w8\1たいてい、どなたかの失敗をご覧になったときです。\e'
}

MouseMove0Skirt
{
	'\u\s[10]\0\s[7]‥\w5‥\w5裾をまさぐって、\w9\n何をなさるおつもり？\w8\1お嬢様、目が笑っておりません。\w8\0\s[26]\n\n当然ですわ。\w9\n不埒者に向ける笑顔などありませんもの。\e'
	"\u\s[10]\0\s[2]ちょっと、%(username)！\w9\nどこに手を伸ばしていますの！\w8\1落ちたクッキーを拾うにしては、\w9\n少々位置が高うございますね。\w8\0\s[7]\n\nアンソニー、この者を成敗なさい。\w8\1\n\nかしこまりました。\w9\n本日の紅茶は抜きでございます。\e"
	'\u\s[10]\0\s[1]裾の刺繍が気になりまして？\w9\n‥\w5‥\w5そういうことにしておきますわ。\w8\s[7]\n次はありませんわよ。\e'
}

MouseMove1Head
{
	'\1\s[10]‥\w5‥\w5頭のひれは、撫でるものではございません。\e'
}

MouseMove1Face
{
	'\1\s[10]私の顔に何か。\w8\0\s[0]いつも眠そうですわね。\w8\1\n\nこれが真顔でございます。\e'
}

//******************************************************************************
//つつかれ反応
//******************************************************************************

//本体側のつつかれ反応
MouseDoubleClick0Head
{
	'\0\s[7]痛いですわ！\w9\n令嬢の頭をなんだと思っていますの！\e'
	'\0\s[2]きゃっ！\w8\s[7]\n‥\w5‥\w5今のは、聞かなかったことにしなさい。\e'
}

MouseDoubleClick0Face
{
	'\0\s[7]つつかないでくださる？\e'
	"\0\s[4]‥\w5‥\w5%(username)、わたくしに何か恨みでも？\w8\1心当たりがおありなのでは。\w8\0\s[7]\n\nありませんわ！\e"
}

MouseDoubleClick0Bust
{
	'\0\s[7]‥\w5‥\w5扇ではたきますわよ。\e'
	'\0\s[7]無礼者！\w8\1お嬢様、落ち着いてくださいませ。\e'
}

MouseDoubleClick0Fan
{
	'\0\s[5]おーっほっほっほ！\w8\1お嬢様、扇はそのために開くものでは‥\w5‥\w5\w8\0\s[26]\n\nそのためのものですわ。\e'
}

MouseDoubleClick0Skirt
{
	"\u\s[10]\0\s[7]不埒者！\w9\nクロード公爵家の名において成敗いたしますわ！\w8\1お嬢様、%(username)様は一応お客様でございます。\w8\0\s[26]\n\nでしたら、お客様にふさわしい振る舞いを\w9\n教えて差し上げるまでですわ。\e"
	'\u\s[10]\0\s[7]裾を引っぱるなんて、\w9\n子どもでもしませんわよ。\w8\1お嬢様は十歳までなさっておいででした。\w8\0\s[1]\n\nい、今それを言う必要がありまして！？\e'
	'\u\s[10]\0\s[4]‥\w5‥\w5裾を踏みましたわね。\w9\nこのドレス、仕立てに三か月かかりましたのよ。\w8\1仮縫いだけで二週間でございました。\w8\0\s[7]\n\n弁償していただこうかしら。\e'
}

MouseDoubleClick0Foot
{
	"\u\s[10]\0\s[7]わたくしの足を踏むなんて、\w9\nいい度胸ですわね、%(username)。\w8\1舞踏会でしたら、\w9\nお相手を替えられるところでございます。\w8\0\s[26]\n\nその前に、踏み返して差し上げますわ。\e"
	'\u\s[10]\0\s[4]‥\w5‥\w5この靴、今朝アンソニーが\w9\n磨き上げたばかりですのよ。\w8\1\s[11]‥\w5‥\w5\w8\s[10]\nもう一度、磨き直してまいります。\e'
	'\u\s[10]\0\s[26]あら、わたくしの足元にひれ伏すなんて。\w9\nようやく身の程をわきまえましたのね。\w8\1ただ、つまずかれただけかと存じます。\w8\0\s[7]\n\n‥\w5‥\w5そういうことは黙っていなさい。\e'
}

MouseDoubleClick0
{
	//それ以外のつつきでメニュー展開
	OpenMenu
}

//kero側のつつかれ反応
MouseDoubleClick1Tray
{
	'\1\s[11]お、お待ちください。\w9\n紅茶がこぼれます。\e'
	'\1\s[10]クッキーをご所望でございますか。\w8\0\s[7]それはわたくしの分ですわ！\e'
}

MouseDoubleClick1Foot
{
	'\0\s[0]\1\s[11]‥\w5‥\w5\w8\s[10]\n失礼いたしました。\w9\n足の指が、少々驚いたようでございます。\w8\0\s[2]アンソニーにも、足の指がありましたの？\w8\1\n\nございます。\w9\n数えたことはございませんが。\e'
	'\0\s[0]\1\s[10]足を踏まれても、\w9\nトレイを揺らさないのが執事でございます。\w8\0\s[26]さすがですわね。\w9\nでは、もう一度。\w8\1\s[11]\n\nおやめくださいませ。\e'
	"\0\s[0]\1\s[10]%(username)様。\w9\n私の足元に、何か落ちておりましたか。\w8\0\s[7]わたくしの執事の足を\w9\n勝手に踏まないでくださる？\w8\1\n\n‥\w5‥\w5お嬢様以外は、ということでございますね。\e"
}

MouseDoubleClick1
{
	//kero側のつつかれ処理
	'\1\s[10]何かご用でございますか。\e'
	'\1\s[11]‥\w5‥\w5突然つつかれますと、驚きます。\w8\0\s[25]今のお顔、珍しいですわね。\e'
	'\1\s[10]私をつついても、お嬢様の機嫌は直りませんよ。\w8\0\s[7]どういう意味ですの！\e'
}

//******************************************************************************
//ドラッグ
//ドラッグ中は浮いたサーフェス（クローディア 29、アンソニー 19）にして黙り、
//離したところで元の表情に戻してひとこと言う。
//******************************************************************************
OnMouseDragStart
{
	if TOINT(reference[5]) != 0 {
		return
	}
	case reference[3] {
		when '0' { '\0\s[29]\e' }
		when '1' { '\1\s[19]\e' }
	}
}

OnMouseDragEnd
{
	if TOINT(reference[5]) != 0 {
		return
	}
	case reference[3] {
		when '0' { DragEnd0 }
		when '1' { DragEnd1 }
	}
}

DragEnd0 : nonoverlap
{
	'\u\s[10]\0\s[7]ちょっと、断りもなく\w9\n持ち上げないでくださる？\w8\1お嬢様は羽根のように軽うございますから。\w8\0\s[1]\n\n‥\w5‥\w5そ、そういうことではありませんわ。\e'
	'\u\s[10]\0\s[2]足が床に着いていませんでしたわ。\w9\n淑女を宙づりにするなんて。\w8\1見事な浮きっぷりでございました。\w8\0\s[7]\n\nそれ、褒めていませんわね。\e'
	'\u\s[10]\0\s[26]ふん、この場所がよろしいの？\w9\nまあ、眺めは悪くありませんわ。\e'
	'\u\s[10]\0\s[7]ドレスの裾が乱れましたわ。\w9\n動かすなら、ひとこと言いなさい。\w8\1のちほどお直しいたします。\e'
}

DragEnd1 : nonoverlap
{
	'\0\s[0]\1\s[10]‥\w5‥\w5紅茶は一滴もこぼしておりません。\w8\0\s[25]さすがですわね、アンソニー。\e'
	'\0\s[0]\1\s[11]‥\w5‥\w5執事を持ち運ぶのは、\w9\nご遠慮いただきたく存じます。\w8\s[10]\n\nトレイの上が大惨事になりますので。\e'
	'\0\s[26]\1\s[10]配置換えを承りました。\w8\0アンソニーの居場所を決めるのは、\w9\nわたくしでしてよ。\w8\1\n\n‥\w5‥\w5では、お二方で話し合ってくださいませ。\e'
}

//******************************************************************************
//マウス処理部コア
//AYATEMPLATE.MouseMoveWheelFuncの2番目の数字が「感度」です。
//1番目の数字（0か1）は、MoveかWheelかを判別するためのもので、
//変更の必要はありません。
//******************************************************************************

OnMouseDown
{
	//右クリックメニューの見た目を切り替えるため、最後に押されたキャラを覚えておく
	//（yaya_string.dic の On_menu.*）。何も話さない。
	menuscope = TOINT(reference[3])
}

OnMouseMove
{
	AYATEMPLATE.MouseMoveWheelFunc(0,50,'MouseMove')
}

OnMouseWheel
{
	_result = ''
	if TOINT(reference[2]) > 0 {
		_result = AYATEMPLATE.MouseMoveWheelFunc(1,4,'MouseWheelUp')
	}
	else {
		_result = AYATEMPLATE.MouseMoveWheelFunc(1,4,'MouseWheelDown')
	}

	if _result == '' {
		_result = AYATEMPLATE.MouseMoveWheelFunc(1,4,'MouseWheel')
	}

	_result
}

OnMouseDoubleClick
{
	AYATEMPLATE.MouseEventExec('MouseDoubleClick')
}
