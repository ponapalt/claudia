# Files excluded when creating the .nar (gitignore syntax).
# Used by SSP and tools/build-nar.ps1. .updateignore includes this file.
# https://ssp.shillest.net/ukadoc/manual/descript_install.html

# development kit (tools/devkit.narignore is replaced when the kit is updated)
include:tools/devkit.narignore

# the whole development kit is kept out of the nar and network updates;
# it lives only in the repository (list from DEVKIT-GUIDE.md)
/AGENTS.md
/CLAUDE.md
/DEVKIT-GUIDE.md
/GHOST.md
/docs/agents/
/.mcp.json
/.claude/
/.github/
/tools/

# editor and git settings; only in the repository
/.editorconfig
/.gitattributes
/.gitignore

# notes for developing the kit itself; only in the repository
/DEVKIT-MAINTAINING.md
/docs/devkit-maintaining/

# git metadata (ghost/master/dic/system is a plain folder in the nar, not a submodule)
.git
.gitmodules
/LICENSE

# needed only by network updates (.updateignore includes it again)
/delete.txt

# network update files
updates2.dau
updates.txt

# runtime data
profile/
yaya_variable.cfg

# source images of the shell (not needed at runtime)
/work/

# design notes for developing the ghost; only in the repository
/docs/design-system.md
