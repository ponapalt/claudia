root = true

[*]
charset = utf-8
end_of_line = lf

[*.{dic,txt}]
indent_style = tab

[*.{ps1,cs}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,lua,md}]
indent_style = space
indent_size = 2

# These readme files are Shift_JIS; keep their encoding.
[{readme-aya.txt,readme-yaya.txt}]
charset = unset

# Windows PowerShell 5.1 reads a BOM-less script as ANSI, which garbles Japanese
# text in it. Scripts that contain Japanese need the BOM.
[work/balloon/preview.ps1]
charset = utf-8-bom
